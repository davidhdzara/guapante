<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================================================================
         Comprobante de pago del recibo (colilla), PDF.

         Es un comprobante INTERNO de pago: no es una representación del documento de la DIAN, así que no lleva QR,
         CUNE, estado DIAN ni referencias a la Resolución 13 (la representación oficial es una pieza aparte).

         Genérico y multicliente: el logo, los colores y la fuente salen del diseño de documentos de la compañía del
         recibo (``web.external_layout``); sin estilos en línea, solo clases nativas de Bootstrap; sin textos ni datos
         de un cliente; el nombre de cada concepto es el de la regla salarial; los importes usan la moneda de la
         compañía. Los dos bloques ``ne_comprobante_encabezado`` y ``ne_comprobante_conceptos`` los reutiliza el
         comprobante único por empleado y fecha de pago.
         =================================================================== -->
    <record id="action_report_payslip_ne" model="ir.actions.report">
        <field name="name">Comprobante de pago</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_co_nomina_electronica.report_payslip_ne</field>
        <field name="report_file">l10n_co_nomina_electronica.report_payslip_ne</field>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Encabezado: título, referencia del recibo y datos del empleado y del periodo. Parámetro: ``o`` (recibo). -->
    <template id="ne_comprobante_encabezado">
        <div class="row mb-3">
            <div class="col-8">
                <h3>Comprobante de pago</h3>
            </div>
            <div class="col-4 text-end">
                <p class="mb-0">
                    <strong>No.:</strong>
                    <span t-out="o.number or o.name"/>
                </p>
                <p class="mb-0" t-if="o.paid_date">
                    <strong>Fecha de pago:</strong>
                    <span t-field="o.paid_date"/>
                </p>
            </div>
        </div>
        <div class="row border rounded p-2 mb-3">
            <div class="col-6">
                <p class="mb-1">
                    <strong>Empleado:</strong>
                    <span t-field="o.employee_id.name"/>
                </p>
                <p class="mb-1">
                    <strong>Documento:</strong>
                    <span t-field="o.employee_id.identification_id"/>
                </p>
                <p class="mb-1">
                    <strong>Cargo:</strong>
                    <span t-field="o.employee_id.job_title"/>
                </p>
                <p class="mb-1">
                    <strong>Departamento:</strong>
                    <span t-field="o.employee_id.department_id.name"/>
                </p>
            </div>
            <div class="col-6">
                <p class="mb-1">
                    <strong>Periodo:</strong>
                    <span t-field="o.date_from"/> - <span t-field="o.date_to"/>
                </p>
                <p class="mb-1">
                    <strong>Salario:</strong>
                    <span t-field="o.contract_id.wage"
                          t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                </p>
                <!-- H-QA-034: los días con que se PAGÓ el recibo (cantidad guardada de su línea de sueldo; los entrega
                     report.l10n_co_nomina_electronica.report_payslip_ne). Sin esa línea (prima, bonificación) el campo no sale. -->
                <t t-set="linea_dias" t-value="dias_pagados and dias_pagados.get(o.id)"/>
                <p class="mb-1" t-if="linea_dias">
                    <strong>Días trabajados:</strong>
                    <span t-field="linea_dias.quantity"/>
                </p>
                <p class="mb-1">
                    <strong>Tipo de contrato:</strong>
                    <span t-field="o.contract_id.l10n_co_ne_contract_type"/>
                </p>
            </div>
        </div>
    </template>

    <!-- Tabla de conceptos con totales y neto. Parámetros: ``lineas`` (líneas del recibo a imprimir), ``neto`` (valor) y
         ``moneda`` (moneda de la compañía). Devengado = líneas positivas, deducción = negativas (en positivo). -->
    <template id="ne_comprobante_conceptos">
        <table class="table table-sm table-bordered">
            <thead>
                <tr class="table-light">
                    <th>Código</th>
                    <th class="w-50">Concepto</th>
                    <th class="text-end">Devengado</th>
                    <th class="text-end">Deducción</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="lineas" t-as="line">
                    <tr>
                        <td>
                            <span t-field="line.code"/>
                        </td>
                        <td>
                            <span t-field="line.name"/>
                        </td>
                        <td class="text-end">
                            <t t-if="line.total &gt;= 0">
                                <span t-out="line.total" t-options='{"widget": "monetary", "display_currency": moneda}'/>
                            </t>
                        </td>
                        <td class="text-end">
                            <t t-if="line.total &lt; 0">
                                <span t-out="abs(line.total)" t-options='{"widget": "monetary", "display_currency": moneda}'/>
                            </t>
                        </td>
                    </tr>
                </t>
            </tbody>
            <tfoot>
                <tr class="fw-bold">
                    <td colspan="2">Totales</td>
                    <td class="text-end">
                        <span t-out="sum(l.total for l in lineas if l.total &gt;= 0)"
                              t-options='{"widget": "monetary", "display_currency": moneda}'/>
                    </td>
                    <td class="text-end">
                        <span t-out="abs(sum(l.total for l in lineas if l.total &lt; 0))"
                              t-options='{"widget": "monetary", "display_currency": moneda}'/>
                    </td>
                </tr>
                <tr class="table-light fw-bold">
                    <td colspan="3">Neto a pagar</td>
                    <td class="text-end">
                        <span t-out="neto" t-options='{"widget": "monetary", "display_currency": moneda}'/>
                    </td>
                </tr>
            </tfoot>
        </table>
    </template>

    <template id="report_payslip_ne">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-call="l10n_co_nomina_electronica.ne_comprobante_encabezado"/>
                        <t t-call="l10n_co_nomina_electronica.ne_comprobante_conceptos">
                            <t t-set="lineas" t-value="o._ne_pdf_lineas()"/>
                            <t t-set="neto" t-value="o._ne_pdf_neto()"/>
                            <t t-set="moneda" t-value="o.company_id.currency_id"/>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
