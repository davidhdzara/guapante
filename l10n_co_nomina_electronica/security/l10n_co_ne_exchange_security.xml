<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- H-F2-03 (G2, decisión del TL del 22-nov): las dos reglas eran SOLO de grupo (administrador de nómina): una regla de grupo no protege a quien reciba acceso por otro grupo (``ir_rule.py``
         ``_compute_domain``: las de grupo solo aplican a sus miembros). Ahora son GLOBALES, como las demás reglas de compañía del módulo. El ``(5, 0, 0)`` vacía los grupos que la base ya tiene
         (un registro de datos que omite ``groups`` no los quita al actualizar). Sin cambio de conducta: solo el administrador de nómina tiene permiso de acceso a estos modelos. -->
    <record id="rule_l10n_co_ne_exchange_company" model="ir.rule">
        <field name="name">Intercambios DIAN por compañía autorizada</field>
        <field name="model_id" ref="model_l10n_co_ne_exchange"/>
        <field name="groups" eval="[(5, 0, 0)]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_l10n_co_ne_exchange_document_company" model="ir.rule">
        <field name="name">Manifiestos DIAN por compañía autorizada</field>
        <field name="model_id" ref="model_l10n_co_ne_exchange_document"/>
        <field name="groups" eval="[(5, 0, 0)]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
