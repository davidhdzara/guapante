<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- H-F1-07 (doc 92): el día de descanso pactado cuelga del empleado, así que el aislamiento multiempresa va por la compañía del empleado (mismo criterio del pacto de desalarización). -->
    <record id="rule_l10n_co_employee_descanso_company" model="ir.rule">
        <field name="name">Día de descanso pactado: compañías autorizadas</field>
        <field name="model_id" ref="model_l10n_co_employee_descanso"/>
        <field name="domain_force">[('employee_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
