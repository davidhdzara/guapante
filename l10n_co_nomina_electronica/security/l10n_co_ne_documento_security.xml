<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Aislamiento multiempresa del documento mensual DIAN y de sus intentos (doc 51, doc 53 §3.1):
         reglas globales company_id in company_ids, igual que recibo/lote en hr_payroll. -->
    <record id="rule_l10n_co_ne_documento_company" model="ir.rule">
        <field name="name">Documento mensual DIAN: compañías autorizadas</field>
        <field name="model_id" ref="model_l10n_co_ne_documento"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_l10n_co_ne_documento_intento_company" model="ir.rule">
        <field name="name">Intentos de envío DIAN: compañías autorizadas</field>
        <field name="model_id" ref="model_l10n_co_ne_documento_intento"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <!-- PRINCIPIO (TL/consultor v19, 2026-11-14): la visibilidad de estos modelos es la del recibo nativo de CADA version
         de Odoo, no una copia fija. En v18 el recibo del oficial se limita por usuario/departamento/gerente; en v19
         `hr_payroll_rule_officer` es [(1,'=',1)]. Al portar a v19, las reglas del Oficial de este archivo se reescriben
         a su dominio. -->
    <!-- Frente 6, P6-3 (doc 59 4.4): la visibilidad de estos modelos no puede exceder la del recibo. Mismo dominio que la
         regla nativa hr_payroll_rule_officer del recibo para el oficial; el administrador ve todo, como en el recibo.
         Las reglas de grupo se combinan con O entre si y con Y con la regla global por compania. -->
    <record id="rule_l10n_co_ne_documento_oficial" model="ir.rule">
        <field name="name">Documento mensual DIAN: el oficial de nómina solo ve lo de los empleados que ve en el recibo</field>
        <field name="model_id" ref="model_l10n_co_ne_documento"/>
        <field name="domain_force">['|', '|', ('employee_id.user_id', '=', user.id), ('employee_id.department_id', '=', False), ('employee_id.department_id.manager_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('hr_payroll.group_hr_payroll_user'))]"/>
    </record>
    <record id="rule_l10n_co_ne_documento_administrador" model="ir.rule">
        <field name="name">Documento mensual DIAN: el administrador de nómina ve todo</field>
        <field name="model_id" ref="model_l10n_co_ne_documento"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_payroll.group_hr_payroll_manager'))]"/>
    </record>
    <record id="rule_l10n_co_ne_documento_intento_oficial" model="ir.rule">
        <field name="name">Intentos de envío DIAN: el oficial de nómina solo ve lo de los empleados que ve en el recibo</field>
        <field name="model_id" ref="model_l10n_co_ne_documento_intento"/>
        <field name="domain_force">['|', '|', ('documento_id.employee_id.user_id', '=', user.id), ('documento_id.employee_id.department_id', '=', False), ('documento_id.employee_id.department_id.manager_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('hr_payroll.group_hr_payroll_user'))]"/>
    </record>
    <record id="rule_l10n_co_ne_documento_intento_administrador" model="ir.rule">
        <field name="name">Intentos de envío DIAN: el administrador de nómina ve todo</field>
        <field name="model_id" ref="model_l10n_co_ne_documento_intento"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_payroll.group_hr_payroll_manager'))]"/>
    </record>
</odoo>
