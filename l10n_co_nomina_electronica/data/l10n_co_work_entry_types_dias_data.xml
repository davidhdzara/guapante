<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- .284 (E2a, doc 68 §12): tipos de entrada de trabajo PROPIOS del módulo para el desglose por fecha de la pestaña «Días
             trabajados». Solo se usan como tipo de las líneas que arma HrPayslip._ne_ajustar_dias_por_asistencia (no son entradas que el
             usuario digite) y son PAGADOS: ``hr.payslip.worked_days.is_paid`` es «el tipo no está en struct.unpaid_work_entry_type_ids»
             (enterprise hr_payslip_worked_days.py:28-34), así que sus horas entran al denominador y al importe de las líneas igual que las
             de «Asistencia». noupdate="1": el nombre es dato del usuario (se puede cambiar sin tocar el código). Los códigos NO entran a
             ``_NOVEDAD_AUSENCIA_WORKED_DAYS_CODES`` ni a los tipos sin sueldo: ``_ne_dias_pagables`` no los descuenta. -->
        <record id="hr_work_entry_type_co_festivo_trabajado" model="hr.work.entry.type">
            <field name="name">Festivos trabajados</field>
            <field name="code">CO_FEST_TRAB</field>
            <field name="color">2</field>
        </record>
        <record id="hr_work_entry_type_co_descanso_remunerado" model="hr.work.entry.type">
            <field name="name">Descansos remunerados</field>
            <field name="code">CO_DESCANSO_REM</field>
            <field name="color">2</field>
        </record>
        <record id="hr_work_entry_type_co_ajuste_mes_comercial" model="hr.work.entry.type">
            <field name="name">Ajuste mes comercial</field>
            <field name="code">CO_AJUSTE_MES</field>
            <field name="color">2</field>
        </record>
    </data>
</odoo>
