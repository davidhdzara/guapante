<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 22-nov (decisión del TL, igual que v19): una instalación NUEVA nace con este cron INACTIVO (``active`` False): no envía ni consulta nada a la DIAN hasta que un administrador lo
             active a propósito (Ajustes > Técnico > Acciones planificadas). El archivo es ``noupdate="1"``: una actualización (``-u``) NO cambia el estado de una base que ya lo tiene
             (producción, con los envíos pausados a mano, queda igual; staging, con el cron activo, también). Con el cron inactivo, ``ir.cron._trigger`` descarta los disparos
             inmediatos: encolar un envío no lo ejecuta hasta activarlo. -->
        <!-- Ronda 1 DIAN (2026-10-05): un envío 'sent' queda así indefinidamente si nadie
             presiona "Consultar Estado" a mano, aunque la DIAN resuelva en segundos; Odoo no
             se entera solo. Este cron reutiliza action_check_dian_status() tal cual (ver
             hr_payslip._cron_recheck_sent_status()), nunca duplica la lógica SOAP.
             El intervalo es un dato editable en Ajustes > Técnico > Acciones Planificadas, no
             una constante de código (mismo criterio que ir_cron_ne_habilitacion). -->
        <record id="ir_cron_ne_dian_status_recheck" model="ir.cron">
            <field name="name">Nómina Electrónica: reconsulta de estado DIAN pendiente</field>
            <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
            <field name="state">code</field>
            <field name="code">model._cron_recheck_sent_status()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
