<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- .304 (doc 77, D; decisión del TL del 22-nov): lista de SOLO LECTURA «Consecutivos de nómina»: cada número que viajó a la DIAN con su destino (aceptado; rechazado, reemplazado por
         el número N; pendiente), por ambiente. Justifica cada hueco ante la DIAN y la UGPP. Vista SQL sin datos propios; patrón nativo (lista y búsqueda), sin estilos propios. -->
    <record id="view_l10n_co_ne_consecutivo_list" model="ir.ui.view">
        <field name="name">l10n.co.ne.consecutivo.list</field>
        <field name="model">l10n.co.ne.consecutivo</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="ambiente, prefijo, valor desc">
                <field name="company_id" optional="hide"/>
                <field name="ambiente"/>
                <field name="numero"/>
                <field name="origen"/>
                <field name="employee_id"/>
                <field name="estado"/>
                <field name="reemplazado_por"/>
                <field name="payslip_id" optional="hide"/>
                <field name="documento_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_co_ne_consecutivo_search" model="ir.ui.view">
        <field name="name">l10n.co.ne.consecutivo.search</field>
        <field name="model">l10n.co.ne.consecutivo</field>
        <field name="arch" type="xml">
            <search>
                <field name="numero"/>
                <field name="employee_id"/>
                <filter name="rechazados" string="Rechazados" domain="[('estado', '=', 'rechazado')]"/>
                <filter name="aceptados" string="Aceptados" domain="[('estado', '=', 'aceptado')]"/>
                <filter name="produccion" string="Producción" domain="[('ambiente', '=', 'produccion')]"/>
                <filter name="habilitacion" string="Habilitación" domain="[('ambiente', '=', 'habilitacion')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="agrupar_ambiente" string="Ambiente" context="{'group_by': 'ambiente'}"/>
                    <filter name="agrupar_prefijo" string="Prefijo" context="{'group_by': 'prefijo'}"/>
                    <filter name="agrupar_estado" string="Estado DIAN" context="{'group_by': 'estado'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_co_ne_consecutivo" model="ir.actions.act_window">
        <field name="name">Consecutivos de nómina</field>
        <field name="res_model">l10n.co.ne.consecutivo</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_agrupar_ambiente': 1}</field>
    </record>

    <menuitem id="menu_l10n_co_ne_consecutivo"
              name="Consecutivos de nómina"
              parent="hr_payroll.menu_hr_payroll_payslips"
              action="action_l10n_co_ne_consecutivo"
              sequence="66"
              groups="hr_payroll.group_hr_payroll_manager"/>
</odoo>
