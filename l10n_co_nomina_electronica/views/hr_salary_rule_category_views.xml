<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- E11 pieza 2a (.287, doc 71c §4): sección de «Conceptos de pago» de la categoría. -->
    <record id="view_salary_rule_category_form_ne" model="ir.ui.view">
        <field name="name">hr.salary.rule.category.form.ne</field>
        <field name="model">hr.salary.rule.category</field>
        <field name="inherit_id" ref="hr_payroll.hr_salary_rule_category_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='category_details']" position="inside">
                <field name="l10n_co_ne_seccion_concepto"/>
            </xpath>
        </field>
    </record>
</odoo>
