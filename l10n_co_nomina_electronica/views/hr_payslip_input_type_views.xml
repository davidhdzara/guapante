<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- E11 pieza 2a (.287, doc 71c §7): unidad de la cantidad del tipo de novedad. El nativo muestra «Es cantidad?» solo si el tipo está
         disponible en asignaciones (hr_payroll/views/hr_payslip_input_type_views.xml:32); aquí se muestra siempre porque la unidad aplica a
         todas las novedades. Los selectores van por @name (no por atributos traducibles). -->
    <record id="view_payslip_input_type_form_ne" model="ir.ui.view">
        <field name="name">hr.payslip.input.type.form.ne</field>
        <field name="model">hr.payslip.input.type</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_input_type_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_quantity']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
            <xpath expr="//field[@name='is_quantity']" position="after">
                <field name="l10n_co_ne_unidad" invisible="not is_quantity"/>
            </xpath>
        </field>
    </record>
</odoo>
