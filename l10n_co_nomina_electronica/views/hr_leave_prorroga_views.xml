<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vinculo "Prórroga de" en la ausencia, solo para Incapacidad Común de compañías colombianas. Desde H-F1-01 (doc 84) ES la marca de «misma enfermedad»: el pago por
         tramos (2 días del empleador, 3 a 90, 91 en adelante) cuenta desde la inicial de la cadena vinculada. El aviso «¿Es prórroga de…?» no bloquea. -->
    <record id="hr_leave_view_form_prorroga_ne" model="ir.ui.view">
        <field name="name">hr.leave.form.prorroga.ne</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='holiday_status_id']" position="after">
                <field name="l10n_co_ne_es_incapacidad_comun" invisible="1"/>
                <field name="l10n_co_ne_prorroga_de_id"
                       invisible="not l10n_co_ne_es_incapacidad_comun"
                       options="{'no_create': True}"/>
                <div class="alert alert-warning" role="alert"
                     invisible="not l10n_co_ne_prorroga_aviso or not l10n_co_ne_es_incapacidad_comun">
                    <field name="l10n_co_ne_prorroga_aviso" readonly="1" nolabel="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
