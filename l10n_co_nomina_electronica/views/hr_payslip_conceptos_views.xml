<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- E11 pieza 3 (.289, doc 71c §5): pestaña «Conceptos de pago» del recibo. Solo para las estructuras con el interruptor
         l10n_co_ne_conceptos_de_pago; en las demás la pestaña nativa «Worked Days & Inputs» queda igual. Selectores por @name (nunca por @string),
         sin colores ni íconos propios. Lista con el widget nativo section_and_note_one2many del módulo account (secciones y notas como una orden de
         venta) y SOLO «Agregar concepto» (patrón de sale/views/sale_order_views.xml:511-516 sin las opciones de sección y nota). -->
    <record id="view_payslip_form_ne_conceptos" model="ir.ui.view">
        <field name="name">hr.payslip.form.ne.conceptos</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='worked_days_input']" position="attributes">
                <attribute name="invisible">l10n_co_ne_usa_conceptos</attribute>
            </xpath>
            <xpath expr="//page[@name='worked_days_input']" position="after">
                <page string="Conceptos de pago" name="conceptos_de_pago" invisible="not l10n_co_ne_usa_conceptos">
                    <field name="l10n_co_ne_usa_conceptos" invisible="1"/>
                    <div class="alert alert-warning mb-2" role="alert" invisible="not l10n_co_ne_aviso_dias">
                        <strong>Revise las entradas de trabajo</strong><br/>
                        <field name="l10n_co_ne_aviso_dias" readonly="1" nolabel="1"/>
                    </div>
                    <!-- .301 (doc 76 §2.2): mismo patrón nativo que el aviso de las entradas de trabajo; solo avisa, no bloquea ni cambia el cálculo. -->
                    <div class="alert alert-warning mb-2" role="alert" invisible="not l10n_co_ne_aviso_no_salarial">
                        <strong>Revise los pagos no salariales</strong><br/>
                        <field name="l10n_co_ne_aviso_no_salarial" readonly="1" nolabel="1"/>
                    </div>
                    <!-- .302 (doc 76 §2.3): siempre avisa el pacto que falta (aunque el interruptor de exigirlo al confirmar esté en 0). -->
                    <div class="alert alert-warning mb-2" role="alert" invisible="not l10n_co_ne_aviso_pacto">
                        <strong>Falta el pacto de desalarización o su soporte</strong><br/>
                        <field name="l10n_co_ne_aviso_pacto" readonly="1" nolabel="1"/>
                    </div>
                    <field name="l10n_co_concepto_ids" nolabel="1" mode="list" widget="section_and_note_one2many"
                           readonly="state not in ['draft', 'verify']">
                        <list editable="bottom">
                            <control>
                                <create name="add_concepto_control" string="Agregar concepto"/>
                            </control>
                            <!-- Como en la lista nativa de novedades (hr_payroll/views/hr_payslip_views.xml:172): el cliente debe enviar el recibo en el
                                 onchange de una fila nueva para calcular qué se puede editar. -->
                            <field name="slip_id" column_invisible="True" required="0"/>
                            <!-- .300b: sin el widget ``handle``: el orden lo fija el sistema (se regenera en cada cálculo) y arrastrar una fila, o un título de sección, dejaba la
                                 tabla desordenada. El widget nativo de secciones no trae menú de filas en Odoo 18 (``account/static/src/components/section_and_note_fields_backend``). -->
                            <field name="sequence" column_invisible="True"/>
                            <field name="display_type" column_invisible="True"/>
                            <field name="origen" column_invisible="True"/>
                            <field name="ajustado" column_invisible="True"/>
                            <field name="edita_cantidad" column_invisible="True"/>
                            <field name="edita_porcentaje" column_invisible="True"/>
                            <field name="edita_importe" column_invisible="True"/>
                            <!-- Selector del concepto (22-nov, diseño aprobado por el TL; doc 74 §19): la columna principal «Concepto» es la REGLA (Many2one), editable solo en la fila nueva
                                 (``readonly="id"``), con las reglas de la estructura del recibo que se alimentan de una novedad (mismo código que un tipo) y que van en devengados o
                                 deducciones; elegirla deduce el tipo de novedad y el nombre (``onchange``). La columna «Tipo de novedad» desaparece: el tipo queda como columna
                                 invisible porque la edición y los cálculos de «qué se puede editar» lo leen. Patrón nativo, sin JS propio (como el producto en una línea de venta). -->
                            <field name="salary_rule_id" string="Concepto" readonly="id" required="not id and origen == 'novedad'" options="{'no_create': True, 'no_open': True}"
                                   domain="[('struct_id', '=', parent.struct_id), ('l10n_co_ne_alimentada_por_novedad', '=', True), ('category_id.l10n_co_ne_seccion_concepto', 'in', ['devengados', 'deducciones'])]"/>
                            <field name="input_type_id" column_invisible="True"/>
                            <!-- Ajuste de David (22-nov): la cuenta contable de la regla, oculta por defecto aquí (visible en «Cálculo del salario»); solo informativa. -->
                            <field name="cuenta" optional="hide" readonly="1"/>
                            <!-- La descripción: en una fila calculada es el nombre de la regla (ya está en «Concepto»), por eso no se repite; sale en las novedades (editable), los días, las
                                 notas y los títulos de sección (el widget de secciones la necesita visible: columna opcional visible por defecto, patrón de Ventas). -->
                            <field name="name" string="Descripción" widget="section_and_note_text" optional="show" readonly="origen in ('calculado', 'dias')"
                                   invisible="origen == 'calculado' and salary_rule_id"/>
                            <!-- Ajuste de David (22-nov): sin ruido: en las filas de cantidad 1 y 100 % no se muestra Cantidad ni Unidad (ni %); una fila que se puede editar sí
                                 muestra la cantidad. «Concepto | Cuenta | Importe | Total», como los apuntes contables. -->
                            <field name="quantity" readonly="not edita_cantidad" invisible="quantity == 1 and rate == 100 and not edita_cantidad"/>
                            <field name="unidad" readonly="1" invisible="quantity == 1 and rate == 100 and not edita_cantidad"/>
                            <!-- .297: el % se muestra SOLO si es distinto de 100 y con 2 decimales (la misma regla de la colilla). Atributo nativo ``digits`` del campo
                                 (``web/static/src/views/fields/float/float_field.js:133-139``); ``invisible`` por fila, como ``amount`` y ``total``. -->
                            <field name="rate" digits="[16, 2]" readonly="not edita_porcentaje" invisible="origen == 'dias' or rate == 100"/>
                            <field name="amount" readonly="not edita_importe" invisible="origen == 'dias'"/>
                            <field name="total" readonly="1" invisible="origen == 'dias'"/>
                        </list>
                    </field>
                    <group col="12">
                        <group colspan="7" name="conceptos_observaciones">
                            <field name="note" nolabel="1" placeholder="Observaciones..." readonly="state not in ['draft', 'verify']"/>
                        </group>
                        <group class="oe_subtotal_footer" colspan="5" name="conceptos_totales">
                            <field name="l10n_co_total_devengado"/>
                            <field name="l10n_co_total_deducciones"/>
                            <field name="net_wage" string="Neto a pagar" class="oe_subtotal_footer_separator"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
