<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Payslip Form View                                             -->
    <!-- ============================================================ -->
    <record id="view_payslip_form_ne" model="ir.ui.view">
        <field name="name">hr.payslip.form.ne</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">

            <!-- Header buttons -->
            <xpath expr="//header" position="inside">
                <button name="%(action_hr_payslip_send)d"
                        string="Enviar y Procesar"
                        type="action"
                        class="oe_highlight"
                        invisible="country_code != 'CO' or state not in ('done', 'paid') or (not l10n_co_ne_documento_id and (state != 'done' or l10n_co_ne_state not in ('draft', 'generated', 'uncertain', 'rejected')))"
                        groups="hr_payroll.group_hr_payroll_manager"/>
                <button name="action_generate_ne_xml"
                        string="Generar XML"
                        type="object"
                        class="btn-primary"
                        invisible="l10n_co_ne_en_produccion or country_code != 'CO' or (l10n_co_ne_documento_id and l10n_co_ne_state == 'draft') or l10n_co_ne_state != 'draft' or state != 'done'"
                        groups="hr_payroll.group_hr_payroll_manager"/>
                <button name="action_regenerate_ne_xml"
                        string="Regenerar XML"
                        type="object"
                        invisible="l10n_co_ne_en_produccion or country_code != 'CO' or (l10n_co_ne_documento_id and l10n_co_ne_state == 'draft') or l10n_co_ne_state not in ('generated', 'rejected') or state != 'done'"
                        groups="hr_payroll.group_hr_payroll_manager"/>
                <button name="action_send_ne_dian"
                        string="Enviar a DIAN"
                        type="object"
                        class="btn-primary"
                        invisible="l10n_co_ne_en_produccion or country_code != 'CO' or (l10n_co_ne_documento_id and l10n_co_ne_state == 'draft') or l10n_co_ne_state != 'generated' or state != 'done'"
                        groups="hr_payroll.group_hr_payroll_manager"/>
                <button name="action_check_dian_status"
                        string="Consultar Estado"
                        type="object"
                        class="btn-secondary"
                        invisible="l10n_co_ne_en_produccion and not (l10n_co_ne_documento_id and l10n_co_ne_state != 'draft') or country_code != 'CO' or (l10n_co_ne_documento_id and l10n_co_ne_state == 'draft') or l10n_co_ne_state not in ('sent', 'generated', 'rejected', 'uncertain') or state != 'done'"
                        groups="hr_payroll.group_hr_payroll_manager"/>
                <button name="action_create_adjustment"
                        string="Nota de Ajuste"
                        type="object"
                        class="btn-secondary"
                        invisible="l10n_co_ne_en_produccion or country_code != 'CO' or (l10n_co_ne_documento_id and l10n_co_ne_state == 'draft') or l10n_co_ne_state != 'accepted' or state != 'done'"
                        groups="hr_payroll.group_hr_payroll_manager"/>
                <button name="action_create_elimination"
                        string="Eliminar Documento"
                        type="object"
                        class="btn-secondary"
                        invisible="l10n_co_ne_en_produccion or country_code != 'CO' or (l10n_co_ne_documento_id and l10n_co_ne_state == 'draft') or l10n_co_ne_state != 'accepted' or state != 'done' or l10n_co_ne_is_adjustment"
                        groups="hr_payroll.group_hr_payroll_manager"/>

            </xpath>

            <!-- NE Status bar -->
            <xpath expr="//header" position="after">
                <div class="oe_title" name="ne_statusbar" invisible="country_code != 'CO' or (l10n_co_ne_documento_id and l10n_co_ne_state == 'draft')">
                    <field name="l10n_co_ne_state"
                           widget="statusbar"
                           statusbar_visible="draft,generated,sent,uncertain,accepted"
                           readonly="1"/>
                </div>

                <!-- E-2 (doc 59 19.1): aviso de periodicidad (no bloquea): 7 dias con un contrato que no es semanal -->
                <div class="alert alert-warning text-center mb-0"
                     role="alert"
                     invisible="not l10n_co_ne_aviso_periodicidad">
                    <strong>Revise la periodicidad del contrato</strong>
                    <br/>
                    <field name="l10n_co_ne_aviso_periodicidad" readonly="1" nolabel="1"/>
                </div>

                <!-- H-F1-06 (doc 87): aviso de afiliación incompleta (EPS, AFP, Caja, ARL): no bloquea al calcular; al confirmar es un error. -->
                <div class="alert alert-warning mb-0"
                     role="alert"
                     invisible="not l10n_co_ne_aviso_afiliacion">
                    <field name="l10n_co_ne_aviso_afiliacion" readonly="1" nolabel="1"/>
                </div>

                <!-- H-F1-07 (doc 92): el día de descanso del empleado no cuadra con su calendario o con las horas de recargo dominical/festivo, o el pacto no tiene el documento; no bloquea. -->
                <div class="alert alert-warning mb-0"
                     role="alert"
                     invisible="not l10n_co_ne_aviso_descanso">
                    <field name="l10n_co_ne_aviso_descanso" readonly="1" nolabel="1"/>
                </div>

                <!-- H-F1-09 (doc 88): el tipo de trabajador de la ficha de un aprendiz no coincide con el del contrato (el XML usa el del contrato); no bloquea. -->
                <div class="alert alert-warning mb-0"
                     role="alert"
                     invisible="not l10n_co_ne_aviso_tipo_trabajador">
                    <field name="l10n_co_ne_aviso_tipo_trabajador" readonly="1" nolabel="1"/>
                </div>

                <!-- H-F3-04 (doc 98): con el mes separado por tipo de trabajador, este recibo no cabe en el documento de su segmento; no bloquea. -->
                <div class="alert alert-warning mb-0"
                     role="alert"
                     invisible="not l10n_co_ne_aviso_segmento">
                    <field name="l10n_co_ne_aviso_segmento" readonly="1" nolabel="1"/>
                </div>

                <!-- H-F1-11 (doc 89): sin IBC consolidado del mes anterior, la base de vacaciones, licencia remunerada y SLN es el sueldo de la ficha del empleado; no bloquea. -->
                <div class="alert alert-warning mb-0"
                     role="alert"
                     invisible="not l10n_co_ne_aviso_ibc_anterior">
                    <field name="l10n_co_ne_aviso_ibc_anterior" readonly="1" nolabel="1"/>
                </div>

                <!-- Banner de Pendiente de Procesamiento -->
                <div class="alert alert-warning text-center mb-0"
                     role="alert"
                     invisible="l10n_co_ne_state != 'sent'">
                    <strong>Pendiente de validación DIAN</strong>
                    <br/>
                    La nómina electrónica ha sido transmitida y está en espera de la validación del webservice.
                </div>

                <!-- Banner de Envío Incierto -->
                <div class="alert alert-warning text-center mb-0"
                     role="alert"
                     invisible="l10n_co_ne_state != 'uncertain'">
                    <strong>Envío Incierto -- requiere conciliación</strong>
                    <br/>
                    <!-- H-012 (2026-10-06): 'uncertain' cubre 2 causas distintas (sin
                    ZipKey confirmado, o con ZipKey pero sin veredicto de la DIAN dentro
                    del plazo de reconsulta automática); el texto ya no asume cuál, el
                    motivo exacto queda en el registro de actividad (chatter) debajo. -->
                    Revise el motivo exacto en el registro de actividad (chatter) y el historial de intercambios en la pestaña "Nómina Electrónica". Si no hay ZipKey confirmado, use <b>"Enviar y Procesar"</b> para reintentar; si ya hay ZipKey pero sin veredicto, use <b>"Consultar Estado"</b>.
                </div>

                <!-- Banner de Rechazo de la DIAN -->
                <div class="alert alert-danger text-center mb-0"
                     role="alert"
                     invisible="l10n_co_ne_state != 'rejected'">
                    <strong>Nómina Rechazada por la DIAN</strong>
                    <br/>
                    Revise los detalles del error en el chatter a continuación. Corrija los datos correspondientes en el empleado, contrato o compañía, y vuelva a hacer clic en <b>"Enviar y Procesar"</b> para retransmitir con el mismo consecutivo (sin desperdiciar números).
                </div>

                <!-- R-2: la retención en la fuente no cabe en el recibo -->
                <div class="alert alert-danger mb-0" role="alert" invisible="l10n_co_ne_rete_faltante &lt;= 0">
                    <strong>La retención en la fuente no cabe en este recibo.</strong>
                    Por descontar: <field name="l10n_co_ne_rete_a_descontar" class="oe_inline"/>;
                    disponible: <field name="l10n_co_ne_rete_disponible" class="oe_inline"/>;
                    sin practicar: <field name="l10n_co_ne_rete_faltante" class="oe_inline"/>.
                    Para confirmar, el administrador de nómina debe marcar «Autorizo confirmar con retención incompleta».
                </div>
                <group invisible="l10n_co_ne_rete_faltante &lt;= 0">
                    <group>
                        <field name="l10n_co_ne_rete_autorizada" groups="hr_payroll.group_hr_payroll_manager" readonly="state not in ('draft', 'verify')"/>
                        <field name="l10n_co_ne_rete_autorizada_por" invisible="not l10n_co_ne_rete_autorizada_por"/>
                        <field name="l10n_co_ne_rete_autorizada_fecha" invisible="not l10n_co_ne_rete_autorizada_fecha"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
            </xpath>

            <!-- Notebook page for NE details -->
            <xpath expr="//notebook" position="inside">
                <page string="Nómina Electrónica" name="nomina_electronica"
                      invisible="country_code != 'CO'">
                    <!-- Doc 53 §26: una sola pestaña DIAN. Un recibo muestra UN ciclo: el del documento mensual
                         (este grupo) o el del recibo (los grupos siguientes), nunca los dos. -->
                    <group string="Documento DIAN mensual"
                           invisible="not l10n_co_ne_documento_id or l10n_co_ne_state != 'draft'">
                        <field name="l10n_co_ne_documento_id" readonly="1"/>
                        <field name="l10n_co_ne_documento_state" widget="account_document_state"/>
                        <field name="l10n_co_ne_documento_message" invisible="not l10n_co_ne_documento_message"/>
                    </group>
                    <group>
                        <group string="Datos de Transmisión">
                            <field name="l10n_co_ne_consecutive"
                                   string="Consecutivo NE"
                                   readonly="1"
                                   invisible="l10n_co_ne_documento_id and l10n_co_ne_state == 'draft'"/>
                            <field name="l10n_co_ne_cune"
                                   string="CUNE"
                                   readonly="1"
                                   invisible="l10n_co_ne_documento_id and l10n_co_ne_state == 'draft'"/>
                            <field name="l10n_co_ne_is_salarial"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group string="Estado DIAN"
                           invisible="l10n_co_ne_documento_id and l10n_co_ne_state == 'draft'">
                            <field name="l10n_co_ne_state"
                                   string="Estado NE"
                                   readonly="1"
                                   widget="badge"
                                   decoration-info="l10n_co_ne_state == 'draft'"
                                   decoration-warning="l10n_co_ne_state in ('generated','sent','uncertain')"
                                   decoration-success="l10n_co_ne_state == 'accepted'"
                                   decoration-danger="l10n_co_ne_state == 'rejected'"
                                   decoration-muted="l10n_co_ne_state == 'eliminated'"/>
                            <field name="l10n_co_ne_xml_attachment_id"
                                   string="Archivo XML"
                                   readonly="1"/>
                        </group>
                    </group>
                    <group string="Novedades y Ausencias (DIAN)">
                        <group>
                            <field name="l10n_co_ne_dias_incapacidad"/>
                            <field name="l10n_co_ne_dias_licencia_mat"/>
                            <field name="l10n_co_ne_dias_licencia_rem"/>
                        </group>
                        <group>
                            <field name="l10n_co_ne_dias_vacaciones"/>
                            <field name="l10n_co_ne_dias_licencia_nr"/>
                            <button name="action_detect_leaves"
                                    string="Detectar Novedades"
                                    type="object"
                                    class="btn-secondary"/>
                        </group>
                        <field name="l10n_co_ne_leave_summary" readonly="1" colspan="2"/>
                    </group>
                    <group string="Nota de Ajuste"
                           invisible="not l10n_co_ne_is_adjustment">
                        <field name="l10n_co_ne_is_adjustment"
                               string="Es Nota de Ajuste"
                               readonly="1"/>
                        <field name="l10n_co_ne_adjustment_ref_cune"
                               string="CUNE Nómina Original"
                               readonly="l10n_co_ne_state != 'draft'"/>
                        <field name="l10n_co_ne_adjustment_type"
                               string="Tipo de Nota de Ajuste"
                               readonly="l10n_co_ne_state != 'draft'"/>
                    </group>
                    <group string="Solicitud DIAN"
                           invisible="l10n_co_ne_documento_id and l10n_co_ne_state == 'draft'">
                        <field name="l10n_co_ne_dian_request"
                               string="Solicitud DIAN"
                               readonly="1"
                               nolabel="1"
                               colspan="4"/>
                    </group>
                    <group string="Respuesta DIAN"
                           invisible="l10n_co_ne_documento_id and l10n_co_ne_state == 'draft'">
                        <field name="l10n_co_ne_dian_response"
                               string="Respuesta DIAN"
                               readonly="1"
                               nolabel="1"
                               colspan="4"/>
                    </group>
                    <group string="Historial DIAN" groups="hr_payroll.group_hr_payroll_manager"
                           invisible="l10n_co_ne_documento_id and l10n_co_ne_state == 'draft'">
                        <field name="l10n_co_ne_exchange_ids" readonly="1" nolabel="1">
                            <list create="0" delete="0">
                                <field name="create_date"/>
                                <field name="operation"/>
                                <field name="zip_key"/>
                                <field name="unidentified_count"/>
                                <field name="transport_error"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <!-- ============================================================ -->
    <!-- .281 (doc 68 §11): pestaña «Días trabajados y entradas» del recibo                                  -->
    <!-- Solo presentación, con atributos nativos: nada de lo que se paga ni de lo que va al XML depende de esto. -->
    <!-- - La etiqueta «Other Inputs» (nativa, traducida «Otras entradas») pasa a «Novedades de nómina»: se oculta   -->
    <!--   el separador original (el primer `separator` hermano que sigue a la lista de días, nat                    -->
    <!--   hr_payslip_views.xml:131 y :160) y se agrega uno nuevo con texto del módulo. Selector POSICIONAL anclado  -->
    <!--   en un @name: Odoo prohíbe los atributos traducibles                                                      -->
    <!--   (string, help, sum, avg, confirm, placeholder, alt, title) como selector de una herencia (base            -->
    <!--   ir_ui_view.py _valid_inheritance); la regresión de .281 cayó por usar @string.                             -->
    <!-- - Importe y horas de la lista de días: columnas opcionales ocultas (el usuario puede mostrarlas). Desde .280 -->
    <!--   «Asistencia» muestra los días pagados y conserva las horas del nativo: importe y horas no se leen como días. -->
    <!-- ============================================================ -->
    <record id="view_payslip_form_ne_dias" model="ir.ui.view">
        <field name="name">hr.payslip.form.ne.dias</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <!-- .284 (E2a): aviso (no bloquea) de las fechas sin entrada de trabajo; el selector va por @name, sin atributos traducibles -->
            <xpath expr="//page[@name='worked_days_input']/field[@name='worked_days_line_ids']" position="before">
                <div class="alert alert-warning mb-2" role="alert" invisible="not l10n_co_ne_aviso_dias">
                    <strong>Revise las entradas de trabajo</strong>
                    <br/>
                    <field name="l10n_co_ne_aviso_dias" readonly="1" nolabel="1"/>
                </div>
            </xpath>
            <xpath expr="//page[@name='worked_days_input']/field[@name='worked_days_line_ids']/following-sibling::separator[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='worked_days_input']/field[@name='worked_days_line_ids']/following-sibling::separator[1]" position="after">
                <separator string="Novedades de nómina"/>
            </xpath>
            <xpath expr="//page[@name='worked_days_input']//field[@name='worked_days_line_ids']/list/field[@name='number_of_hours']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//page[@name='worked_days_input']//field[@name='worked_days_line_ids']/list/field[@name='amount']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <!-- .282: el importe de las novedades se ve con DOS decimales (300.000,00). Causa (nativo, leída por TL en el servidor):
                 hr.payslip.input.amount usa la precisión «Payroll Rate» (4 decimales, hr_payslip_input.py:18-21) y el widget de la lista,
                 float_without_trailing_zeros, solo recorta ceros tras un PUNTO decimal (hr/static/src/components/float_without_trailing_zeros/
                 float_without_trailing_zeros.js:8-13): con coma decimal (es_CO) los ceros quedan. `widget="float"` sustituye el widget y
                 `digits` solo formatea la vista; el valor guardado no cambia (el campo y su precisión no se tocan: el campo guarda pesos, días y horas). -->
            <xpath expr="//page[@name='worked_days_input']//field[@name='input_line_ids']/list/field[@name='amount']" position="attributes">
                <attribute name="widget">float</attribute>
                <attribute name="digits">[16, 2]</attribute>
            </xpath>
            <xpath expr="//page[@name='worked_days_input']//field[@name='input_line_ids']/form//field[@name='amount']" position="attributes">
                <attribute name="digits">[16, 2]</attribute>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Payslip Tree View                                             -->
    <!-- ============================================================ -->
    <record id="view_payslip_tree_ne" model="ir.ui.view">
        <field name="name">hr.payslip.tree.ne</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="l10n_co_ne_state"
                       string="Estado NE (por recibo)"
                       optional="hide"
                       widget="badge"
                       decoration-info="l10n_co_ne_state == 'draft'"
                       decoration-warning="l10n_co_ne_state in ('generated','sent','uncertain')"
                       decoration-success="l10n_co_ne_state == 'accepted'"
                       decoration-danger="l10n_co_ne_state == 'rejected'"
                       decoration-muted="l10n_co_ne_state == 'eliminated'"/>
                <field name="l10n_co_ne_cune"
                       string="CUNE"
                       optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Payslip Search View                                           -->
    <!-- ============================================================ -->
    <record id="view_hr_payslip_filter_ne" model="ir.ui.view">
        <field name="name">hr.payslip.select.ne</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_filter"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="l10n_co_ne_state" string="Estado NE (por recibo)"/>
                <field name="l10n_co_ne_consecutive" string="Consecutivo NE"/>
                <separator/>
                <filter string="NE Borrador (por recibo)" name="ne_draft" domain="[('l10n_co_ne_state', '=', 'draft')]"/>
                <filter string="NE Generado (por recibo)" name="ne_generated" domain="[('l10n_co_ne_state', '=', 'generated')]"/>
                <filter string="NE Transmitido (por recibo)" name="ne_sent" domain="[('l10n_co_ne_state', '=', 'sent')]"/>
                <filter string="NE Incierto (por recibo)" name="ne_uncertain" domain="[('l10n_co_ne_state', '=', 'uncertain')]"/>
                <filter string="NE Aceptado (por recibo)" name="ne_accepted" domain="[('l10n_co_ne_state', '=', 'accepted')]"/>
                <filter string="NE Rechazado (por recibo)" name="ne_rejected" domain="[('l10n_co_ne_state', '=', 'rejected')]"/>
                <separator/>
                <filter string="Es Nota de Ajuste" name="ne_is_adjustment" domain="[('l10n_co_ne_is_adjustment', '=', True)]"/>
                <separator/>
                <filter name="date_filter" string="Fecha Desde" date="date_from"/>
                <filter name="date_to_filter" string="Fecha Hasta" date="date_to"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Estado NE (por recibo)" name="group_by_l10n_co_ne_state" context="{'group_by': 'l10n_co_ne_state'}"/>
                <filter string="Es Nota de Ajuste" name="group_by_l10n_co_ne_is_adjustment" context="{'group_by': 'l10n_co_ne_is_adjustment'}"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Server Actions for Mass Processing                            -->
    <!-- ============================================================ -->
    <record id="action_mass_generate_ne_xml" model="ir.actions.server">
        <field name="name">Generar XML Masivo</field>
        <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_mass_generate_ne_xml()</field>
    </record>

    <record id="action_mass_send_ne_dian" model="ir.actions.server">
        <field name="name">Enviar a DIAN Masivo</field>
        <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_mass_send_ne_dian()</field>
    </record>

    <record id="action_send_test_set" model="ir.actions.server">
        <field name="name">Enviar Set de Pruebas DIAN</field>
        <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_send_test_set()</field>
    </record>

</odoo>
