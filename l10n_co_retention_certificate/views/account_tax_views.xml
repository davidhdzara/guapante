<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tax_tree_l10n_co_retention" model="ir.ui.view">
        <field name="name">account.tax.list.l10n.co.retention</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_tree"/>
        <field name="arch" type="xml">
            <field name="type_tax_use" position="after">
                <field name="l10n_co_retention_type" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_tax_form_l10n_co_retention" model="ir.ui.view">
        <field name="name">account.tax.form.l10n.co.retention</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <field name="country_id" position="after">
                <field name="l10n_co_retention_type"
                       invisible="type_tax_use != 'purchase' or amount &gt;= 0"/>
            </field>
        </field>
    </record>

    <record id="view_account_tax_search_l10n_co_retention" model="ir.ui.view">
        <field name="name">account.tax.search.l10n.co.retention</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_account_tax_search"/>
        <field name="arch" type="xml">
            <filter name="purchase" position="after">
                <separator/>
                <filter string="Retención sin clasificar (CO)"
                        name="l10n_co_retention_unclassified"
                        domain="[('type_tax_use', '=', 'purchase'), ('amount', '&lt;', 0), ('l10n_co_retention_type', '=', False)]"/>
            </filter>
            <filter name="taxapp" position="after">
                <filter string="Tipo de Retención (CO)" name="l10n_co_retention_type"
                        domain="[]" context="{'group_by': 'l10n_co_retention_type'}"/>
            </filter>
        </field>
    </record>

</odoo>
