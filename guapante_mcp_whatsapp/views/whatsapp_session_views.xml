<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view -->
    <record id="guapante_mcp_whatsapp_session_view_tree" model="ir.ui.view">
        <field name="name">guapante.mcp.whatsapp.session.view.tree</field>
        <field name="model">guapante.mcp.whatsapp.session</field>
        <field name="arch" type="xml">
            <tree string="Sesiones WhatsApp MCP"
                  decoration-success="state == 'authenticated'"
                  decoration-warning="state in ('pending_confirm', 'pending_branch')"
                  decoration-danger="state == 'blocked'"
                  decoration-muted="state in ('expired',)">
                <field name="whatsapp_number"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="last_activity"/>
                <field name="message_count"/>
                <field name="channel_id"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="guapante_mcp_whatsapp_session_view_form" model="ir.ui.view">
        <field name="name">guapante.mcp.whatsapp.session.view.form</field>
        <field name="model">guapante.mcp.whatsapp.session</field>
        <field name="arch" type="xml">
            <form string="Sesión WhatsApp MCP" create="false">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending_nit,pending_branch,pending_confirm,authenticated"/>
                </header>
                <sheet>
                    <group>
                        <group string="Identificación">
                            <field name="whatsapp_number"/>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Actividad">
                            <field name="last_activity"/>
                            <field name="message_count"/>
                            <field name="nit_tries"/>
                            <field name="channel_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Historial de Conversación">
                            <field name="conversation_history"
                                   widget="ace"
                                   options="{'mode': 'json'}"
                                   readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="guapante_mcp_whatsapp_session_action" model="ir.actions.act_window">
        <field name="name">Sesiones WhatsApp</field>
        <field name="res_model">guapante.mcp.whatsapp.session</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_authenticated': 1}</field>
    </record>
</odoo>
