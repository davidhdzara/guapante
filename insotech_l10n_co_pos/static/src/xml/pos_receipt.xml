<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Extensión DIAN para el Recibo (Tirilla) del POS — Odoo 18 -->
    <t t-name="insotech_l10n_co_pos.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">

        <!-- Título: Factura Electrónica de Venta — justo después del header -->
        <xpath expr="//ReceiptHeader" position="after">
            <div style="font-weight: bold; text-align: center; margin-top: 8px; margin-bottom: 8px; font-size: 13px;">
                FACTURA ELECTRÓNICA DE VENTA
            </div>
        </xpath>

        <!-- Bloque DIAN completo: va ANTES del footer nativo -->
        <xpath expr="//div[hasclass('before-footer')]" position="after">

            <!-- Separador -->
            <div class="text-center">--------------------------------</div>

            <!-- Resolución DIAN -->
            <div style="font-size: 10px; text-align: center; margin-top: 5px;">
                <t t-if="props.data.dian_resolution_text">
                    <div>
                        <strong>Numeración autorizada</strong><br/>
                        <t t-esc="props.data.dian_resolution_text"/>
                    </div>
                </t>
                <t t-else="">
                    <div>Resolución DIAN pendiente de configurar</div>
                </t>
            </div>

            <!-- Actividad económica CIIU -->
            <t t-if="props.data.dian_ciiu_code">
                <div style="font-size: 10px; text-align: center; margin-top: 3px;">
                    Actividad Económica CIIU: <t t-esc="props.data.dian_ciiu_code"/>
                </div>
            </t>

            <!-- Responsabilidades Fiscales -->
            <t t-if="props.data.dian_obligations_text">
                <div style="font-size: 10px; text-align: center; margin-top: 3px;">
                    <strong>Responsabilidades:</strong> <t t-esc="props.data.dian_obligations_text"/>
                </div>
            </t>

            <!-- Forma y Medio de Pago -->
            <div style="font-size: 10px; text-align: center; margin-top: 5px; border-top: 1px dashed #000; padding-top: 5px;">
                <strong>Forma de pago:</strong> <t t-esc="props.data.dian_forma_pago || 'Contado'"/><br/>
                <strong>Medio de pago:</strong> <t t-esc="props.data.dian_medios_pago || 'Efectivo'"/>
            </div>

            <!-- CUFE y QR (solo si ya se generó factura electrónica) -->
            <t t-if="props.data.dian_cufe">
                <div style="text-align: center; margin-top: 8px; border-top: 1px dashed #000; padding-top: 8px;">
                    <img t-att-src="'/report/barcode/?barcode_type=QR&amp;value=' + (props.data.dian_qr || '') + '&amp;width=150&amp;height=150'"
                         style="width: 130px; height: 130px;"/>
                    <div style="font-size: 9px; margin-top: 4px; word-wrap: break-word;">
                        <strong>CUFE:</strong><br/>
                        <t t-esc="props.data.dian_cufe"/>
                    </div>
                </div>
            </t>

            <!-- Aviso legal datos personales -->
            <div style="font-size: 8px; text-align: center; margin-top: 8px; border-top: 1px dashed #000; padding-top: 5px;">
                Los datos personales serán tratados conforme a la política de tratamiento de datos personales.
            </div>

            <!-- Proveedor tecnológico -->
            <div style="font-size: 8px; text-align: center; margin-top: 5px;">
                Software: Odoo ERP<br/>
                Implementado por Infinity Solutions Technology SAS<br/>
                NIT: 901.797.249 — Tel: 3028522449
            </div>

        </xpath>

    </t>
</templates>
