<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_kardex_daily_snapshot" model="ir.cron">
            <field name="name">Kardex Guapante: Generar Snapshots Diarios</field>
            <field name="model_id" ref="model_guapante_kardex_daily"/>
            <field name="state">code</field>
            <field name="code">model.take_daily_snapshot()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <!-- Configurado para correr a la medianoche (00:01:00) UTC -->
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 00:01:00')"/>
        </record>
    </data>
</odoo>
