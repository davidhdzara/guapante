                                <details class="border-bottom pb-3">
                                    <summary class="fw-bold text-dark-green d-flex justify-content-between align-items-center list-unstyled cursor-pointer">
                                        Comprar <i class="fa fa-angle-down"/>
                                    </summary>
                                    <ul class="list-unstyled mt-3 d-flex flex-column gap-2 small text-muted-green ps-2">
