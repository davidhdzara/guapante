<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_footer" inherit_id="website.layout" name="Custom Footer Guapante" active="True">
        <xpath expr="//footer" position="replace">
             <footer id="bottom" data-anchor="true" data-name="Footer" class="bg-light pt-5 pb-4 border-top">
                <div class="container">
                    <div class="row g-4">
                        <!-- Brand -->
                        <div class="col-lg-4 col-md-6 mb-4 mb-md-0">
                            <h5 class="text-uppercase mb-4 fw-bold text-primary">Comercializadora Guapante</h5>
                            <p class="text-muted">
                                Conectamos el campo colombiano con tu mesa. Productos frescos, orgánicos y de la mejor calidad.
                            </p>
                            <div class="mt-4">
                                <a href="#" type="button" class="btn btn-floating btn-primary btn-lg rounded-circle text-white me-2"><i class="fa fa-facebook-f"></i></a>
                                <a href="#" type="button" class="btn btn-floating btn-primary btn-lg rounded-circle text-white me-2"><i class="fa fa-instagram"></i></a>
                                <a href="#" type="button" class="btn btn-floating btn-primary btn-lg rounded-circle text-white"><i class="fa fa-whatsapp"></i></a>
                            </div>
                        </div>

                        <!-- Links -->
                        <div class="col-lg-2 col-md-6 mb-4 mb-md-0">
                            <h5 class="text-uppercase mb-4 fw-bold">Empresa</h5>
                            <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                                <li><a href="/about" class="text-dark text-decoration-none hover-link">Nosotros</a></li>
                                <li><a href="/contactus" class="text-dark text-decoration-none hover-link">Contacto</a></li>
                                <li><a href="/jobs" class="text-dark text-decoration-none hover-link">Trabaja con nosotros</a></li>
                            </ul>
                        </div>

                        <div class="col-lg-2 col-md-6 mb-4 mb-md-0">
                            <h5 class="text-uppercase mb-4 fw-bold">Ayuda</h5>
                            <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                                <li><a href="/help" class="text-dark text-decoration-none hover-link">Preguntas Frecuentes</a></li>
                                <li><a href="/shipping" class="text-dark text-decoration-none hover-link">Envíos y Devoluciones</a></li>
                                <li><a href="/terms" class="text-dark text-decoration-none hover-link">Términos y Condiciones</a></li>
                            </ul>
                        </div>

                        <!-- Contact -->
                        <div class="col-lg-4 col-md-6 mb-4 mb-md-0">
                            <h5 class="text-uppercase mb-4 fw-bold">Contacto</h5>
                            <ul class="list-unstyled mb-0 text-muted">
                                <li class="mb-2"><i class="fa fa-map-marker-alt me-2 text-primary"></i> Vereda Guapante, Guarne, Ant.</li>
                                <li class="mb-2"><i class="fa fa-phone me-2 text-primary"></i> +57 320 123 4567</li>
                                <li class="mb-2"><i class="fa fa-envelope me-2 text-primary"></i> contacto@guapante.com.co</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="text-center p-3 mt-4 border-top bg-white">
                    © 2023 Copyright: <a class="text-dark fw-bold" href="/">Guapante.com.co</a>
                </div>
            </footer>
        </xpath>
    </template>
</odoo>
