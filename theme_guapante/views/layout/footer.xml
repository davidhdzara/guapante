                                <ul class="list-unstyled d-flex flex-column gap-2 small text-muted-green">
                                    <li><a href="/shop" class="text-reset text-decoration-none hover-primary transition-base">Categorías</a></li>
                                    <li><a href="/shop" class="text-reset text-decoration-none hover-primary transition-base">Ofertas</a></li>
                                    <li><a href="/shop" class="text-reset text-decoration-none hover-primary transition-base">Nuevos</a></li>
                                    <li><a href="/b2b" class="text-reset text-decoration-none hover-primary transition-base">Mayorista</a></li>
                                </ul>
                            </div>
                            
