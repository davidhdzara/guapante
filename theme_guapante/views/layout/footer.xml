                                </p>
                                <div class="d-flex gap-3">
                                    <a href="https://www.instagram.com/donguapante/" class="text-muted-green hover-primary transition-base" target="_blank"><i class="fa fa-instagram fs-5"/></a>
                                    <a href="https://wa.me/+573018101132" class="text-muted-green hover-primary transition-base" target="_blank"><i class="fa fa-whatsapp fs-5"/></a>
                                </div>
                            </div>
                            
                            <!-- Col 2: Comprar -->
                            <div class="col-lg-2 col-md-4 d-none d-md-block">
