                                <h5 class="fw-bold mb-3 text-dark-green">Ayuda</h5>
                                <ul class="list-unstyled d-flex flex-column gap-2 small text-muted-green">
                                    <li><a href="/ayuda" class="text-reset text-decoration-none hover-primary transition-base">Centro de Ayuda</a></li>
                                    <li><a href="/ayuda/envios" class="text-reset text-decoration-none hover-primary transition-base">Envíos</a></li>
                                    <li><a href="/ayuda/devoluciones" class="text-reset text-decoration-none hover-primary transition-base">Devoluciones</a></li>
                                    <li><a href="/contactus" class="text-reset text-decoration-none hover-primary transition-base">Contacto</a></li>
                                    <li><a href="/politica-tratamiento-de-datos" class="text-reset text-decoration-none hover-primary transition-base">Política tratamiento de datos</a></li>
                                </ul>
                            </div>
                            
                            <!-- Mobile Accordions -->
