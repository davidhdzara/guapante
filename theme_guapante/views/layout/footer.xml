                                <ul class="list-unstyled d-flex flex-column gap-2 small text-muted-green">
                                    <li><a href="/Nosotros" class="text-reset text-decoration-none hover-primary transition-base">Nosotros</a></li>
                                    <li><a href="/farmers" class="text-reset text-decoration-none hover-primary transition-base">Agricultores</a></li>
                                    <li><a href="/sustainability" class="text-reset text-decoration-none hover-primary transition-base">Sostenibilidad</a></li>
                                    <li><a href="/jobs" class="text-reset text-decoration-none hover-primary transition-base">Empleo</a></li>
                                </ul>
                            </div>
                            
                             <!-- Col 4: Ayuda -->
