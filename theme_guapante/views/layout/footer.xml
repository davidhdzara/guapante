                        </div>
                        
                        <!-- Bottom Bar -->
                        <div class="border-top border-light pt-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 text-muted-green small">
                            <p class="mb-0">© 2026 Comercializadora Guapante S.A.S.</p>
                            <p class="mb-0">Sitio web Realizado por <a href="https://www.insotech.it" target="_blank" class="text-muted-green text-decoration-none fw-bold">InSoTech</a></p>
