<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_header" inherit_id="website.layout" name="Custom Header Guapante" active="True">
        <xpath expr="//header" position="replace">
            <header id="top" data-anchor="true" data-name="Header" class="o_header_standard sticky-top">
                <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm py-3">
                    <div class="container">
                        <!-- Logo Texto -->
                        <a href="/" class="navbar-brand fw-bold text-success fs-3">
                            GUAPANTE
                        </a>

                        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarGuapante">
                            <span class="navbar-toggler-icon"></span>
                        </button>

                        <div class="collapse navbar-collapse" id="navbarGuapante">
                            <ul class="navbar-nav mx-auto fw-semibold gap-3">
                                <li class="nav-item"><a class="nav-link" href="/">Inicio</a></li>
                                <li class="nav-item"><a class="nav-link" href="/shop">Tienda</a></li>
                                <li class="nav-item"><a class="nav-link" href="/about">Nosotros</a></li>
                                <li class="nav-item"><a class="nav-link" href="/contactus">Contacto</a></li>
                            </ul>
                            
                            <!-- Accesos Simples (Sin logica compleja por ahora) -->
                            <div class="d-flex align-items-center gap-3">
                                <a href="/shop/cart" class="btn btn-success rounded-pill px-4 text-white">
                                    <i class="fa fa-shopping-cart"></i> Carrito
                                </a>
                            </div>
                        </div>
                    </div>
                </nav>
            </header>
        </xpath>
    </template>
</odoo>
