<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_packaging_form_view_b2b" model="ir.ui.view">
        <field name="name">product.packaging.form.b2b</field>
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="product.product_packaging_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='qty']" position="after">
                <group name="b2b_exclusivity" string="Exclusividad B2B eCommerce">
                    <field name="is_b2b_exclusive" widget="boolean_toggle"/>
                    <field name="b2b_exclusive_customer_ids" widget="many2many_tags" 
                           placeholder="Añadir clientes permitidos..." 
                           invisible="not is_b2b_exclusive"/>
                    <div colspan="2" class="text-muted" invisible="not is_b2b_exclusive">
                        <em>Los empaques marcados como Exclusivo B2B solo serán visibles en el eCommerce para los clientes listados arriba.</em>
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
