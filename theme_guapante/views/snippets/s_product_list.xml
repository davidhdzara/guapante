<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_product_list_guapante" name="Guapante Product List">
        <section class="s_product_list_guapante py-5 bg-white">
            <div class="container py-4">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <h2 class="h2 fw-bold text-dark mb-0">Cosecha en temporada</h2>
                    <span class="badge bg-green-100 text-dark fw-bold px-2 py-1 rounded" style="background-color: rgba(19, 236, 109, 0.2);">Ofertas Flash</span>
                </div>
                
                <div class="row g-4">
                    <!-- Product 1: Aguacate -->
                    <div class="col-sm-6 col-lg-3">
                        <div class="product-card group h-100 bg-white border border-light rounded-4 overflow-hidden d-flex flex-column position-relative">
                            <div class="image-container position-relative bg-light" style="height: 200px;">
                                <img src="/theme_guapante/static/src/img/prod_aguacate.jpg" class="w-100 h-100 object-fit-cover transition-transform" alt="Aguacate Hass"/>
                                <button class="btn btn-light btn-sm rounded-circle position-absolute top-0 end-0 m-2 shadow-sm d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;">
                                    <i class="fa fa-heart-o text-muted"/>
                                </button>
                                <span class="badge bg-primary text-dark position-absolute bottom-0 start-0 m-2 fw-bold">-15%</span>
                            </div>
                            <div class="p-3 d-flex flex-column flex-grow-1 card-body-guapante">
                                <h5 class="fw-bold text-dark mb-1">Aguacate Hass</h5>
                                <p class="text-muted small mb-0">Origen: Antioquia</p>
                                <div class="mt-auto d-flex justify-content-end pt-3">
                                    <button class="btn btn-light rounded-3 d-flex align-items-center justify-content-center hover-primary" style="width: 40px; height: 40px;">
                                        <i class="fa fa-plus"/>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Product 2: Banano -->
                    <div class="col-sm-6 col-lg-3">
                        <div class="product-card group h-100 bg-white border border-light rounded-4 overflow-hidden d-flex flex-column position-relative">
                            <div class="image-container position-relative bg-light" style="height: 200px;">
                                <img src="/theme_guapante/static/src/img/prod_banano.jpg" class="w-100 h-100 object-fit-cover transition-transform" alt="Banano Criollo"/>
                                <button class="btn btn-light btn-sm rounded-circle position-absolute top-0 end-0 m-2 shadow-sm d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;">
                                    <i class="fa fa-heart-o text-muted"/>
                                </button>
                            </div>
                            <div class="p-3 d-flex flex-column flex-grow-1 card-body-guapante">
                                <h5 class="fw-bold text-dark mb-1">Banano Criollo</h5>
                                <p class="text-muted small mb-0">Origen: Urabá</p>
                                <div class="mt-auto d-flex justify-content-end pt-3">
                                    <button class="btn btn-light rounded-3 d-flex align-items-center justify-content-center hover-primary" style="width: 40px; height: 40px;">
                                        <i class="fa fa-plus"/>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Product 3: Tomate -->
                    <div class="col-sm-6 col-lg-3">
                        <div class="product-card group h-100 bg-white border border-light rounded-4 overflow-hidden d-flex flex-column position-relative">
                            <div class="image-container position-relative bg-light" style="height: 200px;">
                                <img src="/theme_guapante/static/src/img/prod_tomate.jpg" class="w-100 h-100 object-fit-cover transition-transform" alt="Tomate Chonto"/>
                                <button class="btn btn-light btn-sm rounded-circle position-absolute top-0 end-0 m-2 shadow-sm d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;">
                                    <i class="fa fa-heart-o text-muted"/>
                                </button>
                            </div>
                            <div class="p-3 d-flex flex-column flex-grow-1 card-body-guapante">
                                <h5 class="fw-bold text-dark mb-1">Tomate Chonto</h5>
                                <p class="text-muted small mb-0">Origen: Cundinamarca</p>
                                <div class="mt-auto d-flex justify-content-end pt-3">
                                    <button class="btn btn-light rounded-3 d-flex align-items-center justify-content-center hover-primary" style="width: 40px; height: 40px;">
                                        <i class="fa fa-plus"/>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Product 4: Papa -->
                    <div class="col-sm-6 col-lg-3">
                        <div class="product-card group h-100 bg-white border border-light rounded-4 overflow-hidden d-flex flex-column position-relative">
                            <div class="image-container position-relative bg-light" style="height: 200px;">
                                <img src="/theme_guapante/static/src/img/prod_papa.jpg" class="w-100 h-100 object-fit-cover transition-transform" alt="Papa Capira"/>
                                <button class="btn btn-light btn-sm rounded-circle position-absolute top-0 end-0 m-2 shadow-sm d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;">
                                    <i class="fa fa-heart-o text-muted"/>
                                </button>
                            </div>
                            <div class="p-3 d-flex flex-column flex-grow-1 card-body-guapante">
                                <h5 class="fw-bold text-dark mb-1">Papa Capira</h5>
                                <p class="text-muted small mb-0">Origen: Boyacá</p>
                                <div class="mt-auto d-flex justify-content-end pt-3">
                                    <button class="btn btn-light rounded-3 d-flex align-items-center justify-content-center hover-primary" style="width: 40px; height: 40px;">
                                        <i class="fa fa-plus"/>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>
    </template>
</odoo>
