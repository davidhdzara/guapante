<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="snippets_guapante" inherit_id="website.snippets" name="Guapante Snippets">
        <xpath expr="//div[@id='snippet_structure']" position="inside">
            <div class="o_panel_header">Guapante</div>
            <t t-snippet="theme_guapante.s_hero_guapante" t-thumbnail="/theme_guapante/static/description/icon.png"/>
            <t t-snippet="theme_guapante.s_features_guapante" t-thumbnail="/theme_guapante/static/description/icon.png"/>
            <t t-snippet="theme_guapante.s_categories_guapante" t-thumbnail="/theme_guapante/static/description/icon.png"/>
            <t t-snippet="theme_guapante.s_product_list_guapante" t-thumbnail="/theme_guapante/static/description/icon.png"/>
            <t t-snippet="theme_guapante.s_b2b_guapante" t-thumbnail="/theme_guapante/static/description/icon.png"/>
        </xpath>
    </template>
</odoo>
