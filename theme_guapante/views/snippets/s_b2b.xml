<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_b2b_guapante" name="Guapante B2B Banner">
        <section class="s_b2b_guapante py-5">
            <div class="container">
                <div class="b2b-banner position-relative rounded-4 overflow-hidden p-4 p-md-5 d-flex align-items-center justify-content-between flex-wrap gap-4 text-white">
                    <div class="o_bg_img_container" style="background-image: url('/theme_guapante/static/src/img/b2b_bg.jpg');"/>
                    
                    <!-- Text Content -->
                    <div class="position-relative z-1 content-wrapper col-lg-6">
                        <h2 class="display-6 fw-black mb-3">¿Tienes un restaurante o tienda?</h2>
                        <p class="mb-4 opacity-75 fw-medium fs-5">Accede a precios mayoristas exclusivos, programación de entregas recurrentes y soporte prioritario.</p>
                        <a href="/contactus" class="btn btn-primary btn-lg rounded-3 fw-bold text-dark border-0">
                            Crear Cuenta de Negocio
                        </a>
                    </div>
                    
                    <!-- Steps Box (Desktop only) -->
                    <div class="position-relative z-1 d-none d-lg-block col-lg-4">
                        <div class="steps-box p-4 rounded-4 backdrop-blur border border-white-20">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="step-circle bg-primary text-dark fw-bold rounded-circle d-flex align-items-center justify-content-center">1</div>
                                <span class="fw-medium">Regístrate como empresa</span>
                            </div>
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="step-circle bg-primary text-dark fw-bold rounded-circle d-flex align-items-center justify-content-center">2</div>
                                <span class="fw-medium">Selecciona tus productos</span>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <div class="step-circle bg-primary text-dark fw-bold rounded-circle d-flex align-items-center justify-content-center">3</div>
                                <span class="fw-medium">Recibe con factura</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
