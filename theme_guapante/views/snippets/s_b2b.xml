<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_b2b_guapante" name="Guapante B2B Banner">
        <section class="s_b2b_guapante py-5" data-snippet="s_b2b_guapante" data-name="B2B Banner">
            <div class="container">
                <div class="banner-box position-relative overflow-hidden rounded-5 text-white shadow-lg">
                    <!-- Background -->
                    <div class="position-absolute top-0 start-0 w-100 h-100 z-0">
                        <div class="bg-img w-100 h-100" 
                             style="background-image: url('/theme_guapante/static/src/img/b2b_bg.jpg'); opacity: 0.2; background-size: cover; background-position: center;">
                        </div>
                    </div>

                    <div class="position-relative z-1 p-5 p-lg-5">
                        <div class="row align-items-center gap-5 gap-lg-0">
                            <!-- Left Content -->
                            <div class="col-12 col-lg-7">
                                <h2 class="display-4 fw-bolder mb-3 lh-1">¿Tienes un restaurante o tienda?</h2>
                                <p class="lead text-white-75 mb-4 fw-medium">Accede a precios mayoristas exclusivos, programación de entregas recurrentes y soporte prioritario 24/7.</p>
                                <a href="/contactus" class="btn btn-primary btn-lg rounded-4 px-4 py-3 fw-bolder text-dark shadow-sm hover-scale">
                                    Crear Cuenta de Negocio
                                </a>
                            </div>

                            <!-- Right Content: Glass Card -->
                            <div class="col-12 col-lg-5 d-flex justify-content-lg-end">
                                <div class="glass-card p-4 rounded-4 border border-white-20 shadow w-100" style="max-width: 400px;">
                                    <div class="d-flex flex-column gap-3">
                                        <!-- Step 1 -->
                                        <div class="d-flex align-items-start gap-3">
                                            <div class="step-circle rounded-circle bg-primary text-dark fw-bold d-flex align-items-center justify-content-center flex-shrink-0 shadow-sm" style="width: 40px; height: 40px;">1</div>
                                            <div>
                                                <h4 class="fw-bold fs-6 mb-1">Regístrate como empresa</h4>
                                                <p class="small text-white-50 mb-0">Validamos tu NIT en menos de 2h.</p>
                                            </div>
                                        </div>
                                        <!-- Step 2 -->
                                        <div class="d-flex align-items-start gap-3">
                                            <div class="step-circle rounded-circle bg-primary text-dark fw-bold d-flex align-items-center justify-content-center flex-shrink-0 shadow-sm" style="width: 40px; height: 40px;">2</div>
                                            <div>
                                                <h4 class="fw-bold fs-6 mb-1">Selecciona tus productos</h4>
                                                <p class="small text-white-50 mb-0">Catálogo mayorista exclusivo.</p>
                                            </div>
                                        </div>
                                        <!-- Step 3 -->
                                        <div class="d-flex align-items-start gap-3">
                                            <div class="step-circle rounded-circle bg-primary text-dark fw-bold d-flex align-items-center justify-content-center flex-shrink-0 shadow-sm" style="width: 40px; height: 40px;">3</div>
                                            <div>
                                                <h4 class="fw-bold fs-6 mb-1">Recibe con factura legal</h4>
                                                <p class="small text-white-50 mb-0">Ideal para contabilidad y deducciones.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
