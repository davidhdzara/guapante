<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_b2b_guapante" name="Guapante B2B Banner">
        <section class="s_b2b_guapante py-5 bg-white">
            <div class="container-fluid px-lg-5">
                <div class="b2b-banner position-relative rounded-4 overflow-hidden p-4 p-md-5 d-flex align-items-center justify-content-between flex-wrap gap-4 text-white" style="background-color: #14532d;">
                    <!-- Background Image with Overlay -->
                    <div class="o_bg_img_container" style="background-image: url('/theme_guapante/static/src/img/b2b_bg.jpg');"/>
                    <div class="position-absolute top-0 start-0 w-100 h-100 bg-black opacity-25 z-0"/> 

                    <!-- Text Content -->
                    <div class="position-relative z-1 content-wrapper col-lg-6">
                        <h2 class="display-6 fw-bold mb-3 text-white">¿Tienes un restaurante o tienda?</h2>
                        <p class="mb-4 text-white opacity-75 fw-medium fs-5">Accede a precios mayoristas exclusivos, programación de entregas recurrentes y soporte prioritario.</p>
                        <a href="/contactus" class="btn btn-lg rounded-3 fw-bold text-dark border-0 hover-scale" style="background-color: #22c55e;">
                            Crear Cuenta de Negocio
                        </a>
                    </div>
                    
                    <!-- Steps Box (Desktop only) -->
                    <div class="position-relative z-1 d-none d-lg-block col-lg-5">
                        <div class="steps-box p-4 rounded-4 backdrop-blur border border-white-10" style="background-color: rgba(255, 255, 255, 0.1);">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="step-circle fw-bold rounded-circle d-flex align-items-center justify-content-center text-dark" style="background-color: #22c55e; width: 32px; height: 32px;">1</div>
                                <span class="fw-medium text-white">Regístrate como empresa</span>
                            </div>
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="step-circle fw-bold rounded-circle d-flex align-items-center justify-content-center text-dark" style="background-color: #22c55e; width: 32px; height: 32px;">2</div>
                                <span class="fw-medium text-white">Selecciona tus productos</span>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <div class="step-circle fw-bold rounded-circle d-flex align-items-center justify-content-center text-dark" style="background-color: #22c55e; width: 32px; height: 32px;">3</div>
                                <span class="fw-medium text-white">Recibe con factura</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
