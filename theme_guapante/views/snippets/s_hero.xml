<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_hero_guapante" name="Guapante Hero">
        <section class="s_hero_guapante my-4">
            <div class="container-fluid px-lg-5">
                <div class="hero-card position-relative overflow-hidden rounded-4 shadow-sm" style="min-height: 600px;">
                    <!-- Background Image -->
                    <div class="o_bg_img_container position-absolute top-0 start-0 w-100 h-100"
                         style="background-image: url('/theme_guapante/static/src/img/hero_bg_boyaca_2026.png'); background-size: cover; background-position: center;">
                    </div>

                    <!-- Overlay Gradient -->
                    <div class="position-absolute top-0 start-0 w-100 h-100"
                         style="background: linear-gradient(to right, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.25) 50%, rgba(0,0,0,0) 100%); pointer-events: none;">
                    </div>

                    <!-- Content -->
                    <div class="position-relative h-100 d-flex align-items-center p-5">
                        <div class="row w-100 m-0">
                            <div class="col-lg-8 col-md-11 text-white ps-lg-5">
                                <h1 class="display-4 fw-bold mb-4 animate-fade-in drop-shadow-lg" style="letter-spacing: -0.02em; line-height: 1.15;">
                                    EL 7 DE AGOSTO HACEMOS UN ALTO EN NUESTRAS LABORES.
                                </h1>
                                <p class="lead mb-0 fs-5 fw-light animate-fade-in drop-shadow-md pe-lg-5" style="animation-delay: 0.2s; opacity: 0.95;">
                                    Conmemoramos la Batalla de Boyacá y el espíritu de nuestra tierra.<br class="d-none d-lg-block"/>
                                    Retomaremos actividades el sábado 8 de agosto.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
