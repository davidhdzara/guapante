<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_features_guapante" name="Guapante Features">
        <section class="s_features_guapante py-5 bg-white">
            <div class="container py-4">
                <div class="row g-4">
                    <!-- Feature 1: Completeness -->
                    <div class="col-md-4">
                        <div class="feature-card p-4 rounded-4 h-100 bg-green-50 d-flex flex-column align-items-start">
                            <div class="icon-box mb-3 text-success bg-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 50px; height: 50px;">
                                <i class="fa fa-clock-o fs-4"/>
                            </div>
                            <h3 class="h5 fw-bold mb-2 text-dark">Frescura 24h</h3>
                            <p class="text-muted mb-0">Nuestros productos son recolectados y entregados en tiempo récord.</p>
                        </div>
                    </div>
                    <!-- Feature 2: Logistics -->
                    <div class="col-md-4">
                        <div class="feature-card p-4 rounded-4 h-100 bg-blue-50 d-flex flex-column align-items-start">
                            <div class="icon-box mb-3 text-info bg-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 50px; height: 50px;">
                                <i class="fa fa-truck fs-4"/>
                            </div>
                            <h3 class="h5 fw-bold mb-2 text-dark">Logística Superior</h3>
                            <p class="text-muted mb-0">Flota propia refrigerada que asegura la cadena de frío.</p>
                        </div>
                    </div>
                    <!-- Feature 3: Fair Trade -->
                    <div class="col-md-4">
                        <div class="feature-card p-4 rounded-4 h-100 bg-orange-50 d-flex flex-column align-items-start">
                            <div class="icon-box mb-3 text-warning bg-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 50px; height: 50px;">
                                <i class="fa fa-handshake-o fs-4"/>
                            </div>
                            <h3 class="h5 fw-bold mb-2 text-dark">Comercio Justo</h3>
                            <p class="text-muted mb-0">Trabajamos directamente con familias campesinas.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
