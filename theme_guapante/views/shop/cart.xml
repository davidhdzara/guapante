<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- 1. CART PAGE: Title and info banner                           -->
    <!--    Inherits: website_sale.cart                                -->
    <!-- ============================================================ -->

    <template id="cart_guapante" inherit_id="website_sale.cart" name="Guapante Cart">
        <!-- Change Title and Subtitle -->
        <xpath expr="//h3[@class='mb-4']" position="replace">
            <div class="guapante-cart-header">
                <h1>Tu Carrito de Compras</h1>
                <p class="subtitle mb-4">Revisa tus productos frescos antes de solicitar tu orden. Confirmamos el peso y stock antes de cobrar.</p>
            </div>
        </xpath>

        <!-- Hide original alerts or banners if any. FIX: Use ID selector -->
        <xpath expr="//div[@id='oe_structure_website_sale_cart_2']" position="attributes">
            <attribute name="class" add="d-none" separator=" "/>
        </xpath>
        
        <!-- Continue Shopping Link (Bottom Left) -->
        <!-- FIX: Target div ID structure instead of oe_cart which doesn't exist here -->
        <xpath expr="//div[@id='oe_structure_website_sale_cart_1']" position="before">
            <a href="/shop" class="guapante-continue-shopping mt-4 mb-3 d-inline-block">
                <i class="fa fa-arrow-left"></i> Seguir comprando frutas y verduras
            </a>
        </xpath>
    </template>

    <!-- ============================================================ -->
    <!-- 2. CART LINES: Card Layout for DIV Structure                  -->
    <!--    Inherits: website_sale.cart_lines                          -->
    <!-- ============================================================ -->

    <template id="cart_lines_guapante" inherit_id="website_sale.cart_lines" name="Guapante Cart Lines">
        
        <!-- Inject Header BEFORE the product loop -->
        <xpath expr="//div[@t-foreach='website_sale_order.website_order_line']" position="before">
            <div class="guapante-cart-list-header d-none d-md-flex px-3 mb-2 mt-4">
                <div class="header-label flex-grow-1">Producto</div>
                <div class="header-label text-center" style="width: 140px; margin: 0 1rem;">Cantidad</div>
                <div class="header-label" style="width: 25px;"></div>
            </div>
        </xpath>

        <!-- FIX: Target DIVs by t-foreach attribute instead of hasclass. This is more robust. -->
        <xpath expr="//div[@t-foreach='website_sale_order.website_order_line']" position="attributes">
            <attribute name="class" add="guapante-cart-item text-decoration-none" separator=" "/>
        </xpath>

        <!-- Replace the inner content of the product loop -->
        <!-- The inner content is inside a t-if="line.product_id" -->
        <xpath expr="//div[@t-foreach='website_sale_order.website_order_line']//t[@t-if='line.product_id']" position="replace">
            <t t-if="line.product_id">
                <div class="img-container me-3">
                    <span t-if="line._is_not_sellable_line() and line.product_id.image_128">
                        <img t-att-src="image_data_uri(line.product_id.image_128)" class="rounded" t-att-alt="line.name_short"/>
                    </span>
                    <span t-else="" t-field="line.product_id.image_128" t-options="{'widget': 'image', 'qweb_img_responsive': False, 'class': 'rounded'}"/>
                </div>
                
                <div class="content d-flex flex-grow-1 align-items-center justify-content-between">
                    <!-- Product Info -->
                    <div class="info">
                        <h5 t-field="line.name_short" class="mb-1"/>
                        <div class="variant text-muted small">
                            Variante: <span t-field="line.product_id.name"/>
                        </div>
                    </div>

                    <!-- Quantity Control -->
                    <div class="qty-section text-center mx-3">
                        <t t-set="is_weight" t-value="line.product_id.uom_id.category_id.id == request.env.ref('uom.product_uom_categ_kgm').id"/>
                        <div class="label text-muted small fw-bold mb-1">
                            <t t-if="is_weight">PESO (KG)</t>
                            <t t-else="">CANTIDAD (UNIDADES)</t>
                        </div>
                        
                        <div class="qty-control guapante-cart-qty-controls d-flex align-items-center bg-light rounded px-2 py-1"
                             t-att-data-line-id="line.id"
                             t-att-data-product-id="line.product_id.id"
                             t-att-data-uom-mode="'kg' if is_weight else 'unit'">
                             
                            <a href="#" class="js_add_cart_json btn btn-link text-dark p-0 guapante-cart-qty-minus" aria-label="Remove one" title="Remove one">
                                <i class="fa fa-minus small"/>
                            </a>
                            <input type="text" 
                                   class="js_quantity guapante-cart-qty-input form-control border-0 bg-transparent text-center p-0 mx-2 fw-bold" 
                                   t-att-value="line._get_displayed_quantity()"
                                   style="width: 40px;"/>
                            <a href="#" class="js_add_cart_json btn btn-link text-dark p-0 guapante-cart-qty-plus" aria-label="Add one" title="Add one">
                                <i class="fa fa-plus small"/>
                            </a>
                        </div>
                    </div>

                    <!-- Delete Action -->
                    <div class="actions">
                        <a href="#" class="js_delete_product text-success" aria-label="Eliminar" title="Eliminar">
                            <i class="fa fa-trash fs-5"></i>
                        </a>
                    </div>
                </div>
            </t>
        </xpath>

    </template>

    <!-- ============================================================ -->
    <!-- 3. CHECKOUT LAYOUT: Summary Card                              -->
    <!--    Inherits: website_sale.checkout_layout                     -->
    <!-- ============================================================ -->

    <template id="checkout_layout_guapante" inherit_id="website_sale.checkout_layout" name="Guapante Checkout Summary">
        <!-- Custom Summary Card (Target inner card div) -->
        <xpath expr="//div[@id='o_cart_summary']//div[hasclass('o_total_card')]" position="replace">
            <div class="o_total_card guapante-order-summary card sticky-lg-top border-0 shadow-sm">
                <div class="card-body p-4">
                    <h5 class="title mb-3">Resumen del Pedido</h5>

                    <div class="info-box mb-4 p-3 bg-light rounded d-flex align-items-start gap-2">
                        <i class="fa fa-info-circle text-primary mt-1"></i>
                        <p class="mb-0 small text-primary">
                            El valor final del pedido será confirmado posterior a la validación de pesaje y disponibilidad de stock.
                        </p>
                    </div>

                    <div class="products-count d-flex justify-content-between align-items-center mb-4">
                        <span class="text-muted">Productos agregados</span>
                        <span class="fw-bold fs-5">
                            <t t-esc="len(website_sale_order.website_order_line)"/> productos
                        </span>
                    </div>

                    <a href="/shop/checkout?express=1" class="btn btn-order w-100 mb-4 d-flex justify-content-center align-items-center gap-2 text-white" style="background-color: #00E676;">
                        Ordenar <i class="fa fa-check"></i>
                    </a>

                    <div class="security-badges text-center">
                        <div class="d-flex justify-content-center align-items-center gap-2 mb-1 text-muted small">
                            <i class="fa fa-lock"></i> Pedido procesado de forma segura
                        </div>
                        <div class="d-flex justify-content-center align-items-center gap-2 text-muted small">
                            <i class="fa fa-check-circle"></i> Garantía de frescura Guapante
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
