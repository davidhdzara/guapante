<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="guapante_order_status" name="Guapante Order Status">
        <t t-call="website.layout">
            <div id="wrap" class="guapante-status-wrapper">
                <div class="container py-4">

                    <!-- ============ HEADER ============ -->
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
                        <div>
                            <small class="text-muted">Orden #<t t-esc="order.name"/></small>
                            <h2 class="fw-bold mb-0 mt-1">
                                <t t-if="order.guapante_delivery_status == 'received'">Pedido Recibido</t>
                                <t t-if="order.guapante_delivery_status == 'preparing'">Validación y Pesaje</t>
                                <t t-if="order.guapante_delivery_status == 'shipping'">En Camino</t>
                                <t t-if="order.guapante_delivery_status == 'delivered'">Entregado</t>
                            </h2>
                        </div>
                    </div>

                    <!-- ============ TWO-COLUMN LAYOUT ============ -->
                    <div class="row g-4">

                        <!-- ========== LEFT COLUMN ========== -->
                        <div class="col-12 col-lg-7">

                            <!-- CARD: Progreso del Pedido (Vertical Timeline) -->
                            <div class="card border-0 shadow-sm mb-4">
                                <div class="card-body p-4">
                                    <h6 class="fw-bold mb-4">Progreso del Pedido</h6>

                                    <div class="guapante-vtimeline">

                                        <!-- Step 1: Pedido Recibido -->
                                        <div t-att-class="'guapante-vt-step ' + ('completed' if order.guapante_delivery_status in ['received', 'preparing', 'shipping', 'delivered'] else 'pending')">
                                            <div class="guapante-vt-icon">
                                                <i class="fa fa-check"></i>
                                            </div>
                                            <div class="guapante-vt-content">
                                                <div class="guapante-vt-title">Pedido Recibido</div>
                                                <div class="guapante-vt-desc text-muted small">Hemos recibido tu orden y confirmado el inventario inicial.</div>
                                                <div class="guapante-vt-time text-muted small mt-1">
                                                    <span t-field="order.date_order" t-options='{"widget": "datetime", "format": "hh:mm a"}'/>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Step 2: Validación y Pesaje -->
                                        <div t-att-class="'guapante-vt-step ' + ('active' if order.guapante_delivery_status == 'preparing' else 'completed' if order.guapante_delivery_status in ['shipping', 'delivered'] else 'pending')">
                                            <div class="guapante-vt-icon">
                                                <t t-if="order.guapante_delivery_status == 'preparing'">
                                                    <i class="fa fa-spinner fa-spin"></i>
                                                </t>
                                                <t t-else="">
                                                    <i class="fa fa-check"></i>
                                                </t>
                                            </div>
                                            <div class="guapante-vt-content">
                                                <div class="guapante-vt-title">Validación y Pesaje</div>
                                                <div class="guapante-vt-desc text-muted small">Estamos seleccionando los mejores productos y pesándolos para ajustar el valor final.</div>
                                            </div>
                                        </div>

                                        <!-- Step 3: En Camino -->
                                        <div t-att-class="'guapante-vt-step ' + ('active' if order.guapante_delivery_status == 'shipping' else 'completed' if order.guapante_delivery_status == 'delivered' else 'pending')">
                                            <div class="guapante-vt-icon">
                                                <t t-if="order.guapante_delivery_status == 'shipping'">
                                                    <i class="fa fa-truck"></i>
                                                </t>
                                                <t t-else="">
                                                    <i class="fa fa-check"></i>
                                                </t>
                                            </div>
                                            <div class="guapante-vt-content">
                                                <div class="guapante-vt-title">En Camino</div>
                                                <div class="guapante-vt-desc text-muted small">Tu pedido ha salido de nuestro centro de distribución hacia tu dirección.</div>
                                            </div>
                                        </div>

                                        <!-- Step 4: Entregado -->
                                        <div t-att-class="'guapante-vt-step last ' + ('completed' if order.guapante_delivery_status == 'delivered' else 'pending')">
                                            <div class="guapante-vt-icon">
                                                <i class="fa fa-check"></i>
                                            </div>
                                            <div class="guapante-vt-content">
                                                <div class="guapante-vt-title">Entregado</div>
                                                <div class="guapante-vt-desc text-muted small">¡Disfruta de la frescura en tu hogar!</div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>

                            <!-- CARD: Notificación de Pago -->
                            <div class="card border-0 shadow-sm mb-4" style="border-left: 4px solid #17a2b8 !important;">
                                <div class="card-body p-3 d-flex align-items-start">
                                    <i class="fa fa-info-circle text-info me-3 mt-1 fs-5"></i>
                                    <div>
                                        <div class="fw-bold small">Notificación de Pago</div>
                                        <p class="text-muted small mb-0">Una vez finalicemos el pesaje de tus productos frescos, recibirás un mensaje por <strong>WhatsApp</strong> con el valor exacto a pagar y el link de pago.</p>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <!-- ========== RIGHT COLUMN ========== -->
                        <div class="col-12 col-lg-5">

                            <!-- CARD: Detalles del Envío -->
                            <t t-set="delivery_partner" t-value="order.partner_shipping_id or order.partner_id"/>
                            <div class="card border-0 shadow-sm mb-4">
                                <div class="card-body p-4">
                                    <h6 class="fw-bold mb-3"><i class="fa fa-truck me-2"></i>Detalles del Envío</h6>
                                    
                                    <div class="mb-3">
                                        <div class="text-uppercase text-muted small fw-bold mb-1" style="font-size:0.7rem; letter-spacing:0.5px;">Cliente</div>
                                        <div class="fw-semibold"><t t-esc="delivery_partner.name"/></div>
                                    </div>

                                    <hr class="my-2"/>

                                    <div class="mb-3">
                                        <div class="text-uppercase text-muted small fw-bold mb-1" style="font-size:0.7rem; letter-spacing:0.5px;">Dirección de Entrega</div>
                                        <div class="small">
                                            <t t-if="delivery_partner.street"><t t-esc="delivery_partner.street"/><br/></t>
                                            <t t-if="delivery_partner.street2"><t t-esc="delivery_partner.street2"/><br/></t>
                                            <t t-if="delivery_partner.city"><t t-esc="delivery_partner.city"/></t>
                                            <t t-if="delivery_partner.state_id">, <t t-esc="delivery_partner.state_id.name"/></t>
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <!-- CARD: Productos -->
                            <div class="card border-0 shadow-sm mb-4">
                                <div class="card-body p-4">
                                    <h6 class="fw-bold mb-3"><i class="fa fa-shopping-bag me-2"></i>Productos (<t t-esc="len(order.order_line)"/>)</h6>

                                    <t t-foreach="order.order_line" t-as="line">
                                        <div class="d-flex align-items-center py-2">
                                            <div class="flex-shrink-0">
                                                <span t-field="line.product_id.image_128" t-options="{'widget': 'image', 'qweb_img_responsive': False, 'class': 'rounded', 'style': 'width: 48px; height: 48px; object-fit: cover;'}"/>
                                            </div>
                                            <div class="flex-grow-1 ms-3">
                                                <div class="fw-semibold small"><t t-esc="line.name_short"/></div>
                                                <div class="text-muted" style="font-size:0.75rem;">
                                                    <t t-if="line.product_id.description_sale">
                                                        <t t-esc="line.product_id.description_sale[:40]"/>
                                                    </t>
                                                </div>
                                            </div>
                                            <div class="text-end ms-2">
                                                <span class="badge bg-light text-dark border small">
                                                    x<t t-esc="int(line.product_uom_qty)"/> <t t-esc="line.product_uom.name"/>
                                                </span>
                                            </div>
                                        </div>
                                        <t t-if="not line_last">
                                            <hr class="my-1 opacity-25"/>
                                        </t>
                                    </t>
                                </div>
                            </div>

                            <!-- BUTTON: ¿Necesitas ayuda? -->
                            <a href="/contactus" class="btn btn-dark w-100 py-3 rounded-3 fw-semibold shadow-sm">
                                <i class="fa fa-headphones me-2"></i> ¿Necesitas ayuda?
                            </a>

                        </div>

                    </div><!-- /row -->

                </div>
            </div>
        </t>
    </template>
</odoo>
