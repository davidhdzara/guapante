<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="products_item_guapante" inherit_id="website_sale.products_item" name="Guapante Product Item">
        
        <!-- 1. Hide Price and "Consultar Precio" Text -->
        <xpath expr="//div[hasclass('product_price')]" position="attributes">
             <attribute name="class" add="d-none" separator=" "/>
        </xpath>

        <!-- 2. Customize Product Image Container (Taller) -->
        <xpath expr="//div[hasclass('oe_product_image')]" position="attributes">
            <attribute name="class" add="guapante-product-image" separator=" "/>
        </xpath>

        <!-- 3. Replace Wishlist Heart Icon with Shopping Cart Icon -->
        <xpath expr="//a[hasclass('o_add_wishlist')]/i" position="replace">
            <i class="fa fa-shopping-cart"></i>
        </xpath>

        <!-- 4. Add custom class to wishlist button for styling -->
        <xpath expr="//a[hasclass('o_add_wishlist')]" position="attributes">
            <attribute name="class" add="guapante-cart-icon" separator=" "/>
            <attribute name="title">Agregar al carrito</attribute>
            <attribute name="aria-label">Agregar al carrito</attribute>
        </xpath>
        
    </template>
</odoo>
