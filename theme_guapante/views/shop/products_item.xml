<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="products_item_guapante" inherit_id="website_sale.products_item" name="Guapante Product Item">
        
        <!-- 1. Hide Price and "Consultar Precio" Text -->
        <xpath expr="//div[hasclass('product_price')]" position="attributes">
             <attribute name="class" add="d-none" separator=" "/>
        </xpath>

        <!-- 2. Customize Product Image Container (Taller) -->
        <xpath expr="//div[hasclass('oe_product_image')]" position="attributes">
            <attribute name="class" add="guapante-product-image" separator=" "/>
        </xpath>

        <!-- 3. Customize Cart Button (Link to Detail) -->
        <!-- Move/Replace the standard buttons with our custom icon button at the bottom right -->
        <xpath expr="//div[hasclass('o_wsale_product_btn')]" position="replace">
            <div class="guapante-card-actions position-absolute bottom-0 end-0 p-3">
                <a t-att-href="product_href" class="btn btn-dark rounded-3 d-flex align-items-center justify-content-center shadow-sm" aria-label="Ver Detalles">
                    <i class="fa fa-shopping-cart text-white"></i>
                </a>
            </div>
        </xpath>
        
    </template>
</odoo>
