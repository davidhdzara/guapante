<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Category Icons: Inherit from the link template and add icons -->
    <template id="categorie_link_guapante" inherit_id="website_sale.categorie_link" name="Guapante Category Link with Icon">
        <xpath expr="//a[@t-field='c.name']" position="replace">
            <a t-att-href="keep('/shop/category/' + slug(c), category=0)" 
               t-att-class="'p-0 d-flex align-items-center %s' % ('guapante-active' if category and category.id == c.id else '')">
                <!-- Category Icon (from image or fallback) -->
                <!-- Category Icon (from image or fallback) -->
                <t t-if="c.image_128">
                    <span t-field="c.image_128" 
                          t-options="{'widget': 'image', 'qweb_img_responsive': False, 'class': 'me-2 flex-shrink-0', 'style': 'width: 24px; height: 24px; object-fit: contain; border-radius: 4px;'}"/>
                </t>
                <t t-else="">
                    <i class="fa fa-leaf me-2 text-muted opacity-50 flex-shrink-0" style="font-size: 16px; width: 24px; text-align: center;"/>
                </t>
                <!-- Category Name -->
                <span t-field="c.name"/>
            </a>
        </xpath>
    </template>
    
    <!-- Standalone Template for Sidebar Extras -->
    <template id="sidebar_extras_content" name="Guapante Sidebar Extras Content">
        <div class="guapante-sidebar-extras">
            <!-- 1. De Temporada Toggle -->
            <div class="seasonal-container d-flex align-items-center justify-content-between">
                <div class="d-flex flex-column">
                    <span class="fw-bold small text-dark">De Temporada</span>
                    <span class="text-muted" style="font-size: 0.7rem;">Solo cosecha actual</span>
                </div>
                <div class="form-check form-switch m-0">
                    <input class="form-check-input" type="checkbox" id="seasonalToggle" style="cursor: pointer;"/>
                </div>
            </div>

            <!-- 2. Logistica Guapante Box -->
            <div class="guapante-logistics-box">
                <div class="d-flex align-items-center mb-2">
                    <i class="fa fa-truck text-success me-2"></i>
                    <span class="fw-bold text-success" style="font-size: 0.8rem;">Logística Guapante</span>
                </div>
                <p class="mb-0 text-muted lh-sm" style="font-size: 0.75rem;">
                    Entregas en menos de 24h para garantizar la frescura de tus productos.
                </p>
            </div>
        </div>
    </template>
    
    <!-- Inject Sidebar Extras into Categories Sidebar -->
    <template id="products_categories_guapante_extras" inherit_id="website_sale.products_categories_list" name="Guapante Sidebar Extras Injection">
        
        <!-- 1. Header Filtros (Antes de la lista) -->
        <xpath expr="//ul" position="before">
            <div class="guapante-sidebar-header mb-3">
                <h5 class="fw-bold text-dark mb-1">Filtros</h5>
                <span class="text-muted small">Refinar catálogo</span>
            </div>
            <h6 class="text-muted text-uppercase small fw-bold mb-3 mt-4" style="letter-spacing: 0.05em; font-size: 0.75rem;">Categorías</h6>
        </xpath>

        <!-- 2. Extras (Despues de la lista) -->
        <xpath expr="//ul" position="after">
            <t t-call="theme_guapante.sidebar_extras_content"/>
        </xpath>
    </template>
</odoo>
