<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Colombian ID fields to address form - Simple version -->
    <template id="address_guapante_colombia_simple" inherit_id="website_sale.address" name="Guapante - Colombian Fields Simple">
        
        <!-- Add fields before VAT -->
        <xpath expr="//div[@id='div_vat']" position="before">
            
            <!-- Tipo de Identificación -->
            <div class="col-lg-6 mb-2">
                <label class="col-form-label fw-normal" for="l10n_latam_identification_type_id">Tipo de Identificación</label>
                <select name="l10n_latam_identification_type_id" class="form-select">
                    <option value="">Seleccione...</option>
                    <t t-foreach="request.env['l10n_latam.identification.type'].sudo().search([('country_id.code', '=', 'CO')])" t-as="id_type">
                        <option t-att-value="id_type.id" t-att-selected="'selected' if partner_sudo and partner_sudo.l10n_latam_identification_type_id.id == id_type.id else None">
                            <t t-esc="id_type.name"/>
                        </option>
                    </t>
                </select>
            </div>
            
        </xpath>
        
        <!-- Update VAT label -->
        <xpath expr="//div[@id='div_vat']/label" position="replace">
            <label class="col-form-label fw-normal" for="o_vat">Número de Identificación</label>
        </xpath>
        
    </template>
</odoo>
