<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="address_guapante" inherit_id="website_sale.address" name="Guapante Address Overrides">
        <!-- 
            Fix for missing street field:
            The previous xpath failed because 'div_street' was removed from the DOM by another module (likely l10n_co).
            We re-inject it BEFORE the City field to ensure it exists.
        -->
        <xpath expr="//div[hasclass('div_city')]" position="before">
            <div class="col-12 mb-3 div_street">
                <label class="col-form-label" for="street">Dirección completa <span class="d-none d-md-inline text-muted small fw-normal">(Calle, carrera, número)</span></label>
                <input type="text" name="street" class="form-control" required="required"/>
            </div>
        </xpath>
    </template>
</odoo>
