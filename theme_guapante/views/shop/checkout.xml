<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- GUAPANTE CHECKOUT PAGE                                      -->
    <!-- Replaces standard address/checkout steps with a single page -->
    <!--                                                              -->
    <!-- NO <form> wrapper — Odoo's layout already wraps in a form.  -->
    <!-- NO required attributes — there's no form submission.         -->
    <!-- The "Confirmar Pedido" button is a simple <a> link that      -->
    <!-- redirects to /shop/checkout/confirm.                         -->
    <!-- Address changes use Odoo's native /shop/update_address API.  -->
    <!-- ============================================================ -->

    <template id="guapante_checkout" name="Guapante Checkout">
        <t t-call="website.layout">
            <div id="wrap" class="guapante-checkout-wrapper">
                <div class="container oe_website_sale py-5">
                    
                    <h1 class="mb-2">Confirmación de Pedido</h1>
                    <p class="text-muted mb-5">Revise sus datos y confirme su pedido. El pago se realizará contra entrega o tras confirmación de peso.</p>

                    <div class="row">
                        <!-- LEFT COLUMN: INFO (READ-ONLY) -->
                        <div class="col-12 col-lg-7">
                            
                            <!-- 1. CONTACT INFO (Read-Only from Partner) -->
                            <div class="card border-0 shadow-sm mb-4 guapante-checkout-card">
                                <div class="card-body p-4">
                                    <div class="d-flex align-items-center mb-4">
                                        <div class="step-circle bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px; font-weight: bold;">1</div>
                                        <h5 class="mb-0 fw-bold">Información de Contacto</h5>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-bold small">Nombre Completo</label>
                                        <div class="form-control bg-light text-muted">
                                            <t t-esc="website_sale_order.partner_id.name"/>
                                        </div>
                                    </div>
                                    
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold small">Correo Electrónico</label>
                                            <div class="form-control bg-light text-muted">
                                                <t t-esc="website_sale_order.partner_id.email"/>
                                            </div>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold small">Teléfono Celular</label>
                                            <div class="form-control bg-light text-muted">
                                                <t t-esc="website_sale_order.partner_id.phone or website_sale_order.partner_id.mobile or '-'"/>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- WhatsApp Checkbox -->
                                    <div class="form-check mb-3">
                                        <input class="form-check-input" type="checkbox" name="whatsapp_notifications" id="whatsappCheck"/>
                                        <label class="form-check-label text-muted small" for="whatsappCheck">
                                            Mantenerme informado sobre el estado de mi pedido vía WhatsApp.
                                        </label>
                                    </div>

                                </div>
                            </div>

                            <!-- 2. SHIPPING ADDRESS -->
                            <div class="card border-0 shadow-sm mb-4 guapante-checkout-card">
                                <div class="card-body p-4">
                                    <div class="d-flex align-items-center mb-4">
                                        <div class="step-circle bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px; font-weight: bold;">2</div>
                                        <h5 class="mb-0 fw-bold">Dirección de Envío</h5>
                                    </div>

                                    <!-- Address Selector (If user has addresses) -->
                                    <t t-if="shippings">
                                        <div class="mb-4">
                                            <label class="form-label fw-bold small">Seleccionar dirección guardada</label>
                                            <select class="form-select guapante-field" id="guapante_shipping_select">
                                                <t t-foreach="shippings" t-as="ship">
                                                    <option t-att-value="ship.id" t-att-selected="ship.id == website_sale_order.partner_shipping_id.id">
                                                        <t t-esc="ship.name or ''"/> -
                                                        <t t-if="ship.ref">
                                                            <t t-if="ship.ref == 'cocina'">Cocina</t>
                                                            <t t-elif="ship.ref == 'bar'">Bar</t>
                                                            <t t-elif="ship.ref == 'personal'">Personal</t>
                                                            <t t-elif="ship.ref == 'evento'">Evento</t>
                                                            -
                                                        </t>
                                                        <t t-esc="ship.street or ''"/>
                                                        <t t-if="ship.street2">, <t t-esc="ship.street2"/></t>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>

                                        <!-- Open modal to add new address -->
                                        <div class="mt-3">
                                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                                    data-bs-toggle="modal" data-bs-target="#checkoutAddressModal"
                                                    onclick="resetCheckoutAddressModal()">
                                                <i class="fa fa-plus me-1"></i> Agregar otra dirección
                                            </button>
                                        </div>
                                    </t>

                                    <!-- If no addresses exist -->
                                    <t t-if="not shippings">
                                        <div class="alert alert-warning d-flex align-items-center" role="alert">
                                            <i class="fa fa-exclamation-triangle me-2"></i>
                                            <div>
                                                No tiene direcciones de envío registradas.
                                                <button type="button" class="btn btn-link alert-link p-0 ms-1"
                                                        data-bs-toggle="modal" data-bs-target="#checkoutAddressModal"
                                                        onclick="resetCheckoutAddressModal()">
                                                    Agregar una dirección
                                                </button>
                                            </div>
                                        </div>
                                    </t>

                                </div>
                            </div>

                            <!-- ==========================================
                                 ADD ADDRESS MODAL (Checkout)
                                 ========================================== -->
                            <div class="modal fade" id="checkoutAddressModal" tabindex="-1" aria-labelledby="checkoutAddressModalTitle" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered modal-lg">
                                    <div class="modal-content border-0 rounded-4 shadow">
                                        <div class="modal-header border-0 pb-0 px-4 pt-4">
                                            <h5 class="modal-title fw-bold" id="checkoutAddressModalTitle">Nueva Dirección de Entrega</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                        </div>
                                        <div class="modal-body px-4 py-3">
                                            <form id="checkoutAddressForm" method="POST" action="/shop/address/add_from_checkout">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <input type="hidden" name="type" value="delivery"/>

                                                <div class="row g-3">
                                                    <!-- Name -->
                                                    <div class="col-12 col-md-8">
                                                        <label for="chk_addr_name" class="form-label small fw-semibold text-muted">Nombre / Etiqueta</label>
                                                        <input type="text" id="chk_addr_name" name="name" class="form-control rounded-3"
                                                               placeholder="Ej: Casa, Oficina, Finca..." required="required"/>
                                                    </div>

                                                    <!-- Guapante Order Zone -->
                                                    <div class="col-12 col-md-4">
                                                        <label for="chk_order_zone" class="form-label small fw-semibold text-muted">Zona de la orden</label>
                                                        <select id="chk_order_zone" name="order_zone" class="form-select rounded-3">
                                                            <option value="">— Opcional —</option>
                                                            <option value="cocina">Cocina</option>
                                                            <option value="bar">Bar</option>
                                                            <option value="personal">Personal</option>
                                                            <option value="evento">Evento</option>
                                                        </select>
                                                    </div>

                                                    <!-- Street -->
                                                    <div class="col-12">
                                                        <label for="chk_addr_street" class="form-label small fw-semibold text-muted">Dirección (Calle)</label>
                                                        <input type="text" id="chk_addr_street" name="street" class="form-control rounded-3"
                                                               placeholder="Calle 123 #45-67, Torre 2, Apto 501" required="required"/>
                                                    </div>

                                                    <!-- Street2 -->
                                                    <div class="col-12">
                                                        <label for="chk_addr_street2" class="form-label small fw-semibold text-muted">Barrio / Referencia</label>
                                                        <input type="text" id="chk_addr_street2" name="street2" class="form-control rounded-3"
                                                               placeholder="Barrio El Poblado"/>
                                                    </div>

                                                    <!-- Departamento -->
                                                    <div class="col-12 col-md-6">
                                                        <label for="chk_addr_state" class="form-label small fw-semibold text-muted">Departamento / Estado</label>
                                                        <select id="chk_addr_state" name="state_id" class="form-select rounded-3" required="required">
                                                            <option value="">— Seleccionar Departamento —</option>
                                                            <t t-foreach="states" t-as="st">
                                                                <option t-att-value="st.id">
                                                                    <t t-esc="st.name"/>
                                                                </option>
                                                            </t>
                                                        </select>
                                                    </div>

                                                    <!-- Ciudad (cascading) -->
                                                    <div class="col-12 col-md-6">
                                                        <label for="chk_addr_city" class="form-label small fw-semibold text-muted">Ciudad / Municipio</label>
                                                        <select id="chk_addr_city" name="city_id" class="form-select rounded-3" required="required">
                                                            <option value="">— Primero selecciona Departamento —</option>
                                                        </select>
                                                    </div>

                                                    <!-- ZIP (auto-filled) -->
                                                    <div class="col-12 col-md-6">
                                                        <label for="chk_addr_zip" class="form-label small fw-semibold text-muted">Código Postal</label>
                                                        <input type="text" id="chk_addr_zip" name="zip" class="form-control rounded-3"
                                                               placeholder="Auto-completado" readonly="readonly"/>
                                                    </div>

                                                    <!-- Phone -->
                                                    <div class="col-12 col-md-6">
                                                        <label for="chk_addr_phone" class="form-label small fw-semibold text-muted">Teléfono (opcional)</label>
                                                        <input type="tel" id="chk_addr_phone" name="phone" class="form-control rounded-3"
                                                               placeholder="300 123 4567"/>
                                                    </div>

                                                    <!-- Comment -->
                                                    <div class="col-12">
                                                        <label for="chk_addr_comment" class="form-label small fw-semibold text-muted">Instrucciones de Entrega</label>
                                                        <textarea id="chk_addr_comment" name="comment" rows="2"
                                                                  class="form-control rounded-3"
                                                                  placeholder="Ej: Dejar en portería si no contesto"></textarea>
                                                    </div>
                                                </div>

                                                <div class="d-flex justify-content-end gap-2 mt-4">
                                                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                                                        Cancelar
                                                    </button>
                                                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">
                                                        <i class="fa fa-check me-1"></i>Guardar y Usar
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Cascading JS for checkout address modal -->
                            <script type="text/javascript">
                                (function() {
                                    var stateSelect = document.getElementById('chk_addr_state');
                                    var citySelect = document.getElementById('chk_addr_city');
                                    var zipInput = document.getElementById('chk_addr_zip');

                                    stateSelect.addEventListener('change', function() {
                                        var stateId = this.value;
                                        citySelect.innerHTML = '&lt;option value=""&gt;Cargando...&lt;/option&gt;';
                                        zipInput.value = '';
                                        if (!stateId) {
                                            citySelect.innerHTML = '&lt;option value=""&gt;— Primero selecciona Departamento —&lt;/option&gt;';
                                            return;
                                        }
                                        fetch('/my/addresses/get_cities', {
                                            method: 'POST',
                                            headers: {'Content-Type': 'application/json'},
                                            body: JSON.stringify({jsonrpc: '2.0', method: 'call', params: {state_id: parseInt(stateId)}})
                                        })
                                        .then(function(r) { return r.json(); })
                                        .then(function(data) {
                                            var cities = data.result || [];
                                            var html = '&lt;option value=""&gt;— Seleccionar Ciudad —&lt;/option&gt;';
                                            cities.forEach(function(c) {
                                                html += '&lt;option value="' + c.id + '" data-zipcode="' + (c.zipcode || '') + '"&gt;' + c.name + '&lt;/option&gt;';
                                            });
                                            citySelect.innerHTML = html;
                                        })
                                        .catch(function() {
                                            citySelect.innerHTML = '&lt;option value=""&gt;Error al cargar ciudades&lt;/option&gt;';
                                        });
                                    });

                                    citySelect.addEventListener('change', function() {
                                        var opt = this.options[this.selectedIndex];
                                        if (opt) {
                                            zipInput.value = opt.getAttribute('data-zipcode') || '';
                                        }
                                    });

                                    window.resetCheckoutAddressModal = function() {
                                        document.getElementById('checkoutAddressForm').reset();
                                        citySelect.innerHTML = '&lt;option value=""&gt;— Primero selecciona Departamento —&lt;/option&gt;';
                                        zipInput.value = '';
                                    };
                                })();
                            </script>

                        </div>

                        <!-- RIGHT COLUMN: ORDER SUMMARY -->
                        <div class="col-12 col-lg-5">
                            <div class="card border-0 shadow-sm guapante-summary-card">
                                <div class="card-header bg-white border-bottom-0 pt-4 px-4 pb-0">
                                    <h5 class="fw-bold">Productos Seleccionados</h5>
                                </div>
                                <div class="card-body p-4">
                                    
                                    <!-- Product List -->
                                    <div class="guapante-mini-cart mb-4">
                                        <t t-foreach="website_sale_order.website_order_line" t-as="line">
                                            <div class="d-flex align-items-center mb-3">
                                                <div class="flex-shrink-0 position-relative">
                                                    <span t-field="line.product_id.image_128" t-options="{'widget': 'image', 'qweb_img_responsive': False, 'class': 'rounded', 'style': 'width: 64px; height: 64px; object-fit: cover;'}"/>
                                                </div>
                                                <div class="flex-grow-1 ms-3">
                                                    <h6 class="mb-1 fw-bold text-dark"><t t-esc="line.name_short"/></h6>
                                                    
                                                    <t t-set="line_disp" t-value="uom_display.get(line.id, {})"/>
                                                    <div class="mb-1">
                                                        <span class="guapante-qty-badge-inline">
                                                            <t t-esc="line_disp.get('qty', '1')"/> <t t-esc="line_disp.get('label', '')"/>
                                                        </span>
                                                    </div>

                                                    <small class="text-muted"><t t-esc="line.product_id.description_sale"/></small>
                                                </div>
                                            </div>
                                        </t>
                                    </div>

                                    <hr class="my-4"/>

                                    <!-- Blue Info Box -->
                                    <div class="guapante-info-note p-3 d-flex gap-3 mb-4" role="alert">
                                        <i class="fa fa-info-circle mt-1"></i>
                                        <div class="small">
                                            <strong>Nota Importante:</strong><br/>
                                            El valor final se confirmará una vez pesemos sus productos y verifiquemos el stock. Recibirá la confirmación total antes del despacho.
                                        </div>
                                    </div>

                                    <!-- Confirm Button — Simple link, no form submission -->
                                    <a href="/shop/checkout/confirm" class="btn btn-success w-100 py-3 fw-bold fs-6 shadow-sm mb-4 text-center" id="guapante_confirm_btn">
                                        <i class="fa fa-paper-plane me-2"></i> Confirmar Pedido
                                    </a>
                                    
                                    <div class="text-center text-muted small">
                                        <i class="fa fa-clock-o me-1"></i> Entrega Flexible
                                    </div>

                                </div>
                            </div>
                            
                            <!-- Freshness Guarantee -->
                            <div class="card border-0 bg-success bg-opacity-10 mt-3">
                                <div class="card-body d-flex align-items-start gap-3">
                                    <i class="fa fa-certificate text-success fs-4 mt-1"></i>
                                    <div>
                                        <h6 class="fw-bold text-success mb-1">Garantía de Frescura</h6>
                                        <p class="small text-muted mb-0">Si no está satisfecho con la calidad de sus productos, le devolvemos su dinero o reemplazamos el producto.</p>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
