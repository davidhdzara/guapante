<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="product_guapante" inherit_id="website_sale.product" name="Guapante Product Page with Sidebar">
        
        <!-- Add custom class to main wrapper -->
        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="class" add="guapante-product-page" separator=" "/>
        </xpath>

        <!-- Inject sidebar wrapper BEFORE the product section -->
        <xpath expr="//section[@id='product_detail']" position="before">
            <div class="container-fluid">
                <div class="row">
                    <!-- LEFT SIDEBAR: Reuse shop sidebar -->
                    <div class="col-lg-3 d-none d-lg-block">
                        <div class="guapante-product-sidebar p-3">
                            <!-- Call the same sidebar template from shop -->
                            <t t-call="website_sale.products_categories_list"/>
                        </div>
                    </div>
                    
                    <!-- RIGHT CONTENT: Wrapper for product -->
                    <div class="col-lg-9">
        </xpath>

        <!-- Close the wrapper AFTER the product section -->
        <xpath expr="//section[@id='product_detail']" position="after">
                    </div> <!-- close col-lg-9 -->
                </div> <!-- close row -->
            </div> <!-- close container-fluid -->
        </xpath>
        
    </template>
</odoo>
