<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="product_guapante_sidebar_layout" inherit_id="website_sale.product" name="Guapante Product Sidebar Layout">
        
        <!-- 
           FASE 4: COMPLIANCE BOOTSTRAP (JS LAYOUT STRATEGY)
           
           1. Inyectamos la estructura contenedora (Sidebar + Columna Vacía) ANTES del section.
           2. El section original queda intacto (limpio de clases row/col).
           3. Un script JS mueve el section dentro de la columna vacía al cargar.
           
           Esto evita:
           - Violar reglas de Bootstrap (mezclar row/col en un section).
           - Usar 'move' de XML que causa Error 500 en este entorno.
        -->

        <!-- 1. Estructura Wrapper Externa -->
        <xpath expr="//section[@id='product_detail']" position="before">
            <div class="container guapante-product-container mt-4">
                <div class="row">
                    <!-- Sidebar: Usamos products_categories nativo (colapsable) -->
                    <aside id="products_grid_before" class="col-lg-3 d-none d-lg-block sticky-top" style="top: 90px; height: fit-content; z-index: 1;">
                        <t t-call="website_sale.products_categories_list"/>
                    </aside>
                    
                    <!-- Columna Destino (JS moverá el contenido aquí) -->
                    <div class="col-12 col-lg-9 guapante-product-content">
                        <!-- Vacio inicialmente -->
                    </div>
                </div>
            </div>
        </xpath>

        <!-- 2. Estilización del Section (Solo agregar clases) -->
        <xpath expr="//section[@id='product_detail']" position="attributes">
            <attribute name="class" add="d-none guapante-card bg-white shadow-sm rounded-4 p-4" separator=" "/>
        </xpath>

        <!-- 4. Refinamientos UI -->
        <xpath expr="//h1[@itemprop='name']" position="before">
             <div class="d-flex align-items-center mb-2">
                 <span class="badge bg-success-light text-success me-2 px-2 py-1 rounded-pill" style="font-size: 0.75rem; background-color: #d1fae5; color: #065f46;">BOYACÁ</span>
                 <span class="text-muted small"><i class="fa fa-clock-o me-1"></i>Entrega: <strong>Mañana</strong></span>
             </div>
        </xpath>

    </template>
</odoo>
