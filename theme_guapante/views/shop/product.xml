<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="product_guapante_sidebar_layout" inherit_id="website_sale.product" name="Guapante Product Sidebar Layout">
        
        <!-- 
           ESTRATEGIA DE CORRECCIÓN (WRAPPER + MOVE):
           El elemento raíz original es <section id="product_detail">.
           Para lograr un layout Grid correcto (Sidebar + Contenido), no debemos modificar las clases del section directamente 
           si eso rompe la estructura interna.
           
           En su lugar, creamos un NUEVO contenedor externo y movemos el section original dentro de la columna derecha.
        -->

        <!-- 1. Insertar el Wrapper (Container + Row + Sidebar + Columna Vacía) ANTES del section original -->
        <xpath expr="//section[@id='product_detail']" position="before">
            <div class="container o_wsale_products_main mt-4">
                <div class="row">
                    <!-- Sidebar: Usamos IDs y Clases estándar de Odoo Shop -->
                    <aside id="products_grid_before" class="col-lg-3 d-none d-lg-block sticky-top" style="top: 90px; height: fit-content; z-index: 1;">
                        <!-- Llamamos al template products_categories_list que sabemos existe -->
                        <t t-call="website_sale.products_categories_list"/>
                    </aside>
                    
                    <!-- Columna Derecha: Destino del contenido -->
                    <div id="guapante_product_content_col" class="col-lg-9">
                        <!-- El contenido original se moverá aquí -->
                    </div>
                </div>
            </div>
        </xpath>

        <!-- 2. Mover el section original DENTRO de la columna derecha -->
        <!-- Usamos un selector relativo porque buscar por ID recién creado puede fallar en ciertos motores XPath si no se re-indexa -->
        <!-- Buscamos el div 'col-9' que acabamos de insertar justo antes de este section -->
        <xpath expr="//section[@id='product_detail']" position="move">
            <xpath expr="preceding-sibling::div[hasclass('container')]/div[hasclass('row')]/div[@id='guapante_product_content_col']" position="inside"/>
        </xpath>

        <!-- 3. Contenido Principal: Aplicar estilo de Tarjeta (.guapante-card) al section movido -->
        <!-- OJO: Como ahora el section está dentro de un col-9, sus clases internas (container) podrían causar doble padding.
             Removemos 'container' y añadimos la clase de tarjeta. -->
        <xpath expr="//section[@id='product_detail']" position="attributes">
            <attribute name="class" remove="container" separator=" "/>
            <attribute name="class" add="guapante-card bg-white shadow-sm rounded-4 p-4" separator=" "/>
        </xpath>

        <!-- 4. Inyectar Texto de Entrega y Ubicación (Refinamiento UI Fase 2) -->
        <xpath expr="//h1[@itemprop='name']" position="before">
             <div class="d-flex align-items-center mb-2">
                 <span class="badge bg-success-light text-success me-2 px-2 py-1 rounded-pill" style="font-size: 0.75rem; background-color: #d1fae5; color: #065f46;">BOYACÁ</span>
                 <span class="text-muted small"><i class="fa fa-clock-o me-1"></i>Entrega: <strong>Mañana</strong></span>
             </div>
        </xpath>

    </template>
</odoo>
