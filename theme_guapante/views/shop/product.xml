<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="product_guapante_sidebar_layout" inherit_id="website_sale.product" name="Guapante Product Sidebar Layout">
        
        <!-- 
           ESTRATEGIA DE CORRECCIÓN (WRAPPER + MOVE):
           El elemento raíz original es <section id="product_detail">.
           Para lograr un layout Grid correcto (Sidebar + Contenido), no debemos modificar las clases del section directamente 
           si eso rompe la estructura interna.
           
           En su lugar, creamos un NUEVO contenedor externo y movemos el section original dentro de la columna derecha.
        -->

        <!-- ESTRATEGIA CSS FLEX/GRID (Compatibilidad Total):
             Al fallar 'move', inyectamos el sidebar como hermano del contenido principal 
             y usamos CSS para controlar el layout visual sin romper el DOM. -->

        <!-- 1. Convertir section principal en Flex Container (.row) -->
        <xpath expr="//section[@id='product_detail']" position="attributes">
            <attribute name="class" add="row guapante-product-layout" separator=" "/>
        </xpath>

        <!-- 2. Forzar Breadcrumbs a ancho completo (col-12) -->
        <!-- Buscamos el primer row (breadcrumbs) -->
        <xpath expr="//section[@id='product_detail']/div[hasclass('row')][1]" position="attributes">
            <attribute name="class" add="col-12" separator=" "/>
        </xpath>

        <!-- 3. Insertar Sidebar ANTES del contenido principal -->
        <xpath expr="//div[@id='product_detail_main']" position="before">
            <aside id="products_grid_before" class="col-lg-3 d-none d-lg-block sticky-top" style="top: 90px; height: fit-content; z-index: 1;">
                <t t-call="website_sale.products_categories_list"/>
            </aside>
        </xpath>

        <!-- 4. Ajustar Contenido Principal (Main Row -> Col-9) -->
        <xpath expr="//div[@id='product_detail_main']" position="attributes">
            <!-- Añadimos 'col-lg-9' para que ocupe el espacio restante junto al sidebar -->
            <attribute name="class" add="col-12 col-lg-9 guapante-card bg-white shadow-sm rounded-4 p-4" separator=" "/>
        </xpath>

        <!-- 4. Inyectar Texto de Entrega y Ubicación (Refinamiento UI Fase 2) -->
        <xpath expr="//h1[@itemprop='name']" position="before">
             <div class="d-flex align-items-center mb-2">
                 <span class="badge bg-success-light text-success me-2 px-2 py-1 rounded-pill" style="font-size: 0.75rem; background-color: #d1fae5; color: #065f46;">BOYACÁ</span>
                 <span class="text-muted small"><i class="fa fa-clock-o me-1"></i>Entrega: <strong>Mañana</strong></span>
             </div>
        </xpath>

    </template>
</odoo>
