<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add sidebar to product page using safer wrapping approach -->
    <template id="product_guapante" inherit_id="website_sale.product" name="Guapante Product with Sidebar">
        
        <!-- Step 1: Add container-fluid class to the main div (parent of product_detail) -->
        <xpath expr="//div[@id='wrap']//main//div[section[@id='product_detail']]" position="attributes">
            <attribute name="class">container-fluid</attribute>
        </xpath>
        
        <!-- Step 2: Convert that div to a row -->
        <xpath expr="//div[@id='wrap']//main//div[section[@id='product_detail']]" position="attributes">
            <attribute name="class" add="row" separator=" "/>
        </xpath>
        
        <!-- Step 3: Add sidebar before the product_detail section -->
        <xpath expr="//section[@id='product_detail']" position="before">
            <aside id="products_grid_before" class="d-none d-lg-block position-sticky col-lg-3 px-3 clearfix">
                <div class="o_wsale_products_grid_before_rail vh-100 ms-n2 mt-n2 pt-2 p-lg-2 pb-lg-5 ps-2 overflow-y-scroll">
                    <!-- Reuse existing categories template -->
                    <t t-call="website_sale.products_categories"/>
                </div>
            </aside>
        </xpath>
        
        <!-- Step 4: Add col-lg-9 class to product_detail section -->
        <xpath expr="//section[@id='product_detail']" position="attributes">
            <attribute name="class" add="col-lg-9" separator=" "/>
        </xpath>
        
    </template>
</odoo>
