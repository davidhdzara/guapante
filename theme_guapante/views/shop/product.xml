<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="product_guapante_sidebar_layout" inherit_id="website_sale.product" name="Guapante Product Sidebar Layout">
        
        <!-- 
           STRATEGY: Inject sidebar AFTER product_detail to avoid breaking Studio XPaths
           JavaScript will reorganize the visual layout
        -->

        <!-- Inject sidebar container RIGHT AFTER product_detail closing tag -->
        <xpath expr="//section[@id='product_detail']" position="after">
            <div id="guapante_sidebar_source" class="d-none">
                <t t-call="website_sale.products_categories_list"/>
            </div>
        </xpath>

        <!-- Unit Selector: Inject AFTER the add to cart button -->
        <xpath expr="//div[@id='product_details']//a[@id='add_to_cart']" position="after">
            <!-- Gray container for unit selector -->
            <div class="guapante-unit-selector-container bg-light rounded-3 p-3 mt-3" 
                 t-att-data-product-id="product.id">
                <!-- Note: conversion factors will be added when backend is ready -->
                <!-- For now, JavaScript will use demo values if needed -->
                
                <label class="form-label text-muted small fw-semibold text-uppercase mb-3 d-flex align-items-center">
                    <i class="fa fa-balance-scale me-2"></i>
                    Unidad de Medida
                </label>
                
                <div class="guapante-unit-selector mb-3">
                    <div class="btn-group w-100" role="group" aria-label="Selector de unidad de medida">
                        <!-- Por defecto mostramos las 3 opciones, backend puede customizar -->
                        <t t-set="unit_options" t-value="['Unidades', 'Peso (Kg)', 'Peso (g)']"/>
                        <t t-set="unit_values" t-value="['unidades', 'kg', 'g']"/>
                        
                        <t t-foreach="unit_options" t-as="unit_label">
                            <t t-set="unit_value" t-value="unit_values[unit_label_index]"/>
                            <input 
                                type="radio" 
                                class="btn-check" 
                                t-att-name="'unit_selector_' + str(product.id)"
                                t-att-id="'unit_' + unit_value + '_' + str(product.id)"
                                t-att-value="unit_value"
                                t-att-checked="'checked' if unit_value == 'unidades' else None"
                                autocomplete="off"
                            />
                            <label 
                                class="btn btn-outline-success" 
                                t-att-for="'unit_' + unit_value + '_' + str(product.id)">
                                <t t-esc="unit_label"/>
                            </label>
                        </t>
                    </div>
                    
                    <!-- Equivalencia dinámica (actualizada por JavaScript) -->
                    <div class="guapante-unit-equivalence text-muted small mt-2" style="display: none;">
                        <span class="equivalence-text"></span>
                    </div>
                </div>
                
                <!-- Quantity selector with +/- buttons -->
                <div class="guapante-quantity-selector mb-3">
                    <div class="input-group">
                        <button class="btn btn-outline-secondary guapante-qty-minus" type="button">
                            <i class="fa fa-minus"></i>
                        </button>
                        <input 
                            type="number" 
                            name="guapante_qty" 
                            class="form-control text-center guapante-qty-input" 
                            value="1" 
                            min="0.01" 
                            step="0.01"
                            aria-label="Cantidad"
                        />
                        <button class="btn btn-outline-secondary guapante-qty-plus" type="button">
                            <i class="fa fa-plus"></i>
                        </button>
                    </div>
                </div>
                
                <!-- Campo oculto para enviar al backend -->
                <input type="hidden" name="product_uom" value="unidades"/>
            </div>
        </xpath>

    </template>
</odoo>
