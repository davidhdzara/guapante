<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="product_guapante_sidebar_layout" inherit_id="website_sale.product" name="Guapante Product Sidebar Layout">
        
        <!-- 
           STRATEGY: Inject sidebar AFTER product_detail to avoid breaking Studio XPaths
           JavaScript will reorganize the visual layout
        -->

        <!-- Inject sidebar container RIGHT AFTER product_detail closing tag -->
        <xpath expr="//section[@id='product_detail']" position="after">
            <div id="guapante_sidebar_source" class="d-none">
                <t t-call="website_sale.products_categories_list"/>
            </div>
        </xpath>

        <!-- Unit Selector: Inject AFTER the add to cart button -->
        <xpath expr="//div[@id='product_details']//a[@id='add_to_cart']" position="after">
            <!-- Gray container for unit selector -->
            <div class="guapante-unit-selector-container bg-light rounded-3 p-3 mt-3" 
                 t-att-data-product-id="product_variant.id"
                 t-att-data-product-tmpl-id="product.id"
                 t-att-data-uom-id="product.uom_id.id"
                 t-att-data-uom-name="product.uom_id.name"
                 t-att-data-uom-category-id="product.uom_id.category_id.id"
                 t-att-data-is-weight-uom="'true' if product.uom_id.category_id.id == request.env.ref('uom.product_uom_categ_kgm', raise_if_not_found=False).sudo().id else 'false'"
                 t-att-data-has-packaging="'true' if product_variant.sudo().packaging_ids.filtered(lambda p: p.sales) else 'false'">
                
                <label class="form-label text-muted small fw-semibold text-uppercase mb-2 d-flex align-items-center">
                    <i class="fa fa-balance-scale me-2"></i>
                    Unidad de Medida
                </label>

                <!-- UoM Mode Selector (Tabs) -->
                <!-- Only visible via JS if is-weight-uom is true -->
                <div class="guapante-uom-mode-selector mb-3 d-none">
                    <div class="btn-group w-100" role="group" aria-label="Modo de venta">
                        <input type="radio" class="btn-check uom-mode-option" name="uom_mode" id="mode_unit" value="unit"/>
                        <label class="btn btn-outline-success" for="mode_unit">Unidades</label>

                        <input type="radio" class="btn-check uom-mode-option" name="uom_mode" id="mode_kg" value="kg" checked="checked"/>
                        <label class="btn btn-outline-success" for="mode_kg">Peso (Kg)</label>

                        <input type="radio" class="btn-check uom-mode-option" name="uom_mode" id="mode_g" value="g"/>
                        <label class="btn btn-outline-success" for="mode_g">Peso (g)</label>
                    </div>
                </div>
                
                <!-- Packaging Selector (Original) - Only visible in Unit Mode -->
                <div class="guapante-unit-selector mb-3 d-none">
                    <div class="btn-group w-100 guapante-packaging-options" role="group" aria-label="Selector de embalaje">
                        <!-- Get packagings for current variant (product_product) with sudo for public access -->
                        <t t-set="packagings" t-value="product_variant.sudo().packaging_ids.filtered(lambda p: p.sales)"/>
                        
                        <t t-if="packagings">
                            <!-- Render packaging options dynamically -->
                            <t t-foreach="packagings" t-as="pkg">
                                <input 
                                    type="radio" 
                                    class="btn-check packaging-option" 
                                    t-att-name="'packaging_selector_' + str(product_variant.id)"
                                    t-att-id="'pkg_' + str(pkg.id) + '_' + str(product_variant.id)"
                                    t-att-value="pkg.id"
                                    t-att-data-packaging-name="pkg.name"
                                    t-att-data-packaging-qty="pkg.qty"
                                    t-att-checked="'checked' if pkg_index == 0 else None"
                                    autocomplete="off"
                                />
                                <label 
                                    class="btn btn-outline-success" 
                                    t-att-for="'pkg_' + str(pkg.id) + '_' + str(product_variant.id)">
                                    <t t-esc="pkg.name"/>
                                </label>
                            </t>
                        </t>
                        <t t-else="">
                            <!-- No packaging: Do not show any radio button, just hidden input default -->
                        </t>
                    </div>
                </div>

                <!-- Info Display -->
                <div class="guapante-mode-info text-center mb-2 text-muted fw-bold small">
                    <!-- JS updates this text -->
                </div>
                
                <!-- Info de cantidad del embalaje (Solo modo unidad) -->
                <div class="guapante-packaging-info text-muted small mt-2 d-none">
                    <span class="packaging-info-text"></span>
                </div>
                
                <!-- Quantity selector with +/- buttons -->
                <div class="guapante-quantity-selector mb-3">
                    <div class="input-group">
                        <button class="btn btn-outline-secondary guapante-qty-minus" type="button">
                            <i class="fa fa-minus"></i>
                        </button>
                        <input 
                            type="text" 
                            name="guapante_qty" 
                            class="form-control text-center guapante-qty-input" 
                            value="1" 
                            inputmode="decimal"
                            aria-label="Cantidad"
                        />
                        <button class="btn btn-outline-secondary guapante-qty-plus" type="button">
                            <i class="fa fa-plus"></i>
                        </button>
                    </div>
                </div>
                
                <!-- Campo oculto para enviar el packaging_id al backend -->
                <input type="hidden" name="product_packaging_id" t-att-value="packagings[0].id if packagings else 0"/>
                
                <!-- Botón Agregar al Pedido (VERDE) -->
                <button type="button" 
                        class="btn btn-success btn-lg w-100 guapante-add-to-cart-btn">
                    <i class="fa fa-shopping-cart me-2"></i>
                    Agregar al Pedido
                </button>
            </div>
        </xpath>

    </template>
</odoo>
