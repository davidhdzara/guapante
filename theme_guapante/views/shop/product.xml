<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 
        Context Provider for Product Page:
        Injects the 'categories' variable so the native Odoo sidebar 
        (website_sale.products_categories) can render correctly.
    -->
    <template id="product_guapante_context" inherit_id="website_sale.product" name="Guapante Product Context">
        <!-- Inject before the main wrapper to ensure variable is available globally in the template -->
        <xpath expr="//div[@id='wrap']" position="before">
            <t t-set="categories" t-value="request.env['product.public.category'].search([('parent_id', '=', False)], order='sequence, name')"/>
        </xpath>
    </template>
</odoo>
