<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_guapante_ux" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.guapante.ux</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Ocultar columnas nativas -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="replace">
                <field name="product_uom_qty" column_invisible="True" invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom']" position="replace">
                <field name="product_uom" column_invisible="True" invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_packaging_qty']" position="replace">
                <field name="product_packaging_qty" column_invisible="True" invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_packaging_id']" position="replace">
                <field name="product_packaging_id" column_invisible="True" invisible="True"/>
            </xpath>
            
            <!-- Inyectar Vistas Visuales -->
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="before">
                <field name="visual_qty" string="Cantidad" />
                <field name="uom_mode" string="Unidad" />
            </xpath>

            <!-- Inyectar Contador de Productos (Inline style) -->
            <xpath expr="//field[@name='tax_totals']" position="before">
                <div colspan="2" class="d-flex justify-content-between text-muted pb-1">
                    <span class="o_form_label o_td_label" style="font-weight: normal;">Productos incluídos</span>
                    <field name="guapante_product_line_count" nolabel="1" readonly="1" class="text-end fw-medium"/>
                </div>
            </xpath>
            <!-- ── Pricelist editable en órdenes confirmadas ──────────
                 Nativo: pricelist_id readonly en state=sale/cancel
                 Nativo: botón "Update Prices" invisible en state=sale/cancel
                 Guapante: permitir ambos en state=sale para que la dueña
                 pueda cambiar la lista y recalcular precios sin cancelar.
                 El Python write() bloquea si hay facturas emitidas. -->
            <xpath expr="//field[@name='pricelist_id'][not(ancestor::field[@name='order_line'])]" position="attributes">
                <attribute name="readonly">state == 'cancel'</attribute>
            </xpath>
            <xpath expr="//button[@name='action_update_prices']" position="attributes">
                <attribute name="invisible">not show_update_pricelist or state == 'cancel'</attribute>
            </xpath>

        </field>
    </record>
</odoo>
