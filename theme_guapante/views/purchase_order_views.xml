<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_guapante_ux" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.guapante.ux</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Ocultar columnas nativas -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']" position="replace">
                <field name="product_qty" column_invisible="True" invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom']" position="replace">
                <field name="product_uom" column_invisible="True" invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_packaging_qty']" position="replace">
                <field name="product_packaging_qty" column_invisible="True" invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_packaging_id']" position="replace">
                <field name="product_packaging_id" column_invisible="True" invisible="True"/>
            </xpath>
            
            <!-- Inyectar Vistas Visuales -->
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="before">
                <field name="visual_qty" string="Cantidad" />
                <field name="uom_mode" string="Unidad" />
            </xpath>

            <!-- Inyectar Contador de Productos -->
            <xpath expr="//field[@name='tax_totals']" position="before">
                <field name="guapante_product_line_count" string="Ctdad. Productos:" readonly="1" decoration-muted="1"/>
            </xpath>
        </field>
    </record>
</odoo>
