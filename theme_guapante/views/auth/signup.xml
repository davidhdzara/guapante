<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="guapante_signup" inherit_id="auth_signup.signup" name="Guapante Signup">
        <!-- 1. Customize the Form Header/Title -->
        <xpath expr="//form" position="before">
            <h2 class="display-6 fw-bold mb-2">Formulario de Registro</h2>
            <p class="text-muted mb-4">Crea tu cuenta como Persona Natural o Empresa.</p>
        </xpath>

        <!-- 2. Customize the Form Content -->
        <xpath expr="//form" position="replace">
            <form class="oe_signup_form" role="form" method="post" t-if="not message">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <!-- TOKEN (if any) -->
                <t t-if="token">
                    <input type="hidden" name="token" t-att-value="token"/>
                </t>

                <!-- ERROR MESSAGE -->
                <div class="alert alert-danger" role="alert" t-if="error">
                    <t t-esc="error"/>
                </div>
                
                <!-- === CLIENT TYPE TOGGLE === -->
                <div class="mb-4">
                    <label class="form-label d-block text-muted small fw-bold text-uppercase mb-2">Tipo de Cliente</label>
                    <div class="d-flex gap-4">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="company_type" id="type_person" value="person" t-att-checked="not company_type or company_type == 'person'"/>
                            <label class="form-check-label fw-bold" for="type_person">Persona Natural</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="company_type" id="type_company" value="company" t-att-checked="company_type == 'company'"/>
                            <label class="form-check-label fw-bold" for="type_company">Empresa</label>
                        </div>
                    </div>
                </div>

                <!-- === FIELDS WRAPPER === -->
                <div class="row">
                    <!-- NAME (Dynamic Label) -->
                    <div class="col-12 mb-3">
                        <label for="name" class="form-label label-name">Nombre Completo</label>
                        <label for="name" class="form-label label-company d-none">Razón Social</label>
                        <input type="text" name="name" t-att-value="name" id="name" class="form-control" placeholder="Ej: María Rodríguez o Empresa SAS" required="required"/>
                    </div>

                    <!-- IDENTIFICATION TYPE (Select) -->
                    <div class="col-12 mb-3">
                        <label for="l10n_latam_identification_type_id" class="form-label">Tipo de Identificación</label>
                        <select name="l10n_latam_identification_type_id" id="l10n_latam_identification_type_id" class="form-select form-control">
                            <option value="">Seleccione una opción...</option>
                            <t t-foreach="identification_types" t-as="type">
                                <option t-att-value="type.id" 
                                        t-att-selected="str(type.id) == str(l10n_latam_identification_type_id)"
                                        t-att-data-name="type.name">
                                    <t t-esc="type.name"/>
                                </option>
                            </t>
                        </select>
                    </div>

                    <!-- IDENTIFICATION NUMBER (NIT/VAT) -->
                    <div class="col-12 mb-3">
                        <label for="vat" class="form-label">Número de Documento</label>
                        <input type="text" name="vat" t-att-value="vat" id="vat" class="form-control" placeholder="Ej: 123456789"/>
                    </div>

                    <!-- EMAIL -->
                    <div class="col-12 mb-3">
                        <label for="login" class="form-label">Correo Electrónico</label>
                        <input type="email" name="login" t-att-value="login" id="login" class="form-control" autofocus="autofocus" required="required" autocapitalize="off"/>
                    </div>

                    <!-- PASSWORD -->
                    <div class="col-12 mb-3">
                        <label for="password" class="form-label">Contraseña</label>
                        <input type="password" name="password" id="password" class="form-control" required="required" autocomplete="current-password" minlength="8"/>
                    </div>

                    <!-- CONFIRM PASSWORD -->
                    <div class="col-12 mb-3">
                        <label for="confirm_password" class="form-label">Confirmar Contraseña</label>
                        <input type="password" name="confirm_password" id="confirm_password" class="form-control" required="required" autocomplete="current-password"/>
                    </div>
                </div>

                <!-- CLOUDFLARE TURNSTILE (anti-bot) -->
                <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async="async" defer="defer"/>
                <div class="cf-turnstile mb-3 d-flex justify-content-center"
                     data-sitekey="0x4AAAAAADLIp7PmT9Qv92pK"
                     data-response-field-name="turnstile_captcha"
                     data-action="signup"
                     data-theme="light"/>

                <!-- SUBMIT -->
                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-primary btn-block fw-bold">Crear Cuenta</button>
                    <div class="mt-3">
                        <span class="small text-muted">¿Ya tiene una cuenta?</span>
                        <a t-attf-href="/web/login?{{ keep_query() }}" class="fw-bold text-success text-decoration-none">Iniciar Sesión</a>
                    </div>
                </div>
            </form>
        </xpath>
    </template>
</odoo>
