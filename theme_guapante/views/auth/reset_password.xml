<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Override: auth_signup.reset_password
         Replaces the entire reset password page content with
         Guapante's custom design matching the mockup.
         ============================================================ -->
    <template id="guapante_reset_password" inherit_id="auth_signup.reset_password" name="Guapante Reset Password">
        <xpath expr="//t[@t-call='web.login_layout']" position="replace">
            <t t-call="web.login_layout">

                <!-- ==========================================
                     STATE 1: Confirmation message after submit
                     ========================================== -->
                <div t-if="message" class="guapante-reset-confirmation text-center py-4">
                    <!-- Green check icon -->
                    <div class="reset-check-icon mx-auto mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                            <polyline points="22 4 12 14.01 9 11.01"/>
                        </svg>
                    </div>

                    <h3 class="fw-bold mb-3" style="font-size: 1.5rem;">Revisa tu correo</h3>

                    <p class="text-muted mb-3">
                        Hemos enviado un enlace de recuperación a
                        <strong t-if="login" t-esc="login" class="text-dark"/><t t-if="not login"><strong>tu correo electrónico</strong></t>.
                        Sigue las instrucciones para crear una nueva contraseña.
                    </p>

                    <!-- Alert with original message (hidden, keep for Odoo compatibility) -->
                    <p class="alert alert-success d-none" role="status">
                        <t t-esc="message"/>
                    </p>

                    <a href="mailto:" class="text-success fw-semibold d-inline-block mb-3 text-decoration-underline" style="font-size: 0.95rem;">
                        Abrir aplicación de correo
                    </a>

                    <p class="text-muted small mb-4">
                        ¿No lo recibiste?
                        <a t-attf-href="/web/reset_password?{{ keep_query() }}" class="fw-bold text-success text-decoration-none">Reenviar</a>
                    </p>

                    <div class="mt-3">
                        <a href="/web/login" class="text-muted text-decoration-none small">
                            ← Volver al inicio de sesión
                        </a>
                    </div>
                </div>

                <!-- ==========================================
                     STATE 2: Reset password form (initial)
                     ========================================== -->
                <form class="oe_reset_password_form" role="form" method="post" t-if="not message">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <!-- ── Case A: Token present → Set new password ── -->
                    <t t-if="token and not invalid_token">
                        <a href="/web/login" class="text-muted text-decoration-none small d-inline-block mb-4">
                            ← Volver al inicio de sesión
                        </a>

                        <h2 class="display-6 fw-bold mb-2" style="font-size: 1.75rem;">Crear nueva contraseña</h2>
                        <p class="text-muted mb-4" style="font-size: 0.95rem;">
                            Tu nueva contraseña debe ser diferente a las utilizadas anteriormente.
                        </p>

                        <!-- Password fields -->
                        <div class="mb-3">
                            <label for="password" class="form-label fw-semibold">Nueva contraseña</label>
                            <div class="position-relative">
                                <input type="password" name="password" id="password"
                                       class="form-control" required="required"
                                       placeholder="••••••••" autofocus="autofocus"
                                       minlength="8"/>
                                <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted pe-3 toggle-password" tabindex="-1">
                                    <i class="fa fa-eye"/>
                                </button>
                            </div>
                            <small class="text-muted mt-1 d-block">
                                <i class="fa fa-info-circle me-1"/>Mínimo 8 caracteres
                            </small>
                        </div>

                        <div class="mb-3">
                            <label for="confirm_password" class="form-label fw-semibold">Confirmar contraseña</label>
                            <div class="position-relative">
                                <input type="password" name="confirm_password" id="confirm_password"
                                       class="form-control" required="required"
                                       placeholder="••••••••"/>
                                <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted pe-3 toggle-password" tabindex="-1">
                                    <i class="fa fa-eye"/>
                                </button>
                            </div>
                        </div>

                        <!-- Hidden fields required by Odoo -->
                        <input type="hidden" name="login" t-att-value="login"/>
                        <input type="hidden" name="name" t-att-value="name"/>
                    </t>

                    <!-- ── Case B: No token → Request reset email ── -->
                    <t t-if="not token">
                        <a href="/web/login" class="text-muted text-decoration-none small d-inline-block mb-4">
                            ← Volver al inicio de sesión
                        </a>

                        <h2 class="display-6 fw-bold mb-2">¿Olvidaste tu contraseña?</h2>
                        <p class="text-muted mb-4" style="font-size: 0.95rem;">
                            No te preocupes, nos pasa a todos. Ingresa tu correo electrónico
                            asociado a tu cuenta y te enviaremos las instrucciones para restablecerla.
                        </p>

                        <div class="mb-3">
                            <label for="login" class="form-label fw-semibold">Correo electrónico</label>
                            <div class="position-relative">
                                <span class="position-absolute top-50 translate-middle-y ps-3 text-muted">
                                    <i class="fa fa-envelope"/>
                                </span>
                                <input type="email" name="login" t-att-value="login" id="login"
                                       class="form-control reset-email-input"
                                       placeholder="nombre@ejemplo.com"
                                       autofocus="autofocus" required="required"
                                       autocapitalize="off"/>
                            </div>
                        </div>
                    </t>

                    <!-- Error message -->
                    <p class="alert alert-danger" t-if="error" role="alert">
                        <t t-esc="error"/>
                    </p>

                    <!-- Hidden fields -->
                    <input type="hidden" name="redirect" t-att-value="redirect"/>
                    <input type="hidden" name="token" t-att-value="token"/>

                    <!-- Submit button -->
                    <div class="d-grid mt-3">
                        <button t-if="not token" type="submit" class="btn btn-primary">
                            Enviar enlace de recuperación
                        </button>
                        <button t-if="token and not invalid_token" type="submit" class="btn btn-primary">
                            Restablecer contraseña
                        </button>
                    </div>

                    <!-- Invalid token message -->
                    <div t-if="invalid_token" class="text-center mt-3">
                        <p class="alert alert-warning" role="alert">
                            El enlace de restablecimiento ha expirado o no es válido. Por favor solicita uno nuevo.
                        </p>
                        <a href="/web/reset_password" class="btn btn-outline-success">
                            Solicitar nuevo enlace
                        </a>
                    </div>

                    <!-- Registration link (only on email request form) -->
                    <div t-if="not token" class="text-center mt-4">
                        <span class="text-muted small">¿No tienes una cuenta?</span>
                        <a t-attf-href="/web/signup?{{ keep_query() }}" class="fw-bold text-success text-decoration-none small">Regístrate aquí</a>
                    </div>

                    <!-- Back to login (only on token/invalid forms) -->
                    <div t-if="invalid_token" class="text-center mt-2">
                        <a href="/web/login" class="text-muted text-decoration-none small">
                            ← Volver al inicio de sesión
                        </a>
                    </div>

                    <div class="o_login_auth"/>
                </form>

            </t>
        </xpath>
    </template>
</odoo>
