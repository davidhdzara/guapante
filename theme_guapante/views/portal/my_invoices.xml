<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_invoices_guapante" inherit_id="account.portal_my_invoices" name="Guapante: My Invoices" priority="99">
        <xpath expr="//t[@t-call='portal.portal_layout']" position="replace">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>

                <!-- Guapante Custom Layout with Sidebar -->
                <t t-call="theme_guapante.guapante_portal_layout">

                    <!-- HEADER -->
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
                        <div>
                            <h2 class="fw-bold text-dark mb-1">Mis Facturas</h2>
                            <p class="text-muted mb-0">Administra tus pagos y descarga tus documentos tributarios.</p>
                        </div>
                    </div>

                    <!-- KPI Cards (Based on Mockup) -->
                    <div class="row g-4 mb-4">
                        <!-- Card 1: Total por Pagar -->
                        <div class="col-12 col-md-4">
                            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
                                <div class="card-body p-4 d-flex flex-column justify-content-between">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <small class="text-muted" style="font-size: 0.85rem; color: #6c757d !important;">Total por Pagar</small>
                                        <div class="rounded d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; background-color: #eaf7ec;">
                                            <i class="fa fa-money" style="color: #4caf50; font-size: 1.1rem;"></i>
                                        </div>
                                    </div>
                                    <div>
                                        <h3 class="fw-bold mb-1" style="color: #4caf50; font-size: 1.8rem;">
                                            <span t-esc="total_por_pagar" t-options='{"widget": "monetary", "display_currency": request.env.company.currency_id}'/>
                                        </h3>
                                        <small class="text-muted" style="font-size: 0.8rem; color: #adb5bd !important;"><t t-esc="unpaid_count or 0"/> facturas pendientes de pago</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Card 2: Facturas del Mes -->
                        <div class="col-12 col-md-4">
                            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
                                <div class="card-body p-4 d-flex flex-column justify-content-between">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <small class="text-muted" style="font-size: 0.85rem; color: #6c757d !important;">Facturas del Mes</small>
                                        <div class="rounded d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; background-color: #e9f2ff;">
                                            <i class="fa fa-calendar-o" style="color: #3b82f6; font-size: 1.1rem;"></i>
                                        </div>
                                    </div>
                                    <div>
                                        <h3 class="fw-bold text-dark mb-1" style="font-size: 1.8rem; color: #1e293b !important;">
                                            <t t-esc="facturas_mes"/>
                                        </h3>
                                        <small class="text-muted" style="font-size: 0.8rem; color: #adb5bd !important;"><t t-esc="facturas_mes_str or 'Emisiones de este mes'"/></small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Card 3: Último Pago -->
                        <div class="col-12 col-md-4">
                            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
                                <div class="card-body p-4 d-flex flex-column justify-content-between">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <small class="text-muted" style="font-size: 0.85rem; color: #6c757d !important;">Último Pago</small>
                                        <div class="rounded d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; background-color: #f5eaff;">
                                            <i class="fa fa-check-circle-o" style="color: #a855f7; font-size: 1.1rem;"></i>
                                        </div>
                                    </div>
                                    <div>
                                        <h3 class="fw-bold text-dark mb-1" style="font-size: 1.8rem; color: #1e293b !important;">
                                            <t t-if="last_payment_amount">
                                                <span t-esc="last_payment_amount" t-options='{"widget": "monetary", "display_currency": request.env.company.currency_id}'/>
                                            </t>
                                            <t t-else="">
                                                --
                                            </t>
                                        </h3>
                                        <small class="text-muted" style="font-size: 0.8rem; color: #adb5bd !important;">
                                            <t t-if="last_payment_date">Realizado el <span t-esc="last_payment_date" t-options='{"widget": "date", "format": "dd MMM, YYYY"}'/></t>
                                            <t t-else="">Sin pagos registrados</t>
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- FILTERS TOOLBAR (Unified block) -->
                    <form action="/my/invoices" method="get" class="d-flex flex-column flex-xl-row align-items-xl-center bg-white p-2 mb-4 shadow-sm" style="border-radius: 12px; border: 1px solid #f1f3f5;">
                        <!-- Hidden fields to preserve other filters when submitting -->
                        <input type="hidden" name="sortby" t-att-value="sortby"/>
                        <input type="hidden" name="filterby" t-att-value="filterby"/>
                        <input type="hidden" name="date_filter" t-att-value="date_filter"/>
                        
                        <!-- Search Form -->
                        <div class="position-relative flex-grow-1" style="min-width: 200px;">
                            <i class="fa fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                            <input type="text" name="search" t-att-value="search" class="form-control border-0 bg-light rounded-pill ps-5 w-100" placeholder="Buscar por factura #" style="height: 40px; font-size: 0.9rem;"/>
                        </div>

                        <div class="d-flex flex-wrap align-items-center flex-grow-1 justify-content-xl-end mt-3 mt-xl-0 ms-xl-2 gap-2">
                            <!-- Status Filter -->
                            <div class="dropdown border-end pe-2" t-if="searchbar_filters">
                                <button class="btn btn-white dropdown-toggle border-0 text-dark d-flex align-items-center justify-content-between h-100 w-100" type="button" data-bs-toggle="dropdown" style="height: 40px !important; font-size: 0.9rem;">
                                    <span t-esc="searchbar_filters.get(filterby, {}).get('label', 'Todos los estados')"/>
                                </button>
                                <ul class="dropdown-menu border-0 shadow rounded-3 mt-1">
                                    <t t-foreach="searchbar_filters" t-as="option">
                                        <li>
                                            <a t-attf-href="/my/invoices?filterby=#{option}&amp;sortby=#{sortby}&amp;date_filter=#{date_filter}&amp;search=#{search or ''}"
                                               t-att-class="'dropdown-item py-2 px-3' + (' active bg-success text-white' if filterby == option else '')">
                                                <span t-esc="searchbar_filters[option].get('label')"/>
                                            </a>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                            
                            <!-- Date Range Filter -->
                            <div class="dropdown border-end px-2" t-if="date_range_filters">
                                <button class="btn btn-white dropdown-toggle border-0 text-dark d-flex align-items-center justify-content-between h-100 w-100" type="button" data-bs-toggle="dropdown" style="height: 40px !important; font-size: 0.9rem;">
                                    <i class="fa fa-calendar-o me-1 text-muted"></i> 
                                    <span t-esc="date_range_filters.get(date_filter, {}).get('label', 'Todo el tiempo')"/>
                                </button>
                                <ul class="dropdown-menu border-0 shadow rounded-3 mt-1">
                                    <t t-foreach="date_range_filters" t-as="option">
                                        <li>
                                            <a t-attf-href="/my/invoices?filterby=#{filterby}&amp;sortby=#{sortby}&amp;date_filter=#{option}&amp;search=#{search or ''}"
                                               t-att-class="'dropdown-item py-2 px-3' + (' active bg-success text-white' if date_filter == option else '')">
                                                <span t-esc="date_range_filters[option].get('label')"/>
                                            </a>
                                        </li>
                                    </t>
                                </ul>
                            </div>

                            <!-- Sort Filter -->
                            <div class="dropdown px-2" t-if="searchbar_sortings">
                                <button class="btn btn-white dropdown-toggle border-0 text-dark d-flex align-items-center justify-content-between h-100 w-100" type="button" data-bs-toggle="dropdown" style="height: 40px !important; font-size: 0.9rem;">
                                    <i class="fa fa-sort me-1 text-muted"></i> <span t-esc="searchbar_sortings.get(sortby, {}).get('label', 'Ordenar')"/>
                                </button>
                                <ul class="dropdown-menu border-0 shadow rounded-3 mt-1">
                                    <t t-foreach="searchbar_sortings" t-as="option">
                                        <li>
                                            <a t-attf-href="/my/invoices?sortby=#{option}&amp;filterby=#{filterby}&amp;date_filter=#{date_filter}&amp;search=#{search or ''}"
                                                t-att-class="'dropdown-item py-2 px-3' + (' active bg-success text-white' if sortby == option else '')">
                                                <span t-esc="searchbar_sortings[option].get('label')"/>
                                            </a>
                                        </li>
                                    </t>
                                </ul>
                            </div>

                            <!-- Filter Button -->
                            <button type="submit" class="btn text-white px-4 fw-bold" style="background-color: #4caf50; height: 40px; border-radius: 8px; font-size: 0.9rem;">
                                Buscar
                            </button>
                        </div>
                    </form>

                    <!-- INVOICES TABLE -->
                    <t t-if="invoices">
                        <div class="card border-0 shadow-sm overflow-hidden bg-white mb-4" style="border-radius: 12px; border: 1px solid #f1f3f5 !important;">
                            <div class="table-responsive">
                                <table class="table align-middle mb-0" style="min-width: 800px;">
                                    <thead class="bg-white">
                                        <tr style="border-bottom: 2px solid #f1f3f5;">
                                            <th class="py-3 ps-4 border-0 text-muted" style="font-size: 0.75rem; letter-spacing: 0.5px; font-weight: 600;">FACTURA #</th>
                                            <th class="py-3 border-0 text-muted" style="font-size: 0.75rem; letter-spacing: 0.5px; font-weight: 600;">EMISIÓN</th>
                                            <th class="py-3 border-0 text-muted" style="font-size: 0.75rem; letter-spacing: 0.5px; font-weight: 600;">VENCIMIENTO</th>
                                            <th class="py-3 border-0 text-muted" style="font-size: 0.75rem; letter-spacing: 0.5px; font-weight: 600;">MONTO</th>
                                            <th class="py-3 border-0 text-center text-muted" style="font-size: 0.75rem; letter-spacing: 0.5px; font-weight: 600;">ESTADO</th>
                                            <th class="py-3 pe-4 border-0 text-end text-muted" style="font-size: 0.75rem; letter-spacing: 0.5px; font-weight: 600;">ACCIONES</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="invoices" t-as="invoice">
                                            <tr style="border-bottom: 1px solid #f8f9fa;">
                                                <!-- Factura # -->
                                                <td class="ps-4 fw-bold text-dark py-4" style="font-size: 0.9rem;">
                                                    <a t-attf-href="/my/invoices/#{invoice.id}" class="text-decoration-none text-dark">
                                                        <t t-esc="invoice.name if invoice.name != '/' else 'Borrador'"/>
                                                    </a>
                                                </td>
                                                
                                                <!-- Emisión -->
                                                <td class="text-muted py-4" style="font-size: 0.9rem;">
                                                    <span t-field="invoice.invoice_date" t-options='{"widget": "date", "format": "dd MMM, yyyy"}'/>
                                                </td>
                                                
                                                <!-- Vencimiento -->
                                                <td class="py-4" style="font-size: 0.9rem;">
                                                    <div class="text-dark fw-medium">
                                                        <span t-field="invoice.invoice_date_due" t-options='{"widget": "date", "format": "dd MMM, yyyy"}'/>
                                                    </div>
                                                    <t t-if="invoice.payment_state not in ('paid', 'in_payment') and invoice.state != 'cancel' and invoice.invoice_date_due">
                                                        <t t-set="days_due" t-value="(invoice.invoice_date_due - today_date).days"/>
                                                        <t t-if="days_due &lt; 0">
                                                            <div class="mt-1"><span class="badge" style="background-color: #fce8e6; color: #d93025; font-size: 0.7rem; border-radius: 4px; padding: 0.2rem 0.4rem;">Vencida hace <t t-esc="abs(days_due)"/> días</span></div>
                                                        </t>
                                                        <t t-elif="days_due == 0">
                                                            <div class="mt-1"><span class="badge" style="background-color: #fef7e0; color: #b06000; font-size: 0.7rem; border-radius: 4px; padding: 0.2rem 0.4rem;">Vence hoy</span></div>
                                                        </t>
                                                        <t t-elif="days_due &lt;= 5">
                                                            <div class="mt-1"><span class="badge" style="background-color: #fef7e0; color: #b06000; font-size: 0.7rem; border-radius: 4px; padding: 0.2rem 0.4rem;">Vence en <t t-esc="days_due"/> días</span></div>
                                                        </t>
                                                    </t>
                                                </td>
                                                
                                                <!-- Monto -->
                                                <td class="fw-bold text-dark py-4" style="font-size: 0.9rem;">
                                                    <span t-field="invoice.amount_total" t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/>
                                                </td>
                                                
                                                <!-- Estado -->
                                                <td class="text-center py-4">
                                                    <t t-if="invoice.state == 'cancel'">
                                                        <span class="badge d-inline-flex align-items-center gap-1" style="background-color: #f1f3f5; color: #6c757d; font-size: 0.75rem; font-weight: 600; padding: 0.35rem 0.65rem; border-radius: 6px;">
                                                            <span style="width: 6px; height: 6px; border-radius: 50%; background-color: #adb5bd;"></span>Cancelada
                                                        </span>
                                                    </t>
                                                    <t t-elif="invoice.payment_state in ('paid', 'in_payment')">
                                                        <span class="badge d-inline-flex align-items-center gap-1" style="background-color: #e6f4ea; color: #1e8e3e; font-size: 0.75rem; font-weight: 600; padding: 0.35rem 0.65rem; border-radius: 6px;">
                                                            <span style="width: 6px; height: 6px; border-radius: 50%; background-color: #34a853; box-shadow: 0 0 4px #34a853;"></span>Pagada
                                                        </span>
                                                    </t>
                                                    <t t-elif="invoice.payment_state == 'not_paid' and invoice.invoice_date_due and invoice.invoice_date_due &lt; today_date">
                                                        <span class="badge d-inline-flex align-items-center gap-1" style="background-color: #fce8e6; color: #d93025; font-size: 0.75rem; font-weight: 600; padding: 0.35rem 0.65rem; border-radius: 6px;">
                                                            <span style="width: 6px; height: 6px; border-radius: 50%; background-color: #ea4335; box-shadow: 0 0 4px #ea4335;"></span>Vencida
                                                        </span>
                                                    </t>
                                                    <t t-elif="invoice.payment_state == 'not_paid'">
                                                        <span class="badge d-inline-flex align-items-center gap-1" style="background-color: #fef7e0; color: #b06000; font-size: 0.75rem; font-weight: 600; padding: 0.35rem 0.65rem; border-radius: 6px;">
                                                            <span style="width: 6px; height: 6px; border-radius: 50%; background-color: #fbbc04; box-shadow: 0 0 4px #fbbc04;"></span>Pendiente
                                                        </span>
                                                    </t>
                                                    <t t-elif="invoice.payment_state == 'partial'">
                                                        <span class="badge d-inline-flex align-items-center gap-1" style="background-color: #fff3cd; color: #664d03; font-size: 0.75rem; font-weight: 600; padding: 0.35rem 0.65rem; border-radius: 6px;">
                                                            <span style="width: 6px; height: 6px; border-radius: 50%; background-color: #ffc107; box-shadow: 0 0 4px #ffc107;"></span>Abonada
                                                        </span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="badge d-inline-flex align-items-center gap-1" style="background-color: #f1f3f5; color: #495057; font-size: 0.75rem; font-weight: 600; padding: 0.35rem 0.65rem; border-radius: 6px;">
                                                            <span style="width: 6px; height: 6px; border-radius: 50%; background-color: #6c757d;"></span><t t-esc="invoice.payment_state"/>
                                                        </span>
                                                    </t>
                                                </td>
                                                
                                                <!-- Acciones -->
                                                <td class="pe-4 py-4 text-end d-flex justify-content-end align-items-center gap-3 border-0">
                                                    <a t-attf-href="/my/invoices/#{invoice.id}?report_type=pdf&amp;download=true" class="text-secondary text-decoration-none" title="Descargar PDF">
                                                        <i class="fa fa-file-pdf-o" style="font-size: 1.1rem; opacity: 0.6;"></i>
                                                    </a>
                                                    <a t-attf-href="/my/invoices/#{invoice.id}" class="text-secondary text-decoration-none" title="Código XML / Ver Detalles">
                                                        <span style="font-family: monospace; font-weight: bold; opacity: 0.6;">{}</span>
                                                    </a>
                                                    <!-- Pago / Saldado Oculto Temporalmente -->
                                                    <t t-if="False">
                                                        <t t-if="invoice.payment_state in ('paid', 'in_payment')">
                                                            <button disabled="1" class="btn btn-light btn-sm fw-bold px-3 text-muted" style="border-radius: 6px; font-size: 0.8rem;">Saldada</button>
                                                        </t>
                                                        <t t-else="">
                                                            <a t-attf-href="/my/invoices/#{invoice.id}" class="btn text-white btn-sm fw-bold px-3 shadow-sm" style="background-color: #4caf50; border-radius: 6px; font-size: 0.8rem;">Pagar</a>
                                                        </t>
                                                    </t>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <!-- Pager Footer -->
                            <div t-if="pager" class="bg-white py-3 d-flex justify-content-between align-items-center px-4" style="border-top: 1px solid #f1f3f5;">
                                <span class="text-muted" style="font-size: 0.85rem;">
                                    Mostrando <t t-esc="page_start_num"/>-<t t-esc="page_end_num"/> de <t t-esc="invoice_count"/> facturas
                                </span>
                                <t t-call="portal.pager"/>
                            </div>
                        </div>
                    </t>

                    <!-- Empty State -->
                    <t t-else="">
                        <div class="card border-0 shadow-sm text-center p-5 rounded-4">
                            <div class="mb-3">
                                <i class="fa fa-file-text-o fa-3x text-muted opacity-50"></i>
                            </div>
                            <h5 class="fw-bold text-dark">No tienes facturas de venta registradas</h5>
                            <p class="text-muted mb-4">Cuando realices compras e introduzcamos tus facturas al sistema, aparecerán aquí.</p>
                            <a href="/shop" class="btn btn-success rounded-pill px-4 fw-bold">Ir a la tienda</a>
                        </div>
                    </t>

                </t>
            </t>
        </xpath>
    </template>
</odoo>
