<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_orders_guapante" inherit_id="sale.portal_my_orders" name="Guapante: My Orders" priority="99">
        <xpath expr="//t[@t-call='portal.portal_layout']" position="replace">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>

                <!-- Guapante Custom Layout with Sidebar -->
                <t t-call="theme_guapante.guapante_portal_layout">

                    <!-- HEADER -->
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
                        <div>
                            <h2 class="fw-bold text-dark mb-1">Historial de Pedidos</h2>
                            <p class="text-muted mb-0">Consulta, rastrea y repite tus pedidos anteriores.</p>
                        </div>
                    </div>

                    <!-- KPI Cards -->
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body d-flex align-items-center p-4">
                                    <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                                        <i class="fa fa-shopping-bag text-secondary"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Total Pedidos</small>
                                        <h3 class="fw-bold mb-0"><t t-esc="total_orders_count or 0"/></h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body d-flex align-items-center p-4">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; background: rgba(25,135,84,0.1);">
                                        <i class="fa fa-truck text-success"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Envíos Activos</small>
                                        <h3 class="fw-bold mb-0"><t t-esc="active_shipments_count or 0"/></h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- FILTERS TOOLBAR -->
                    <div class="d-flex flex-column flex-md-row align-items-center mb-4 gap-3 bg-white p-3 rounded-3 shadow-sm border">

                        <!-- Filter 1: Date Range -->
                        <div class="dropdown" t-if="date_range_filters">
                            <button class="btn btn-outline-secondary dropdown-toggle fw-semibold d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" style="min-width: 190px;">
                                <i class="fa fa-calendar-o"></i>
                                <span t-esc="date_range_filters.get(date_filter, {}).get('label', 'Todo el tiempo')"/>
                            </button>
                            <ul class="dropdown-menu border-0 shadow">
                                <t t-foreach="date_range_filters" t-as="df">
                                    <li>
                                        <a t-attf-href="/my/orders?filterby=#{filterby}&amp;date_filter=#{df}"
                                           t-att-class="'dropdown-item' + (' active' if date_filter == df else '')">
                                            <span t-esc="date_range_filters[df].get('label')"/>
                                        </a>
                                    </li>
                                </t>
                            </ul>
                        </div>

                        <!-- Filter 2: Status -->
                        <div class="dropdown" t-if="searchbar_filters">
                            <button class="btn btn-outline-secondary dropdown-toggle fw-semibold d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" style="min-width: 190px;">
                                <i class="fa fa-filter"></i>
                                <span t-esc="searchbar_filters.get(filterby, {}).get('label', 'Todos')"/>
                            </button>
                            <ul class="dropdown-menu border-0 shadow">
                                <t t-foreach="searchbar_filters" t-as="option">
                                    <li>
                                        <a t-attf-href="/my/orders?filterby=#{option}&amp;date_filter=#{date_filter}"
                                           t-att-class="'dropdown-item' + (' active' if filterby == option else '')">
                                            <span t-esc="searchbar_filters[option].get('label')"/>
                                        </a>
                                    </li>
                                </t>
                            </ul>
                        </div>

                        <!-- Clear Filters -->
                        <div class="ms-md-auto">
                            <a href="/my/orders" class="text-decoration-none text-success small fw-bold">
                                <i class="fa fa-times-circle me-1"></i> Limpiar filtros
                            </a>
                        </div>
                    </div>

                    <!-- ORDERS TABLE -->
                    <t t-if="orders">
                        <div class="card border-0 shadow-sm overflow-hidden">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="bg-light text-muted small text-uppercase">
                                        <tr>
                                            <th class="py-3 ps-4 border-0">ID Pedido</th>
                                            <th class="py-3 border-0">Fecha</th>
                                            <th class="py-3 border-0">Estado</th>
                                            <th class="py-3 border-0">Total</th>
                                            <th class="py-3 border-0">Productos</th>
                                            <th class="py-3 pe-4 border-0 text-end">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="orders" t-as="order">
                                            <tr>
                                                <td class="ps-4 fw-bold text-dark">
                                                    <a t-att-href="order.get_portal_url()" class="text-decoration-none text-dark">
                                                        <t t-esc="order.name"/>
                                                    </a>
                                                </td>
                                                <td class="text-muted">
                                                    <span t-field="order.date_order" t-options='{"widget": "date"}'/>
                                                </td>
                                                <td>
                                                    <t t-if="order.state == 'cancel'">
                                                        <span class="badge rounded-pill px-3 py-2 fw-normal" style="background: rgba(220,53,69,0.1); color: #dc3545;">
                                                            <i class="fa fa-times me-1"></i>Cancelado
                                                        </span>
                                                    </t>
                                                    <t t-elif="order.guapante_delivery_status == 'delivered'">
                                                        <span class="badge rounded-pill px-3 py-2 fw-normal" style="background: rgba(25,135,84,0.1); color: #198754;">
                                                            <i class="fa fa-check me-1"></i>Entregado
                                                        </span>
                                                    </t>
                                                    <t t-elif="order.guapante_delivery_status == 'shipping'">
                                                        <span class="badge rounded-pill px-3 py-2 fw-normal" style="background: rgba(13,110,253,0.1); color: #0d6efd;">
                                                            <i class="fa fa-truck me-1"></i>En Camino
                                                        </span>
                                                    </t>
                                                    <t t-elif="order.guapante_delivery_status == 'preparing'">
                                                        <span class="badge rounded-pill px-3 py-2 fw-normal" style="background: rgba(255,193,7,0.15); color: #cc9a06;">
                                                            <i class="fa fa-clock-o me-1"></i>Preparando
                                                        </span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="badge rounded-pill px-3 py-2 fw-normal" style="background: rgba(108,117,125,0.1); color: #6c757d;">
                                                            Recibido
                                                        </span>
                                                    </t>
                                                </td>
                                                <td class="fw-bold">
                                                    <span t-field="order.amount_total" t-options='{"widget": "monetary", "display_currency": order.currency_id}'/>
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <t t-foreach="order.order_line[:3]" t-as="line">
                                                            <img t-att-src="image_data_uri(line.product_id.image_128)"
                                                                 class="rounded-circle border border-2 border-white shadow-sm"
                                                                 t-attf-style="width: 32px; height: 32px; object-fit: cover; margin-right: -8px; position: relative; z-index: #{10 - line_index};"
                                                                 t-att-alt="line.product_id.name"/>
                                                        </t>
                                                        <t t-if="len(order.order_line) > 3">
                                                            <span class="rounded-circle bg-light border border-2 border-white shadow-sm d-flex align-items-center justify-content-center fw-bold text-muted"
                                                                  style="width: 32px; height: 32px; font-size: 0.65rem; position: relative; z-index: 0;">
                                                                +<t t-esc="len(order.order_line) - 3"/>
                                                            </span>
                                                        </t>
                                                        <span t-if="not order.order_line" class="text-muted small fst-italic">Sin productos</span>
                                                    </div>
                                                </td>
                                                <td class="pe-4 text-end">
                                                    <div class="d-flex justify-content-end gap-2">
                                                        <t t-if="order.state != 'cancel' and order.guapante_delivery_status == 'delivered'">
                                                            <a t-attf-href="/my/orders/reorder/#{order.id}" class="btn btn-success btn-sm rounded-pill fw-bold text-white px-3">
                                                                <i class="fa fa-refresh me-1"></i> Volver a pedir
                                                            </a>
                                                        </t>
                                                        <t t-elif="order.state != 'cancel'">
                                                            <a t-att-href="order.get_portal_url()" class="btn btn-outline-dark btn-sm rounded-pill fw-bold px-3">
                                                                <i class="fa fa-truck me-1"></i> Rastrear
                                                            </a>
                                                        </t>
                                                        <t t-else="">
                                                            <a t-att-href="order.get_portal_url()" class="btn btn-link btn-sm text-muted text-decoration-none">
                                                                Ver detalles
                                                            </a>
                                                        </t>
                                                    </div>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <!-- Pager -->
                            <div t-if="pager" class="card-footer bg-white py-3 d-flex justify-content-between align-items-center px-4">
                                <span class="text-muted small">
                                    Mostrando <b t-esc="pager.get('page_start', 1)"/> a <b t-esc="pager.get('page_end', 0)"/> de <b t-esc="pager.get('total', 0)"/> resultados
                                </span>
                                <t t-call="portal.pager"/>
                            </div>
                        </div>
                    </t>

                    <!-- Empty State -->
                    <t t-else="">
                        <div class="card border-0 shadow-sm text-center p-5">
                            <div class="mb-3">
                                <i class="fa fa-shopping-bag fa-3x text-muted opacity-50"></i>
                            </div>
                            <h5 class="fw-bold text-dark">No tienes pedidos aún</h5>
                            <p class="text-muted mb-4">¡Explora nuestra tienda y realiza tu primer pedido!</p>
                            <a href="/shop" class="btn btn-success rounded-pill px-4 fw-bold">Ir a la tienda</a>
                        </div>
                    </t>

                    <!-- HELP BANNER -->
                    <div class="guapante-help-banner mt-4 rounded-4 p-4 d-flex flex-column flex-md-row align-items-center justify-content-between" style="background: #1a1a2e; color: white;">
                        <div class="mb-3 mb-md-0">
                            <h5 class="fw-bold mb-1" style="color: white;">¿Necesitas ayuda con tu pedido?</h5>
                            <p class="mb-0 opacity-75" style="font-size: 0.9rem;">Nuestro equipo de logística está disponible para resolver cualquier duda sobre tus entregas activas.</p>
                        </div>
                        <a href="/contactus" class="btn btn-success rounded-pill px-4 fw-bold d-flex align-items-center gap-2 flex-shrink-0">
                            <i class="fa fa-headphones"></i> Contactar Soporte
                        </a>
                    </div>

                </t>
            </t>
        </xpath>
    </template>
</odoo>
