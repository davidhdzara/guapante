<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_layout_guapante" inherit_id="portal.portal_layout" name="Guapante Portal Layout">
        
        <!-- Disable standard Breadcrumbs if we want full custom look, or keep them? 
             Design doesn't show breadcrumbs, shows a title "Historial de Pedidos".
             We'll hide the standard portal breadcrumbs for a cleaner look or style them.
             For now, let's keep them but wrap everything in our container.
        -->

        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="o_portal_wrap bg-light">
                <div class="container py-4 py-lg-5">
                    <div class="row g-4">
                        
                        <!-- SIDEBAR -->
                        <div class="col-12 col-lg-3">
                            <div class="guapante-portal-sidebar bg-white rounded-4 shadow-sm p-4 sticky-top" style="top: 100px; z-index: 900;">
                                <!-- User Profile -->
                                <div class="text-center mb-4">
                                    <div class="position-relative d-inline-block mb-3">
                                        <img t-att-src="image_data_uri(user_id.partner_id.avatar_128)" 
                                             class="rounded-circle object-fit-cover shadow-sm" 
                                             style="width: 80px; height: 80px;" 
                                             alt="User Avatar"/>
                                        <a href="/my/account" class="btn btn-sm btn-circle btn-light position-absolute bottom-0 end-0 border shadow-sm" title="Editar Perfil">
                                            <i class="fa fa-pencil text-muted small"></i>
                                        </a>
                                    </div>
                                    <h6 class="fw-bold mb-0 text-truncate"><t t-esc="user_id.name"/></h6>
                                    <small class="text-muted d-block text-truncate"><t t-esc="user_id.email"/></small>
                                </div>

                                <!-- Navigation -->
                                <div class="list-group list-group-flush gap-2">
                                    <a href="/my/home" t-attf-class="list-group-item list-group-item-action border-0 rounded-3 px-3 py-2 d-flex align-items-center gap-3 #{'active fw-bold' if page_name == 'home' else 'text-muted'}">
                                        <i class="fa fa-user opacity-75 fs-6" style="width: 20px;"></i> Mi Perfil
                                    </a>
                                    <a href="/my/orders" t-attf-class="list-group-item list-group-item-action border-0 rounded-3 px-3 py-2 d-flex align-items-center gap-3 #{'active fw-bold' if page_name == 'order' else 'text-muted'}">
                                        <i class="fa fa-shopping-bag opacity-75 fs-6" style="width: 20px;"></i> Mis Pedidos
                                    </a>
                                    <a href="/my/addresses" t-attf-class="list-group-item list-group-item-action border-0 rounded-3 px-3 py-2 d-flex align-items-center gap-3 #{'active fw-bold' if page_name == 'address' else 'text-muted'}">
                                        <i class="fa fa-map-marker opacity-75 fs-6" style="width: 20px;"></i> Direcciones
                                    </a>
                                    <a href="/contactus" class="list-group-item list-group-item-action border-0 rounded-3 px-3 py-2 d-flex align-items-center gap-3 text-muted">
                                        <i class="fa fa-question-circle opacity-75 fs-6" style="width: 20px;"></i> Soporte
                                    </a>
                                </div>

                                <hr class="my-3 opacity-25"/>

                                <a href="/web/session/logout?redirect=/" class="d-flex align-items-center gap-3 px-3 py-2 text-decoration-none text-danger opacity-75 hover-opacity-100 transition-base">
                                    <i class="fa fa-sign-out fs-6" style="width: 20px;"></i> <span>Cerrar Sesión</span>
                                </a>
                            </div>
                        </div>

                        <!-- CONTENT CONTENT -->
                        <div class="col-12 col-lg-9">
                            <!-- Injected Content -->
                            <t t-out="0"/>
                        </div>

                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
