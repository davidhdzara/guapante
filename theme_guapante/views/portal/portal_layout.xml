<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Standalone callable layout for Guapante portal pages with sidebar -->
    <template id="guapante_portal_layout" name="Guapante Portal Layout (Sidebar)">
        <div class="container-fluid px-0">
            <div class="row g-0 align-items-stretch">

                <!-- SIDEBAR — full height with right border -->
                <div class="col-12 col-lg-3 col-xl-3">
                    <div class="guapante-portal-sidebar bg-white p-4 pt-5">
                        <!-- User Profile -->
                        <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                            <img t-att-src="image_data_uri(request.env.user.partner_id.avatar_128)"
                                 class="rounded-circle object-fit-cover shadow-sm flex-shrink-0"
                                 style="width: 48px; height: 48px;"
                                 alt="User Avatar"/>
                            <div class="overflow-hidden">
                                <h6 class="fw-bold mb-0 text-truncate" style="font-size: 0.9rem;"><t t-esc="request.env.user.name"/></h6>
                            </div>
                        </div>

                        <!-- Navigation -->
                        <div class="list-group list-group-flush gap-1">
                            <a href="/my/home" t-attf-class="list-group-item list-group-item-action border-0 rounded-3 px-3 py-2 d-flex align-items-center gap-3 #{'active fw-bold' if page_name == 'home' else 'text-muted'}">
                                <i class="fa fa-user opacity-75" style="width: 18px;"></i> Mi Perfil
                            </a>
                            <a href="/my/orders" t-attf-class="list-group-item list-group-item-action border-0 rounded-3 px-3 py-2 d-flex align-items-center gap-3 #{'active fw-bold' if page_name == 'order' else 'text-muted'}">
                                <i class="fa fa-shopping-bag opacity-75" style="width: 18px;"></i> Mis Pedidos
                            </a>
                            <a href="/my/account" t-attf-class="list-group-item list-group-item-action border-0 rounded-3 px-3 py-2 d-flex align-items-center gap-3 #{'active fw-bold' if page_name == 'details' else 'text-muted'}">
                                <i class="fa fa-map-marker opacity-75" style="width: 18px;"></i> Direcciones
                            </a>
                            <a href="/contactus" class="list-group-item list-group-item-action border-0 rounded-3 px-3 py-2 d-flex align-items-center gap-3 text-muted">
                                <i class="fa fa-question-circle opacity-75" style="width: 18px;"></i> Soporte
                            </a>
                        </div>

                        <hr class="my-3 opacity-25"/>

                        <a href="/web/session/logout?redirect=/" class="d-flex align-items-center gap-3 px-3 py-2 text-decoration-none text-danger opacity-75">
                            <i class="fa fa-sign-out" style="width: 18px;"></i> <span>Cerrar Sesión</span>
                        </a>
                    </div>
                </div>

                <!-- MAIN CONTENT -->
                <div class="col-12 col-lg-9 col-xl-9 p-4 p-lg-5" style="background-color: #f5f6f8;">
                    <t t-out="0"/>
                </div>

            </div>
        </div>
    </template>
</odoo>
