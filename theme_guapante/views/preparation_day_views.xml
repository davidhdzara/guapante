<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_preparation_day_form" model="ir.ui.view">
        <field name="name">guapante.preparation.day.form</field>
        <field name="model">guapante.preparation.day</field>
        <field name="arch" type="xml">
            <form string="Preparación del Día">
                <header>
                    <button
                        name="action_load"
                        type="object"
                        string="Ver pedidos"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_load"
                        type="object"
                        string="Actualizar pedidos"
                        invisible="state == 'draft' or state == 'done'"
                    />
                    <button
                        name="action_mark_done"
                        type="object"
                        string="Finalizar Sesión"
                        class="btn-success"
                        invisible="state == 'draft' or state == 'done'"
                        confirm="¿Estás seguro que deseas finalizar esta sesión?"
                    />
                    <button
                        name="action_reopen"
                        type="object"
                        string="Reabrir Sesión"
                        invisible="state != 'done'"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,loaded,done"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_summaries" icon="fa-list" invisible="state == 'draft' or summary_count == 0">
                            <field name="summary_count" widget="statinfo" string="Productos"/>
                        </button>
                    </div>

                    <!-- Encabezado Base -->
                    <div class="oe_title mb-3">
                        <h1 class="d-flex align-items-center mb-0">
                            <span invisible="state == 'draft'"><field name="name" readonly="1" nolabel="1"/></span>
                        </h1>
                    </div>

                    <!-- Seleccion de fecha (draft state) -->
                    <group invisible="state != 'draft'">
                        <group>
                            <field name="date" widget="date"/>
                        </group>
                    </group>

                    <!-- Loaded state -->
                    <div invisible="state == 'draft'">

                        <!-- Notificación de Guardado -->
                        <div invisible="not save_note" class="alert alert-success py-2 mb-3" role="status">
                            <field name="save_note" readonly="1" nolabel="1"/>
                        </div>

                        <!-- ── PROGRESO GLOBAL DE LA SESIÓN ── -->
                        <field name="total_lines" invisible="1"/>
                        <field name="done_lines" invisible="1"/>
                        <field name="pending_lines" invisible="1"/>
                        <div class="row align-items-center mb-4 bg-light p-3 rounded-3 border" invisible="total_lines == 0">
                            <div class="col-12 col-md-8 mb-2 mb-md-0">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-bold text-uppercase small text-muted">Avance General:</span>
                                    <field name="global_progress_pct" widget="progressbar" class="w-100 flex-grow-1" nolabel="1" options="{'editable': false}"/>
                                </div>
                            </div>
                            <div class="col-12 col-md-4 text-md-end">
                                <span class="badge text-bg-success px-3 py-2 me-1" style="font-size: 0.85rem;">
                                    <i class="fa fa-check-circle"></i>
                                    <field name="done_lines" nolabel="1" readonly="1" class="d-inline"/> hechas
                                </span>
                                <span class="badge text-bg-warning px-3 py-2 me-1" style="font-size: 0.85rem;">
                                    <i class="fa fa-clock-o"></i>
                                    <field name="pending_lines" nolabel="1" readonly="1" class="d-inline"/> pendientes
                                </span>
                                <span class="badge text-bg-secondary px-3 py-2" style="font-size: 0.85rem;">
                                    <i class="fa fa-cube"></i>
                                    <field name="total_lines" nolabel="1" readonly="1" class="d-inline"/> total
                                </span>
                            </div>
                        </div>

                        <!-- ── CONCILIACIÓN CAJAS: VENTAS vs INVENTARIO ── -->
                        <field name="so_count" invisible="1"/>
                        <field name="pick_count" invisible="1"/>
                        <field name="box_diff" invisible="1"/>
                        <field name="box_match" invisible="1"/>
                        <div class="row mb-4" invisible="so_count == 0 and pick_count == 0">
                            <div class="col-12">
                                <div class="d-flex align-items-center gap-3 p-3 rounded-3 border"
                                     style="background-color: #f8f9fa;">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fa fa-archive text-primary" style="font-size: 1.2rem;"></i>
                                        <span class="fw-bold text-uppercase small text-muted">Cajas a alistar:</span>
                                    </div>
                                    <span class="badge text-bg-primary px-3 py-2" style="font-size: 0.9rem;">
                                        <i class="fa fa-shopping-cart"></i>
                                        <field name="so_count" nolabel="1" readonly="1" class="d-inline"/> ventas
                                    </span>
                                    <span class="text-muted">vs</span>
                                    <span class="badge text-bg-info px-3 py-2" style="font-size: 0.9rem;">
                                        <i class="fa fa-truck"></i>
                                        <field name="pick_count" nolabel="1" readonly="1" class="d-inline"/> pickings
                                    </span>
                                    <span class="badge text-bg-success px-3 py-2" style="font-size: 0.9rem;" invisible="not box_match">
                                        <i class="fa fa-check-circle"></i> Todo coincide
                                    </span>
                                    <span class="badge text-bg-danger px-3 py-2" style="font-size: 0.9rem;" invisible="box_match">
                                        <i class="fa fa-exclamation-triangle"></i>
                                        Diferencia: <field name="box_diff" nolabel="1" readonly="1" class="d-inline"/>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- ── PASO 1: RESUMEN POR PRODUCTO ── -->
                        <div>
                            <h5 class="text-muted mb-2"><i class="fa fa-list"></i> Selecciona un producto para empezar o continuar el empaque</h5>
                            <field name="summary_ids" nolabel="1">
                                <list string="Productos del día"
                                    decoration-success="stock_ok"
                                    create="0" edit="0" open="0"
                                >
                                    <field name="stock_ok" column_invisible="1"/>
                                    <field name="product_id" string="Producto"/>
                                    <field name="order_count" string="Órdenes"/>
                                    <field name="total_estimated_kg" string="Total a preparar (kg)" digits="[10,3]"/>
                                    <field name="total_done_kg" string="Total hecho (kg)" digits="[10,3]" optional="hide"/>
                                    <field name="progress_pct" string="Progreso" widget="progressbar" options="{'editable': false}"/>
                                    <field name="available_qty" string="Disponible en bodega" digits="[10,3]"/>
                                    <button
                                        name="action_select_product"
                                        type="object"
                                        string="Empacar"
                                        icon="fa-cube"
                                        class="btn btn-sm btn-primary fw-bold"
                                    />
                                </list>
                            </field>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Árbol principal de Sesiones -->
    <record id="view_preparation_day_tree" model="ir.ui.view">
        <field name="name">guapante.preparation.day.tree</field>
        <field name="model">guapante.preparation.day</field>
        <field name="arch" type="xml">
            <list string="Sesiones de Preparación" decoration-info="state == 'draft'" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="date"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'loaded'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="action_preparation_day" model="ir.actions.act_window">
        <field name="name">Preparación del Día</field>
        <field name="res_model">guapante.preparation.day</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Crea una nueva Sesión de Preparación
          </p><p>
            Agrupa los pedidos confirmados del día por producto, para acelerar el empaque en bodega y llevar métricas de rendimiento por operario.
          </p>
        </field>
    </record>

    <!-- Vistas del Resumen (Para el Smart Button) -->
    <record id="view_preparation_day_summary_tree" model="ir.ui.view">
        <field name="name">guapante.preparation.day.summary.tree</field>
        <field name="model">guapante.preparation.day.summary</field>
        <field name="arch" type="xml">
            <list string="Productos a preparar" decoration-success="stock_ok" create="0" edit="0" delete="0">
                <field name="stock_ok" column_invisible="1"/>
                <field name="product_id" string="Producto"/>
                <field name="order_count" string="Órdenes"/>
                <field name="total_estimated_kg" string="Total a preparar (kg)" digits="[10,3]"/>
                <field name="total_done_kg" string="Total hecho (kg)" digits="[10,3]" optional="hide"/>
                <field name="progress_pct" string="Progreso" widget="progressbar" options="{'editable': false}"/>
                <field name="available_qty" string="Disponible en bodega" digits="[10,3]"/>
                <button
                    name="action_select_product"
                    type="object"
                    string="Empacar"
                    icon="fa-cube"
                    class="btn btn-sm btn-primary fw-bold"
                />
            </list>
        </field>
    </record>

    <record id="view_preparation_day_summary_search" model="ir.ui.view">
        <field name="name">guapante.preparation.day.summary.search</field>
        <field name="model">guapante.preparation.day.summary</field>
        <field name="arch" type="xml">
            <search string="Buscar productos">
                <field name="product_id" string="Producto"/>
                <separator/>
                <filter string="Con Stock Suficiente" name="stock_ok" domain="[('stock_ok', '=', True)]"/>
                <filter string="Sin Stock" name="no_stock" domain="[('stock_ok', '=', False)]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Producto" name="group_product" context="{'group_by':'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Odoo 18 se rompe si ponemos una acción suelta en un megamenú. 
         Lo anidaremos dentro de la columna nativa "Empleos" (stock_picking_batch.menu_stock_jobs) -->
    <menuitem
        id="menu_preparation_day"
        name="Preparación del Día"
        parent="stock_picking_batch.menu_stock_jobs"
        action="action_preparation_day"
        sequence="50"
    />

    <!-- Wizard Transitorio: Aislamiento visual por usuario -->
    <record id="view_preparation_day_product_wizard_form" model="ir.ui.view">
        <field name="name">guapante.preparation.day.product.wizard.form</field>
        <field name="model">guapante.preparation.day.product.wizard</field>
        <field name="arch" type="xml">
            <form string="Empaque de Producto">
                <header>
                    <button
                        name="action_back_to_session"
                        type="object"
                        string="← Volver a todos los productos"
                        class="btn-secondary"
                    />
                </header>
                <sheet>
                    <!-- Header del detalle -->
                    <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                        <h3 class="mb-0 text-primary fw-bold">
                            <i class="fa fa-pencil-square-o"></i> Empacando: 
                            <field name="product_id" readonly="1" nolabel="1" class="d-inline text-dark" options="{'no_open': True}"/>
                        </h3>
                    </div>
                    
                    <!-- Indicador de stock y progreso -->
                    <field name="total_estimated_kg" invisible="1"/>
                    <field name="available_qty" invisible="1"/>
                    <div class="row align-items-center mb-4 bg-light p-3 rounded-3">
                        <div class="col-12 col-md-6 mb-2 mb-md-0 d-flex gap-2">
                            <span class="badge text-bg-light border border-secondary text-dark px-3 py-2" style="font-size: 0.9rem;">
                                <i class="fa fa-shopping-cart"></i> Pedido: <field name="total_estimated_kg" readonly="1" nolabel="1" class="d-inline" digits="[10,3]"/> kg
                            </span>
                            <span class="badge bg-danger px-3 py-2" style="font-size: 0.9rem;"
                                invisible="available_qty &gt;= total_estimated_kg">
                                <i class="fa fa-exclamation-triangle"></i> Stock Insuficiente: <field name="available_qty" readonly="1" nolabel="1" class="d-inline" digits="[10,3]"/> kg
                            </span>
                            <span class="badge bg-success px-3 py-2" style="font-size: 0.9rem;"
                                invisible="available_qty &lt; total_estimated_kg">
                                <i class="fa fa-check"></i> Hay Stock: <field name="available_qty" readonly="1" nolabel="1" class="d-inline" digits="[10,3]"/> kg
                            </span>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-bold text-muted small text-uppercase">Avance:</span>
                                <field name="progress_percentage" widget="progressbar" class="w-100 flex-grow-1" nolabel="1"/>
                            </div>
                        </div>
                    </div>

                    <!-- Listas Dinámicas (Pendiente / Hecho) -->
                    <div class="row">
                        <div class="col-12">
                            <h4 class="mb-2 text-warning fw-bold"><i class="fa fa-clock-o"></i> Por Hacer </h4>
                            <p class="text-muted small">Escribe el peso real y presiona la tecla <b>Enter</b> para guardar automáticamente.</p>
                            <field name="detail_line_pending_ids" nolabel="1">
                                <list string="Por Hacer" editable="bottom" create="0" delete="0" decoration-warning="actual_kg == 0" class="guapante-list-touch">
                                    <field name="daily_sequence" string="Caja #" readonly="1" optional="show" decoration-bf="1"/>
                                    <field name="product_description" string="Producto exacto" readonly="1" decoration-bf="1"/>
                                    <field name="packaging_name" column_invisible="1"/>
                                    <field name="main_customer_name" string="Cliente Principal" readonly="1"/>
                                    <field name="zone_name" string="Zona" readonly="1"/>
                                    <field name="customer_qty_display" string="Pidió" readonly="1"/>
                                    <field name="customer_uom_label" string="En" readonly="1"/>
                                    <field name="estimated_kg" column_invisible="1"/>
                                    <field name="needs_weighing" column_invisible="1"/>
                                    <field name="is_done" column_invisible="1"/>
                                    <field name="actual_kg" string="Peso real (kg)" digits="[10,3]"/>
                                    <button name="action_save_line_weight_from_ui" type="object" icon="fa-check" title="Confirmar peso" class="btn btn-sm btn-success fw-bold"/>
                                </list>
                            </field>
                        </div>
                        <div class="col-12 mt-4" invisible="not detail_line_done_ids">
                            <h4 class="mb-2 text-success fw-bold"><i class="fa fa-check-circle"></i> Hechos en esta sesión</h4>
                            <field name="detail_line_done_ids" nolabel="1" readonly="1">
                                <list string="Hechos" decoration-muted="1" create="0" delete="0" open="0">
                                    <field name="daily_sequence" string="Caja #" readonly="1"/>
                                    <field name="product_description" string="Producto exacto" readonly="1"/>
                                    <field name="packaging_name" column_invisible="1"/>
                                    <field name="main_customer_name" string="Cliente Principal" readonly="1"/>
                                    <field name="zone_name" string="Zona" readonly="1"/>
                                    <field name="customer_qty_display" string="Pidió" readonly="1"/>
                                    <field name="customer_uom_label" string="En" readonly="1"/>
                                    <field name="estimated_kg" column_invisible="1"/>
                                    <field name="actual_kg" string="Peso Registrado (kg)" digits="[10,3]" decoration-bf="1" decoration-success="1"/>
                                    <button name="action_undo_line" type="object" icon="fa-undo" title="Corregir (Devolver a Pendientes)" class="btn btn-sm btn-warning fw-bold"/>
                                </list>
                            </field>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
