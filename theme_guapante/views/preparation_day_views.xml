<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_preparation_day_form" model="ir.ui.view">
        <field name="name">guapante.preparation.day.form</field>
        <field name="model">guapante.preparation.day</field>
        <field name="arch" type="xml">
            <form string="Preparación del Día">
                <header>
                    <button
                        name="action_load"
                        type="object"
                        string="Ver pedidos"
                        class="btn-primary"
                        invisible="state == 'loaded'"
                    />
                    <button
                        name="action_save_weights"
                        type="object"
                        string="Guardar pesos reales"
                        class="btn-success"
                        invisible="state == 'draft' or not selected_product_id"
                    />
                    <button
                        name="action_load"
                        type="object"
                        string="Recargar fecha"
                        invisible="state == 'draft'"
                    />
                </header>

                <sheet>
                    <field name="state" invisible="1"/>
                    <field name="selected_product_id" invisible="1"/>

                    <!-- Date selector (draft state) -->
                    <group invisible="state == 'loaded'">
                        <group>
                            <field name="date" widget="date"/>
                        </group>
                    </group>

                    <!-- Loaded state -->
                    <div invisible="state == 'draft'">
                        <div class="mb-3">
                            <h2 class="mb-0">
                                📅 Pedidos del
                                <field name="date" readonly="1" nolabel="1" class="d-inline"/>
                            </h2>
                        </div>

                        <!-- Save result notification -->
                        <div invisible="not save_note" class="alert alert-success py-2 mb-3">
                            <field name="save_note" readonly="1" nolabel="1"/>
                        </div>

                        <!-- ── PASO 1: RESUMEN POR PRODUCTO ── -->
                        <div invisible="selected_product_id != False">
                            <h5 class="text-muted mb-2">① Selecciona un producto para ver el detalle</h5>
                            <field name="summary_ids" nolabel="1">
                                <list string="Productos del día"
                                    decoration-danger="not stock_ok"
                                    decoration-success="stock_ok"
                                >
                                    <field name="stock_ok" column_invisible="1"/>
                                    <field name="product_id" string="Producto"/>
                                    <field name="order_count" string="Órdenes"/>
                                    <field name="total_estimated_kg" string="Total kg a preparar" digits="[10,3]"/>
                                    <field name="available_qty" string="Disponible (kg)" digits="[10,3]"/>
                                    <button
                                        name="action_select_product"
                                        type="object"
                                        string="Ver detalle →"
                                        class="btn btn-sm btn-primary"
                                    />
                                </list>
                            </field>
                        </div>

                        <!-- ── PASO 2: DETALLE POR ORDEN (visible cuando hay producto seleccionado) ── -->
                        <div invisible="not selected_product_id">
                            <!-- Header del detalle -->
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <h5 class="mb-0">
                                    ② Pesos reales —
                                    <field name="selected_product_id" readonly="1" nolabel="1" class="d-inline text-primary"/>
                                </h5>
                                <button
                                    name="action_clear_product_filter"
                                    type="object"
                                    string="← Volver al resumen"
                                    class="btn btn-sm btn-outline-secondary"
                                />
                            </div>
                            <!-- Indicador de stock -->
                            <field name="selected_total_kg" invisible="1"/>
                            <field name="selected_available_qty" invisible="1"/>
                            <div class="d-flex gap-3 mb-3">
                                <span class="rounded px-3 py-1 bg-secondary-subtle text-secondary border border-secondary-subtle fw-semibold">
                                    📦 Total pedido: <field name="selected_total_kg" readonly="1" nolabel="1" class="d-inline" digits="[10,3]"/> kg
                                </span>
                                <span class="rounded px-3 py-1 bg-danger-subtle text-danger border border-danger-subtle fw-semibold"
                                    invisible="selected_available_qty &gt;= selected_total_kg">
                                    ⚠️ Stock insuficiente: <field name="selected_available_qty" readonly="1" nolabel="1" class="d-inline" digits="[10,3]"/> kg disponibles
                                </span>
                                <span class="rounded px-3 py-1 bg-success-subtle text-success border border-success-subtle fw-semibold"
                                    invisible="selected_available_qty &lt; selected_total_kg">
                                    ✅ Stock OK: <field name="selected_available_qty" readonly="1" nolabel="1" class="d-inline" digits="[10,3]"/> kg disponibles
                                </span>
                            </div>

                            <field
                                name="detail_line_ids"
                                nolabel="1"
                            >
                                <list
                                    string="Órdenes"
                                    editable="bottom"
                                    decoration-warning="actual_kg == 0"
                                >
                                    <field name="daily_sequence" string="#" readonly="1" optional="show"/>
                                    <field name="order_name" string="Orden" readonly="1"/>
                                    <field name="customer_name" string="Cliente" readonly="1"/>
                                    <field name="customer_qty_display" string="Pidió" readonly="1"/>
                                    <field name="customer_uom_label" string="En" readonly="1"/>
                                    <field name="estimated_kg" string="Kg estimado" readonly="1" digits="[10,3]"/>
                                    <field name="needs_weighing" column_invisible="1"/>
                                    <field
                                        name="actual_kg"
                                        string="Peso real (kg)"
                                        digits="[10,3]"
                                    />
                                </list>
                            </field>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_preparation_day" model="ir.actions.act_window">
        <field name="name">Preparación del Día</field>
        <field name="res_model">guapante.preparation.day</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_state': 'draft'}</field>
    </record>

    <!-- Odoo 18 se rompe si ponemos una acción suelta en un megamenú. 
         Lo anidaremos dentro de la columna nativa "Empleos" (stock_picking_batch.menu_stock_jobs) -->
    <menuitem
        id="menu_preparation_day"
        name="Preparación del Día"
        parent="stock_picking_batch.menu_stock_jobs"
        action="action_preparation_day"
        sequence="50"
    />
</odoo>
