<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="contactus_custom" inherit_id="website.contactus" name="Custom Contact Us">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="bg-background-light dark:bg-background-dark text-text-main dark:text-white transition-colors duration-200">
                <main class="container py-5">
                    <div class="row justify-content-center mb-5">
                        <div class="col-lg-8 text-center">
                            <h1 class="display-4 fw-bolder text-dark mb-3">Ponte en Contacto</h1>
                            <p class="lead text-muted">
                                ¿Tienes alguna pregunta o sugerencia? Estamos aquí para ayudarte. Completa el formulario y te responderemos lo antes posible.
                            </p>
                        </div>
                    </div>
                    
                    <div class="row g-5">
                        <!-- Formulario (Lado Izquierdo) -->
                        <div class="col-lg-7">
                            <div class="bg-white p-4 p-md-5 rounded-4 border shadow-sm h-100">
                                <h2 class="h3 fw-bold mb-4 text-dark">Envíanos un Mensaje</h2>
                                
                                <!-- Odoo Native Form Configuration -->
                                <form id="contactus_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required s_website_form d-flex flex-column gap-4" data-mark="*" data-model_name="crm.lead" data-success-mode="redirect" data-success-page="/contactus-thank-you" hide-change-model="true">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    
                                    <div class="form-group">
                                        <label class="form-label fw-bold text-dark" for="contact_name">Nombre Completo <span class="text-danger">*</span></label>
                                        <input class="form-control form-control-lg bg-light border-0 s_website_form_input" id="contact_name" name="contact_name" placeholder="Ej: Ana María Rojas" required="1" type="text"/>
                                    </div>
                                    
                                    <div class="form-group">
                                        <label class="form-label fw-bold text-dark" for="email_from">Correo Electrónico <span class="text-danger">*</span></label>
                                        <input class="form-control form-control-lg bg-light border-0 s_website_form_input" id="email_from" name="email_from" placeholder="tu.correo@ejemplo.com" required="1" type="email"/>
                                    </div>
                                    
                                    <div class="form-group">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <label class="form-label fw-bold text-dark mb-0" for="phone">Teléfono</label>
                                            <span class="small text-muted">Opcional</span>
                                        </div>
                                        <input class="form-control form-control-lg bg-light border-0 s_website_form_input" id="phone" name="phone" placeholder="300 123 4567" type="tel"/>
                                    </div>
                                    
                                    <div class="form-group">
                                        <label class="form-label fw-bold text-dark" for="subject">Asunto <span class="text-danger">*</span></label>
                                        <select class="form-select form-select-lg bg-light border-0 s_website_form_input" id="subject" name="name" required="1">
                                            <option selected="" value="">Selecciona una opción</option>
                                            <option value="Pedidos">Pedidos</option>
                                            <option value="Soporte">Soporte</option>
                                            <option value="Información General">Información General</option>
                                            <option value="Sugerencias">Sugerencias</option>
                                            <option value="Ventas Mayoristas (B2B)">Ventas Mayoristas (B2B)</option>
                                            <option value="Otro">Otro</option>
                                        </select>
                                    </div>
                                    
                                    <div class="form-group">
                                        <label class="form-label fw-bold text-dark" for="message">Mensaje <span class="text-danger">*</span></label>
                                        <textarea class="form-control form-control-lg bg-light border-0 s_website_form_input" id="message" name="description" placeholder="Escribe tu mensaje aquí..." required="1" rows="5"></textarea>
                                    </div>
                                    
                                    <div class="form-group mt-2">
                                        <button class="btn btn-primary btn-lg w-100 fw-bold d-flex align-items-center justify-content-center gap-2 s_website_form_send shadow-sm" type="submit" style="background-color: #13ec6d; border-color: #13ec6d; color: #111814;">
                                            <span>Enviar Mensaje</span>
                                            <span class="material-symbols-outlined fs-5">send</span>
                                        </button>
                                        <span id="s_website_form_result" class="mt-2 text-danger"></span>
                                    </div>
                                </form>
                            </div>
                        </div>
                        
                        <!-- Información y Mapa (Lado Derecho) -->
                        <div class="col-lg-5">
                            <div class="d-flex flex-column gap-4 h-100">
                                <div class="bg-white p-4 p-md-5 rounded-4 border shadow-sm">
                                    <h3 class="h4 fw-bold mb-4 text-dark">Información de Contacto</h3>
                                    <div class="d-flex flex-column gap-4">
                                        <a class="d-flex align-items-start gap-3 text-decoration-none text-dark" href="#">
                                            <div class="d-flex align-items-center justify-content-center rounded-3" style="width: 48px; height: 48px; background-color: rgba(19, 236, 109, 0.1); color: #13ec6d;">
                                                <span class="material-symbols-outlined">location_on</span>
                                            </div>
                                            <div>
                                                <p class="fw-bold mb-1">Dirección</p>
                                                <p class="text-muted small mb-0">Cra 43A #1-50, Edificio San Fernando, Oficina 801, Medellín, Colombia</p>
                                            </div>
                                        </a>
                                        <a class="d-flex align-items-start gap-3 text-decoration-none text-dark" href="tel:+573001234567">
                                            <div class="d-flex align-items-center justify-content-center rounded-3" style="width: 48px; height: 48px; background-color: rgba(19, 236, 109, 0.1); color: #13ec6d;">
                                                <span class="material-symbols-outlined">call</span>
                                            </div>
                                            <div>
                                                <p class="fw-bold mb-1">Teléfono</p>
                                                <p class="text-muted small mb-0">(+57) 300 123 4567</p>
                                            </div>
                                        </a>
                                        <a class="d-flex align-items-start gap-3 text-decoration-none text-dark" href="mailto:soporte@guapante.com.co">
                                            <div class="d-flex align-items-center justify-content-center rounded-3" style="width: 48px; height: 48px; background-color: rgba(19, 236, 109, 0.1); color: #13ec6d;">
                                                <span class="material-symbols-outlined">mail</span>
                                            </div>
                                            <div>
                                                <p class="fw-bold mb-1">Correo Electrónico</p>
                                                <p class="text-muted small mb-0">soporte@guapante.com.co</p>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                                <div class="rounded-4 overflow-hidden border shadow-sm flex-grow-1" style="min-height: 300px;">
                                    <iframe allowfullscreen="" height="100%" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3966.4529399818817!2d-75.57291192591605!3d6.203644993783777!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e44295325021a69%3A0x6a13d71754430e5c!2sCra.%2043A%20%231-50%2C%20El%20Poblado%2C%20Medell%C3%ADn%2C%20El%20Poblado%2C%20Medell%C3%ADn%2C%20Antioquia!5e0!3m2!1ses!2sco!4v1700000000000!5m2!1ses!2sco" style="border:0;" width="100%"></iframe>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </xpath>
    </template>
</odoo>
