<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="homepage_guapante" inherit_id="website.homepage" name="Guapante Homepage" active="True">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty">
                <t t-call="theme_guapante.s_hero_guapante"/>
                <t t-call="theme_guapante.s_features_guapante"/>
                <t t-call="theme_guapante.s_categories_guapante"/>
                <t t-call="theme_guapante.s_b2b_guapante"/>
            </div>
        </xpath>
    </template>
</odoo>
