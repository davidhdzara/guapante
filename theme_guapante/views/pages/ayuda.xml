<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="page_ayuda_guapante" model="website.page">
        <field name="name">Centro de Ayuda</field>
        <field name="url">/ayuda</field>
        <field name="type">qweb</field>
        <field name="key">theme_guapante.page_ayuda</field>
        <field name="arch" type="xml">
            <t t-name="theme_guapante.page_ayuda">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                         <t t-call="theme_guapante.s_ayuda_hero"/>
                         <t t-call="theme_guapante.s_ayuda_categories"/>
                         <t t-call="theme_guapante.s_ayuda_cta"/>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>
