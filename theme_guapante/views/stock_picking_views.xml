<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_guapante" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.guapante</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Caja # junto al documento origen -->
            <xpath expr="//field[@name='origin']" position="after">
                <field name="daily_sequence" invisible="daily_sequence == 0"/>
                <field name="is_recolectar_operation" invisible="1"/>
                <field name="vehicle_id" placeholder="Seleccionar Vehículo"/>
                <field name="driver_id" placeholder="Conductor Asignado"/>
            </xpath>

            <!-- Cliente Principal antes de la dirección -->
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="sale_parent_id" 
                       invisible="not partner_id or partner_id == sale_parent_id" />
            </xpath>

            <!-- Columnas: Cant. Cliente y UdM Cliente después de Demanda -->
            <xpath expr="//field[@name='move_ids_without_package']//field[@name='product_uom_qty']" position="after">
                <field name="customer_qty_display" string="Cant. Cliente" optional="show" readonly="1" class="text-end"/>
                <field name="customer_uom_display" string="UdM Cliente" optional="show" readonly="1"/>
            </xpath>

            <!-- Checkbox de peso al final de la linea despues de cantidad -->
            <xpath expr="//field[@name='move_ids_without_package']//field[@name='quantity']" position="after">
                <field name="is_weight_confirmed" 
                       widget="boolean_toggle"
                       column_invisible="parent.is_recolectar_operation == False"
                       readonly="parent.state in ('done', 'cancel')"/>
                <field name="extra_validation" 
                       column_invisible="parent.is_recolectar_operation == False"
                       readonly="parent.state in ('done', 'cancel')"/>
            </xpath>
        </field>
    </record>

    <!-- Caja # en la vista lista de Recolecciones y Entregas -->
    <record id="view_picking_list_inherit_guapante" model="ir.ui.view">
        <field name="name">stock.picking.list.inherit.guapante</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="daily_sequence" string="Caja #" optional="show" decoration-bf="1"/>
            </xpath>
        </field>
    </record>

    <!-- Acción de servidor: Resetear Cajas (menú contextual de pickings) -->
    <record id="action_reset_daily_sequence" model="ir.actions.server">
        <field name="name">Resetear # de Cajas</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_reset_daily_sequence()</field>
    </record>
</odoo>
