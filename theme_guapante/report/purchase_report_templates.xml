<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════════════════════════════════════════
         Override: Purchase Order PDF Report (Guapante)

         XPaths verified against REAL Odoo 18 template
         (dumped from ir.ui.view in production).
         ════════════════════════════════════════════════════ -->

    <template id="guapante_report_purchaseorder_document"
              inherit_id="purchase.report_purchaseorder_document">

        <!-- ── 1. Title: Always "Orden de Compra" ── -->
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title">
                Orden de Compra #<span t-field="o.name"/>
            </t>
        </xpath>

        <!-- ── 2. Quantity: show visual_qty for units, product_qty for kg ── -->
        <xpath expr="//span[@t-field='line.product_qty']" position="replace">
            <t t-if="line.uom_mode == 'unit'">
                <span t-esc="int(line.visual_qty) if line.visual_qty == int(line.visual_qty) else round(line.visual_qty, 2)"/>
            </t>
            <t t-else="">
                <span t-field="line.product_qty"/>
            </t>
        </xpath>

        <!-- ── 3. UoM label: mode-specific ── -->
        <xpath expr="//span[@t-field='line.product_uom.name']" position="replace">
            <t t-if="line.uom_mode == 'unit'">
                <span>Unidad</span>
            </t>
            <t t-elif="line.uom_mode == 'g'">
                <span>Gramos</span>
            </t>
            <t t-else="">
                <span t-field="line.product_uom.name"/>
            </t>
        </xpath>

        <!-- ── 4. Hide packaging display "(810 Unidad)" ── -->
        <xpath expr="//span[@t-if='line.product_packaging_id']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

    </template>
</odoo>
