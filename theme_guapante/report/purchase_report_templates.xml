<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════════════════════════════════════════
         Override: Purchase Order PDF Report
         
         Requirements:
         1. Title: Always "Orden de Compra" (never "Solicitud")
         2. Cant column: ONLY weight OR ONLY units, never both
         3. Hide: Price, Discount, Taxes, Subtotal, Totals
         4. Keep: Description, Fecha Prevista, Cantidad
         ════════════════════════════════════════════════════ -->

    <!-- ── TEMPLATE 1: Fix title ── -->
    <template id="guapante_po_title"
              inherit_id="purchase.report_purchaseorder_document"
              priority="99">
        <!-- Replace the conditional title spans with a single fixed title -->
        <xpath expr="//h2/span[@t-if]" position="replace">
            <span>Orden de Compra </span>
        </xpath>
        <!-- Remove the second conditional span (t-else or t-elif) -->
        <xpath expr="//h2/span[@t-elif]" position="replace"/>
        <xpath expr="//h2/span[@t-else]" position="replace"/>
    </template>

    <!-- ── TEMPLATE 2: Clean quantity display + hide financial columns ── -->
    <template id="guapante_po_columns"
              inherit_id="purchase.report_purchaseorder_document"
              priority="100">

        <!-- Replace quantity: show ONLY kg OR units, not both -->
        <xpath expr="//span[@t-field='line.product_qty']" position="replace">
            <t t-if="line.uom_mode == 'unit'">
                <span t-esc="int(line.visual_qty) if line.visual_qty == int(line.visual_qty) else '%.2f' % line.visual_qty"/>
            </t>
            <t t-else="">
                <span t-esc="'%.2f' % line.product_qty"/>
            </t>
        </xpath>
        <!-- Replace UoM label based on uom_mode -->
        <xpath expr="//span[@t-field='line.product_uom']" position="replace">
            <t t-if="line.uom_mode == 'unit'">
                <span>Unidades</span>
            </t>
            <t t-elif="line.uom_mode == 'g'">
                <span>Gramos</span>
            </t>
            <t t-else="">
                <span>kg</span>
            </t>
        </xpath>

        <!-- Hide the packaging display "(810 Unidad)" -->
        <xpath expr="//span[@t-field='line.product_packaging_qty']/.." position="replace"/>

        <!-- Hide price_unit -->
        <xpath expr="//th[@name='th_price_unit']" position="replace"/>
        <xpath expr="//td[@name='td_price_unit']" position="replace"/>

        <!-- Hide taxes -->
        <xpath expr="//th[@name='th_taxes']" position="replace"/>
        <xpath expr="//td[@name='td_taxes']" position="replace"/>

        <!-- Hide subtotal -->
        <xpath expr="//th[@name='th_subtotal']" position="replace"/>
        <xpath expr="//td[@name='td_subtotal']" position="replace"/>

        <!-- Hide totals section -->
        <xpath expr="//div[@id='total']" position="replace"/>
    </template>
</odoo>
