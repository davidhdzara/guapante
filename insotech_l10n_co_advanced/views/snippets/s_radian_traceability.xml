<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_radian_traceability" name="Trazabilidad Legal DIAN">
        <t t-if="invoice.insotech_dian_status == 'accepted'">
            <!-- PDF Footer Replica Match -->
            <div class="row w-100 mt-2 mx-0" style="font-size: 0.70rem; color: #000; font-family: sans-serif; line-height: 1.2;">
                
                <!-- Row 1: Left QR and Right Profile Info -->
                <div class="col-12 px-0 d-flex flex-wrap align-items-center mb-1">
                    
                    <div style="width: 140px; margin-right: 20px;" class="mb-2 mb-md-0">
                        <t t-set="qr_string" t-value="invoice.l10n_co_edi_qr_code if 'l10n_co_edi_qr_code' in invoice and invoice.l10n_co_edi_qr_code else 'https://catalogo-vpfe.dian.gov.co/document/searchqr?documentkey=' + (invoice.l10n_co_edi_cufe_cude_ref or '')"/>
                        <img t-attf-src="/report/barcode/?barcode_type=QR&amp;value={{ qr_string }}&amp;width=140&amp;height=140" class="img-fluid" alt="QR DIAN"/>
                    </div>
                    
                    <div class="flex-grow-1 text-start ps-0">
                        <div>DIAN Resolución <span t-esc="invoice.journal_id.l10n_co_edi_dian_authorization_number or 'N/A'"/></div>
                        <div>Fecha efectiva desde <span t-esc="invoice.journal_id.l10n_co_edi_dian_authorization_date or ''"/> a <span t-esc="invoice.journal_id.l10n_co_edi_dian_authorization_end_date or ''"/></div>
                        <div>Número de secuencia desde <span t-esc="invoice.journal_id.l10n_co_edi_min_range_number or ''"/> a <span t-esc="invoice.journal_id.l10n_co_edi_max_range_number or ''"/></div>
                        
                        <t t-set="partner_fiscal" t-value="invoice.company_id.partner_id"/>
                        <t t-if="partner_fiscal">
                            <t t-set="is_gc" t-value="partner_fiscal.l10n_co_edi_large_taxpayer if 'l10n_co_edi_large_taxpayer' in partner_fiscal else False"/>
                            <div><t t-if="is_gc">Somos Grandes Contribuyentes</t><t t-else="">No Somos Grandes Contribuyentes</t></div>
                            
                            <t t-set="regime_tax" t-value="'Responsable de IVA'"/>
                            <t t-if="'l10n_co_edi_obligation_type_ids' in partner_fiscal and partner_fiscal.l10n_co_edi_obligation_type_ids">
                                <t t-if="partner_fiscal.l10n_co_edi_obligation_type_ids.filtered(lambda x: x.name == 'O-47')">
                                    <t t-set="regime_tax" t-value="'Régimen Simple de Tributación - SIMPLE'"/>
                                </t>
                            </t>
                            <div>Regimen fiscal: <span t-esc="regime_tax"/></div>
                            <div>Responsabilidad tributaria: <span t-esc="', '.join(partner_fiscal.l10n_co_edi_obligation_type_ids.mapped('description')) if 'l10n_co_edi_obligation_type_ids' in partner_fiscal and partner_fiscal.l10n_co_edi_obligation_type_ids else 'IVA'"/></div>
                            <t t-set="industry" t-value="partner_fiscal.industry_id.name if 'industry_id' in partner_fiscal and partner_fiscal.industry_id else 'No especificada'"/>
                            <div>Actividad económica: <span t-esc="industry"/></div>
                        </t>
                    </div>
                </div>
                
                <!-- Row 2: Full Width DIAN Core Details -->
                <div class="col-12 px-0 text-start mt-1" style="word-break: break-all;">
                    <div><strong>CUFE:</strong> <span t-esc="invoice.l10n_co_edi_cufe_cude_ref or ''"/></div>
                    <div><strong>Fecha de firma:</strong> <span t-esc="(invoice.l10n_co_edi_datetime or invoice.create_date).strftime('%Y-%m-%d %H:%M:%S') if 'l10n_co_edi_datetime' in invoice else invoice.create_date.strftime('%Y-%m-%d %H:%M:%S')"/></div>
                    <div><strong>Fecha de emisión:</strong> <span t-esc="invoice.invoice_date"/> <span t-esc="invoice.create_date.strftime('%H:%M:%S') if invoice.create_date else ''"/></div>
                    <div><strong>Generado por:</strong> Software Propio</div>
                    <div><strong>NIT:</strong> <span t-esc="invoice.company_id.vat"/></div>
                    <t t-set="sig_val" t-value="invoice._get_dian_signature_value()"/>
                    <div t-if="sig_val"><strong>Firma:</strong> <span t-esc="sig_val" style="word-break: break-all;"/></div>
                </div>
                
                <!-- Texto legal obligatorio -->
                <div class="col-12 px-0 text-center mt-2" style="font-size: 0.65rem;">
                    Representación gráfica de facturación electrónica impresa por computador con software propio por
                    <span t-esc="invoice.company_id.name"/>
                </div>
                
            </div>
        </t>
    </template>
</odoo>
