<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_radian_traceability" name="Trazabilidad Legal DIAN">
        <t t-if="invoice.insotech_dian_status == 'accepted' or invoice.l10n_co_edi_cufe_cude_ref">
            <!-- Pie de página reglamentario DIAN -->
            <div class="row mt-2" style="font-size: 7pt; color: #333; font-family: sans-serif; border-top: 1pt solid #000; padding-top: 10px;">
                
                <!-- QR Code Izquierda -->
                <div class="col-3 text-center">
                    <t t-set="qr_string" t-value="invoice.l10n_co_edi_qr_code if 'l10n_co_edi_qr_code' in invoice and invoice.l10n_co_edi_qr_code else 'https://catalogo-vpfe.dian.gov.co/document/searchqr?documentkey=' + (invoice.l10n_co_edi_cufe_cude_ref or '')"/>
                    <img t-attf-src="/report/barcode/?barcode_type=QR&amp;value={{ qr_string }}&amp;width=100&amp;height=100" style="max-height: 80px; max-width: 80px;" alt="QR DIAN"/>
                </div>
                
                <!-- Info Legal Centro/Derecha -->
                <div class="col-9">
                    <div style="margin-bottom: 5px;">
                        <strong>AUTORIZACIÓN DIAN:</strong> <span t-esc="invoice.journal_id.l10n_co_edi_dian_authorization_number or 'N/A'"/> 
                        de <span t-esc="invoice.journal_id.l10n_co_edi_dian_authorization_date or ''"/> 
                        hasta <span t-esc="invoice.journal_id.l10n_co_edi_dian_authorization_end_date or ''"/> 
                        (Rango: <span t-esc="invoice.journal_id.l10n_co_edi_min_range_number or ''"/> - <span t-esc="invoice.journal_id.l10n_co_edi_max_range_number or ''"/>)
                    </div>
                    
                    <div style="margin-bottom: 5px; word-break: break-all;">
                        <strong>CUFE / CUDE:</strong> <span t-esc="invoice.l10n_co_edi_cufe_cude_ref or 'N/A'"/>
                    </div>

                    <div style="font-size: 6pt; opacity: 0.8;">
                        Representación gráfica de factura electrónica. Software propio desarrollado por <span t-esc="invoice.company_id.name"/>. 
                        Firma digital vinculada a esta factura según protocolos de la DIAN.
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
