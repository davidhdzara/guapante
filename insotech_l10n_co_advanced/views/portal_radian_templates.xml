<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- 1. Inject UI Actions in Portal Page (Top/Side and Bottom) -->
    <template id="portal_radian_invoice_inherit" inherit_id="account.portal_invoice_page" name="Portal RADIAN Invoice">

        <!-- Inject Actions right above the communication chatter -->
        <xpath expr="//div[@id='invoice_communication']" position="before">
            <!-- Quitamos el Wrapper de texto a peticion del PO -->
            <t t-call="insotech_l10n_co_advanced.s_radian_actions"/>
        </xpath>
        
    </template>

    <!-- 2. Inject Traceability inside the Invoice Report (PDF and HTML iFrame) -->
    <template id="report_invoice_document_radian_inherit" inherit_id="account.report_invoice_document" name="Report Invoice RADIAN Traceability">
        <!-- Inject right below the payment communication paragraph -->
        <xpath expr="//p[@name='payment_communication']" position="after">
            <t t-set="invoice" t-value="o"/>
            <t t-call="insotech_l10n_co_advanced.s_radian_traceability"/>
        </xpath>
    </template>

</odoo>
