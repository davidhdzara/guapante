<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════════════════════════════════════════════
         ORDEN DE VENTA — Diseño Premium Guapante (WhatsApp)
         Solo muestra: Producto + Cantidad (SIN PRECIOS)
         Estrategia: CSS hide + XPath inject (NO replace .page)
         ════════════════════════════════════════════════════════ -->

    <template id="report_saleorder_document_guapante"
              inherit_id="sale.report_saleorder_document"
              priority="99999">

        <!-- BYPASS: Usar external_layout_guapante -->
        <xpath expr="//t[@t-call='web.external_layout']" position="attributes">
            <attribute name="t-call">insotech_l10n_co_advanced.external_layout_guapante</attribute>
        </xpath>

        <!-- ═══════════════════════════════════════════════════════
             STEP 1: CSS — Ocultar precios, totales, info nativa
                     + Estilizar tabla y layout
             ═══════════════════════════════════════════════════════ -->
        <xpath expr="//div[@id='informations']" position="before">
            <style type="text/css">
                /* ══════════════════════════════════════
                   OCULTAR ELEMENTOS NO DESEADOS
                   ══════════════════════════════════════ */

                /* Ocultar layout_document_title nativo (h2) */
                .page > .oe_structure:first-child + h2,
                h2[t-out="layout_document_title"],
                .o_report_layout_insotech > h2 { display: none !important; }

                /* Ocultar #informations nativo */
                #informations { display: none !important; }

                /* Ocultar columnas de precio, descuento, impuestos, subtotal */
                th[name="th_priceunit"],
                td[name="td_priceunit"],
                th[name="th_discount"],
                td[name="td_discount"],
                th[name="th_taxes"],
                td[name="td_taxes"],
                th[name="th_subtotal"],
                td[name="td_subtotal"] { display: none !important; }

                /* Ocultar subtotales de sección */
                tr.is-subtotal { display: none !important; }

                /* Ocultar div de totales completo */
                div[name="so_total_summary"] { display: none !important; }

                /* Ocultar firma */
                div[name="signature"] { display: none !important; }

                /* Ocultar notas de pago y fiscal */
                #fiscal_position_remark { display: none !important; }

                /* Ocultar address blocks nativos */
                .o_report_layout_insotech > .row { display: none !important; }
                .page > .row:not(#informations):not(.gpt-custom) { display: none !important; }

                /* ══════════════════════════════════════
                   ESTILOS PREMIUM GUAPANTE
                   ══════════════════════════════════════ */

                .gpt-order-title {
                    font-size: 22px;
                    font-weight: 900;
                    color: #14532d;
                    letter-spacing: 1px;
                    text-transform: uppercase;
                    margin: 0;
                    line-height: 1.2;
                }
                .gpt-order-subtitle {
                    font-size: 18px;
                    font-weight: 800;
                    color: #22c55e;
                    text-transform: uppercase;
                    line-height: 1.2;
                }
                .gpt-order-number {
                    font-size: 14px;
                    font-weight: 600;
                    color: #495057;
                    margin-top: 2px;
                }
                .gpt-accent-bar {
                    height: 3px;
                    background: linear-gradient(90deg, #14532d 0%, #22c55e 100%);
                    border: none;
                    margin: 12px 0 20px 0;
                }

                /* Info Grid */
                .gpt-info-grid {
                    display: table;
                    width: 100%;
                    border: 1px solid #e5e7eb;
                    border-left: 3px solid #14532d;
                    margin-bottom: 20px;
                    background: #fafbfc;
                }
                .gpt-info-row { display: table-row; }
                .gpt-info-label {
                    display: table-cell;
                    width: 35%;
                    padding: 7px 12px;
                    font-size: 11px;
                    font-weight: 700;
                    color: #14532d;
                    text-transform: uppercase;
                    letter-spacing: 0.08em;
                    border-bottom: 1px solid #f0f0f0;
                    vertical-align: middle;
                }
                .gpt-info-value {
                    display: table-cell;
                    width: 65%;
                    padding: 7px 12px;
                    font-size: 12px;
                    color: #2d2d2d;
                    border-bottom: 1px solid #f0f0f0;
                    vertical-align: middle;
                }

                /* Section Title */
                .gpt-section-title {
                    font-size: 10px;
                    font-weight: 700;
                    color: #14532d;
                    text-transform: uppercase;
                    letter-spacing: 0.15em;
                    margin-bottom: 8px;
                    padding-bottom: 4px;
                    border-bottom: 1px solid #e5e7eb;
                }

                /* Estilizar tabla existente */
                table.o_main_table thead tr {
                    background-color: #14532d !important;
                }
                table.o_main_table thead th {
                    background-color: #14532d !important;
                    color: white !important;
                    font-size: 9px !important;
                    font-weight: 700 !important;
                    text-transform: uppercase !important;
                    letter-spacing: 0.1em !important;
                    padding: 8px 10px !important;
                    border: none !important;
                }
                table.o_main_table thead th span {
                    color: white !important;
                }
                table.o_main_table tbody td {
                    padding: 8px 10px !important;
                    border-bottom: 1px solid #e5e7eb !important;
                    color: #374151 !important;
                    font-size: 11px !important;
                }
                table.o_main_table tbody tr:nth-child(even) td {
                    background-color: #f9fafb !important;
                }
                /* Cantidad en verde bold */
                table.o_main_table tbody td.o_td_quantity {
                    font-weight: 600 !important;
                    font-size: 13px !important;
                    color: #14532d !important;
                }
                /* Section rows */
                .o_line_section td {
                    background-color: #f0fdf4 !important;
                    color: #14532d !important;
                    border-left: 3px solid #14532d !important;
                }
                /* Note rows */
                .o_line_note td {
                    font-style: italic !important;
                    color: #9ca3af !important;
                    font-size: 10px !important;
                }

                /* Total Items Bar */
                .gpt-total-bar {
                    background-color: #14532d;
                    color: white;
                    padding: 12px 20px;
                    display: table;
                    width: 100%;
                    margin-top: 5px;
                }
                .gpt-total-label {
                    display: table-cell;
                    font-size: 12px;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: 0.15em;
                    vertical-align: middle;
                }
                .gpt-total-amount {
                    display: table-cell;
                    text-align: right;
                    font-size: 18px;
                    font-weight: 900;
                    letter-spacing: 0.5px;
                    vertical-align: middle;
                }

                /* Footer note */
                .gpt-footer-note {
                    font-size: 8px;
                    color: #9ca3af;
                    text-align: center;
                    margin-top: 25px;
                    padding-top: 10px;
                    border-top: 1px solid #e5e7eb;
                }
            </style>

            <!-- ══════ TÍTULO CUSTOM ══════ -->
            <t t-set="is_proforma" t-value="env.context.get('proforma', False) or is_pro_forma"/>
            <div style="margin-bottom: 5px;">
                <t t-if="is_proforma">
                    <div class="gpt-order-title">Pro-Forma</div>
                    <div class="gpt-order-subtitle">Invoice</div>
                </t>
                <t t-elif="doc.state in ['draft','sent']">
                    <div class="gpt-order-title">Cotización</div>
                </t>
                <t t-else="">
                    <div class="gpt-order-title">Orden</div>
                    <div class="gpt-order-subtitle">de Compra</div>
                </t>
                <div class="gpt-order-number">
                    No. <span t-field="doc.name">S00001</span>
                </div>
            </div>
            <div class="gpt-accent-bar"/>

            <!-- ══════ GRID INFORMACIÓN ══════ -->
            <div class="gpt-info-grid">
                <div class="gpt-info-row" t-if="doc.date_order">
                    <div class="gpt-info-label">Fecha</div>
                    <div class="gpt-info-value">
                        <span t-field="doc.date_order" t-options='{"widget": "date"}'/>
                    </div>
                </div>
                <div class="gpt-info-row" t-if="doc.partner_id">
                    <div class="gpt-info-label">Cliente</div>
                    <div class="gpt-info-value">
                        <strong><span t-field="doc.partner_id.name"/></strong>
                        <t t-if="doc.partner_id.vat">
                            <br/><span style="font-size: 10px; color: #6b7280;">NIT: <span t-field="doc.partner_id.vat"/></span>
                        </t>
                    </div>
                </div>
                <div class="gpt-info-row" t-if="doc.partner_id.phone or doc.partner_id.mobile">
                    <div class="gpt-info-label">Teléfono</div>
                    <div class="gpt-info-value">
                        <span t-if="doc.partner_id.mobile" t-field="doc.partner_id.mobile"/>
                        <span t-elif="doc.partner_id.phone" t-field="doc.partner_id.phone"/>
                    </div>
                </div>
                <div class="gpt-info-row" t-if="doc.partner_shipping_id and doc.partner_shipping_id != doc.partner_id">
                    <div class="gpt-info-label">Dirección de Envío</div>
                    <div class="gpt-info-value">
                        <span t-field="doc.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                    </div>
                </div>
                <div class="gpt-info-row" t-if="doc.client_order_ref">
                    <div class="gpt-info-label">Referencia</div>
                    <div class="gpt-info-value"><span t-field="doc.client_order_ref"/></div>
                </div>
            </div>

            <!-- ══════ SECCIÓN PRODUCTOS ══════ -->
            <div class="gpt-section-title">Productos Solicitados</div>

        </xpath>

        <!-- ═══════════════════════════════════════════════════════
             STEP 2: AFTER TABLE — Total items bar + footer
             ═══════════════════════════════════════════════════════ -->
        <xpath expr="//div[hasclass('clearfix')][@name='so_total_summary']" position="after">
            <t t-set="lines_report" t-value="doc._get_order_lines_to_report()"/>
            <t t-set="item_count" t-value="sum(1 for l in lines_report if not l.display_type and l.product_type != 'combo')"/>

            <!-- BARRA TOTAL ITEMS -->
            <div class="gpt-total-bar">
                <div class="gpt-total-label">Total Productos</div>
                <div class="gpt-total-amount">
                    <span t-esc="item_count"/> ítems
                </div>
            </div>

            <!-- NOTAS -->
            <t t-if="doc.note and not is_html_empty(doc.note)">
                <div style="margin-top: 15px; padding: 12px 14px; border: 1px solid #e5e7eb; border-left: 3px solid #14532d; background: #fafbfc;">
                    <div style="font-size: 9px; font-weight: 700; color: #14532d; text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 6px;">Observaciones</div>
                    <div style="font-size: 10px; color: #6b7280; line-height: 1.7;">
                        <span t-field="doc.note"/>
                    </div>
                </div>
            </t>

            <!-- FOOTER LEGAL -->
            <div class="gpt-footer-note">
                <span t-field="doc.company_id.name"/>
                · NIT <span t-esc="doc.company_id.vat"/>
                <br/>
                Este documento es una confirmación de pedido. Los precios están sujetos a la cotización vigente.
            </div>
        </xpath>

    </template>

</odoo>
