<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_inherit_radian" inherit_id="account.report_invoice_document">

        <!-- A. ESTILOS DE EMERGENCIA - INMUNES A PARSE ERRORS -->
        <xpath expr="//div" position="before">
            <style type="text/css">
                /* Ocultar el título FE586 y redundancias nativas vía CSS (No causa errores de XPath) */
                .page > h2:first-child, 
                .page > h3:first-child, 
                .page > div:first-of-type h2,
                .page > .row:first-of-type h2 {
                    display: none !important;
                }
                
                /* Forzar ocultamiento de etiquetas de fecha nativas */
                [name="invoice_date"], [name="invoice_date_due"], [name="payment_term"] {
                    display: none !important;
                }

                .page {
                    font-size: 8pt !important;
                    color: #000 !important;
                    font-family: Arial, sans-serif !important;
                    margin-top: -30px !important;
                }
                
                .o_main_table {
                    border: 1.2pt solid #000 !important;
                    border-collapse: collapse !important;
                    margin-top: 10px !important;
                }
                .o_main_table thead th {
                    background-color: #333 !important;
                    color: #fff !important;
                    border: 1.2pt solid #000 !important;
                }
                .o_main_table tbody td {
                    border: 0.8pt solid #000 !important;
                    padding: 3px 4px !important;
                }

                .guapante-logo-box { width: 120px; height: 90px; display: flex; align-items: center; }
                .guapante-logo { max-height: 85px; max-width: 115px; object-fit: contain; }

                .totals-table { border: 1.2pt solid #000 !important; width: 100%; border-collapse: collapse; }
                .totals-table td { border: 0.8pt solid #000 !important; padding: 4px !important; }
                .total-row-green { background-color: #28a745 !important; color: #fff !important; font-weight: bold; }
                
                .info-text { font-size: 7.5pt; line-height: 1.1; }
            </style>
        </xpath>

        <!-- B. REEMPLAZOS QUIRÚRGICOS SEGUROS (Mantenemos solo IDs conocidos) -->
        <xpath expr="//t[@t-set='address']" position="replace"><div/></xpath>
        
        <xpath expr="//div[@id='informations']" position="replace">
            <!-- CABECERA GUAPANTE V8 -->
            <div class="row g-0 mb-2">
                <div class="col-7">
                    <div class="row g-0">
                        <div class="col-5">
                            <div class="guapante-logo-box">
                                <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" class="guapante-logo" alt="Logo"/>
                                <img t-if="not o.company_id.logo and res_company.logo" t-att-src="image_data_uri(res_company.logo)" class="guapante-logo" alt="Logo Fallback"/>
                            </div>
                        </div>
                        <div class="col-7 ps-2 info-text">
                            <strong style="font-size: 10pt;" t-field="o.company_id.name"/><br/>
                            <strong>NIT:</strong> <span t-esc="o.company_id.vat"/><br/>
                            <span t-field="o.company_id.street"/><br/>
                            <span t-field="o.company_id.city"/>, <span t-field="o.company_id.state_id.name"/><br/>
                            <strong>Tel:</strong> <span t-esc="o.company_id.phone or o.company_id.mobile"/><br/>
                            <strong>Email:</strong> <span t-field="o.company_id.email"/>
                        </div>
                    </div>
                </div>
                <div class="col-5 text-center">
                    <div style="border: 1.2pt solid #000; padding: 4px; background-color: #eee;">
                        <span style="font-size: 8.5pt; font-weight: bold; display: block;">FACTURA ELECTRÓNICA DE VENTA</span>
                        <span style="font-size: 13pt; font-weight: bold;" t-field="o.name"/>
                    </div>
                    <table class="w-100 mt-1 info-text" style="border: 1pt solid #000; border-collapse: collapse;">
                        <tr style="border-bottom: 1pt solid #000;">
                            <td class="p-1"><strong>FECHA EMISIÓN:</strong></td>
                            <td class="text-end p-1"><span t-field="o.invoice_date"/></td>
                        </tr>
                        <tr style="border-bottom: 1pt solid #000;">
                            <td class="p-1"><strong>FECHA VENCIMIENTO:</strong></td>
                            <td class="text-end p-1"><span t-field="o.invoice_date_due"/></td>
                        </tr>
                        <tr>
                            <td class="p-1"><strong>FORMA DE PAGO:</strong></td>
                            <td class="text-end p-1"><span t-field="o.invoice_payment_term_id.name"/></td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- ADQUIRIENTE V8 -->
            <div style="border: 1.2pt solid #000; padding: 4px 6px; margin-top: 5px; margin-bottom: 5px; width: 100%;">
                <div class="row g-0 info-text">
                    <div class="col-6 border-end pe-2">
                        <strong style="text-transform: uppercase; font-size: 6.5pt; display: block; border-bottom: 1pt solid #000;">Información Adquiriente</strong>
                        <strong>CLIENTE:</strong> <span t-field="o.partner_id.name"/><br/>
                        <strong>DIRECCIÓN:</strong> <span t-field="o.partner_id.street"/><br/>
                        <strong>CIUDAD:</strong> <span t-field="o.partner_id.city"/> (<span t-field="o.partner_id.state_id.name"/>)
                    </div>
                    <div class="col-6 ps-2">
                        <strong style="text-transform: uppercase; font-size: 6.5pt; display: block; border-bottom: 1pt solid #000;">Dirección de Envío</strong>
                        <strong>RECEPTOR:</strong> <span t-field="o.partner_shipping_id.name"/><br/>
                        <strong>DIRECCIÓN:</strong> <span t-field="o.partner_shipping_id.street"/><br/>
                        <strong>TELÉFONO:</strong> <span t-esc="o.partner_shipping_id.phone or o.partner_id.phone"/>
                    </div>
                </div>
            </div>
        </xpath>

        <!-- TOTALES V8 -->
        <xpath expr="//div[@id='total']" position="replace">
            <div class="row g-0 mt-3" style="page-break-inside: avoid;">
                <div class="col-7 pe-3">
                    <div class="row g-0">
                        <div class="col-3 text-center" t-if="o.l10n_co_edi_cufe_cude_ref">
                             <img t-attf-src="/report/barcode/?barcode_type=QR&amp;value={{ o.l10n_co_edi_qr_code or '' }}&amp;width=80&amp;height=80" style="max-height: 70px; max-width: 70px;" alt="QR"/>
                        </div>
                        <div class="col-9 ps-2">
                            <div style="font-size: 8pt; font-weight: bold;"><span t-esc="o.amount_to_words or ''"/></div>
                            <div style="font-size: 6.5pt; line-height: 1.1; margin-top: 4px;"><strong>CUFE:</strong> <span style="word-break: break-all;" t-esc="o.l10n_co_edi_cufe_cude_ref or 'N/A'"/></div>
                        </div>
                    </div>
                </div>
                <div class="col-5">
                    <table class="totals-table table-sm">
                        <tr><td><strong>Subtotal</strong></td><td class="text-end"><span t-field="o.amount_untaxed"/></td></tr>
                        <t t-foreach="o.line_ids.filtered(lambda l: l.display_type == 'tax')" t-as="tax">
                            <tr><td><strong t-esc="tax.name"/></td><td class="text-end"><span t-field="tax.price_subtotal"/></td></tr>
                        </t>
                        <tr class="total-row-green"><td><strong>TOTAL A PAGAR</strong></td><td class="text-end"><strong><span t-field="o.amount_total"/></strong></td></tr>
                    </table>
                </div>
            </div>
        </xpath>

        <xpath expr="//t[@t-call='web.external_layout']" position="attributes">
            <attribute name="t-call">web.basic_layout</attribute>
        </xpath>

    </template>
</odoo>
