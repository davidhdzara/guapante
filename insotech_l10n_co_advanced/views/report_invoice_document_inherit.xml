<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_inherit_insotech_advanced_table" inherit_id="account.report_invoice_document" priority="99999999">
        
        <!-- 1. CSS Aislado Premium B2B -->
        <xpath expr="//table[@name='invoice_line_table']" position="before">
            <style type="text/css">
                table[name="invoice_line_table"] { border-collapse: collapse !important; border: 1px solid #e0e0e0 !important; font-size: 13px !important; }
                table[name="invoice_line_table"] thead th { background-color: #14532d !important; color: #ffffff !important; border: 1px solid #14532d !important; font-weight: 500 !important; letter-spacing: 0.5px; padding: 8px 10px !important; vertical-align: middle !important; }
                table[name="invoice_line_table"] tbody td { border: 1px solid #e0e0e0 !important; padding: 8px 10px !important; vertical-align: middle !important; color: #212529 !important; }
                .res_partner_address_table td { border: none !important; }
                #total table { border-collapse: collapse !important; border: 1px solid #14532d !important; border-radius: 4px; margin-top: 15px; }
                #total table tr { border-bottom: 1px solid #e0e0e0 !important; }
                #total table td.text-start, #total table td:first-child { background-color: #f8f9fa !important; font-weight: bold !important; color: #495057 !important; padding-left: 10px !important; }
                #total table tr.o_total td, #total table tr.o_total strong { background-color: #14532d !important; color: white !important; font-size: 16px !important; font-weight: 800 !important; }
                
                /* ARQUITECTURA FANTASMA: Ocultamiento direcciones base sustituidas */
                .row.address, address { display: none !important; }
                .address strong { display: none !important; }
                .page h2, .page h3, h2, h3 { display: none !important; }
                
                /* ========================================================
                   ESTRATEGIA COMPACTADORA DIAN (Ahorro de Hojas y Diseño B2B)
                   ======================================================== */
                /* Envolver el bloque en un contenedor corporativo y compacto */
                #complement { 
                    font-size: 11px !important; 
                    margin-top: 15px !important; 
                    border: 1px solid #14532d !important; 
                    padding: 10px 15px !important; 
                    border-radius: 4px;
                    background-color: #fcfcfd;
                }
                
                /* Estrangular el QR (Anular el col-4 gordo nativo) */
                #complement .row:first-child { align-items: center !important; }
                #complement .col-4 { 
                    width: 130px !important; 
                    flex: 0 0 130px !important; 
                    max-width: 130px !important; 
                    padding-right: 0 !important; 
                }
                #complement img { 
                    width: 110px !important; 
                    max-width: 110px !important; 
                    height: auto !important; 
                    margin: 0 auto; 
                }
                
                /* Expandir el área de texto con la masa recuperada del QR */
                #complement .col-8 { 
                    width: calc(100% - 130px) !important; 
                    flex: 0 0 calc(100% - 130px) !important; 
                    max-width: calc(100% - 130px) !important; 
                    padding-left: 0 !important;
                }
                
                /* Convertir aburridas listas verticales en un flujo horizontal con separadores rígidos */
                #complement ul { 
                    margin: 0 !important; 
                    padding: 0 !important; 
                }
                #complement ul li { 
                    display: inline-block !important; 
                    padding-right: 8px !important; 
                    margin-right: 4px !important; 
                    border-right: 1px solid #14532d !important; 
                    line-height: 1.35 !important; 
                    margin-bottom: 2px !important; 
                }
                #complement ul li:last-child { 
                    border-right: none !important; 
                    margin-right: 0 !important; 
                }
                
                /* Dominio total sobre la identidad y tamaño */
                #complement ul li span { font-weight: bold !important; color: #14532d !important; word-break: break-all; }
                #complement .row:last-child { margin-top: 6px !important; border-top: 1px dashed #d1d5db; padding-top: 8px; }
            </style>
        </xpath>

        <!-- 2. Reorganizar Clases de la Tabla nativa -->
        <xpath expr="//table[@name='invoice_line_table']" position="attributes">
            <attribute name="class">table table-sm o_main_table mb-0</attribute>
        </xpath>

        <!-- 3. Cabeceras Limpias -->
        <xpath expr="//table[@name='invoice_line_table']/thead/tr" position="replace">
            <tr>
                <th name="th_description" class="text-start"><span>DESCRIPCIÓN</span></th>
                <th name="th_quantity" class="text-end"><span>CANT</span></th>
                <th name="th_uom" class="text-center"><span>UD</span></th>
                <th name="th_priceunit" class="text-end"><span>V. UNITARIO</span></th>
                <th name="th_discount" t-if="display_discount" class="text-end"><span>DESC.%</span></th>
                <th name="th_taxes" class="text-end"><span>IMP.</span></th>
                <th name="th_subtotal" class="text-end"><span>IMPORTE</span></th>
            </tr>
        </xpath>

        <!-- 4. Cuerpo Limpio (Cero Refs, Cero Variantes) -->
        <xpath expr="//t[@name='account_invoice_line_accountable']" position="replace">
            <t t-if="line.display_type == 'product'" name="account_invoice_line_accountable">
                <td name="account_invoice_line_name" class="text-start">
                    <span t-if="line.product_id" t-field="line.product_id.name" t-options="{'widget': 'text'}"/>
                    <span t-else="" t-field="line.name" t-options="{'widget': 'text'}"/>
                </td>
                <td name="td_quantity" class="text-end">
                    <span t-field="line.quantity"/>
                </td>
                <td name="td_uom" class="text-center">
                    <span t-field="line.product_uom_id.name" groups="uom.group_uom"/>
                </td>
                <td name="td_price_unit" class="text-end">
                    <span class="text-nowrap" t-field="line.price_unit"/>
                </td>
                <td name="td_discount" t-if="display_discount" class="text-end">
                    <span class="text-nowrap" t-field="line.discount"/>
                </td>
                <td name="td_taxes" class="text-end">
                    <t t-set="taxes" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_ids])"/>
                    <span t-out="taxes" id="line_tax_ids"/>
                </td>
                <td name="td_subtotal" class="text-end o_price_total">
                    <span class="text-nowrap" t-field="line.price_subtotal"/>
                </td>
            </t>
        </xpath>
        
        <!-- 5. Ocultar el bloque rústico de fechas y nombre del documento nativo (Se reemplazarán por caja verde) -->
        <xpath expr="//div[@id='informations']" position="attributes">
             <attribute name="class" add="d-none" separator=" "/>
        </xpath>
        
        <!-- Ocultar bloque de dirección remita nativo en la línea 1 -->
        
        <xpath expr="//div[hasclass('row')][1]" position="attributes">
             <attribute name="class" add="d-none" separator=" "/>
        </xpath>
        
        <!-- 6. EL ECOSISTEMA B2B: Datos del Receptor a la izquierda + Bloque de Factura a la derecha -->
        <xpath expr="//div[hasclass('row')][1]" position="after">
            
            <div class="row mt-3 mb-4" style="border-top: 2px solid #14532d; border-bottom: 2px solid #14532d; padding: 15px 0; background-color: #fbfbfc;">
                
                <!-- IZQUIERDA (col-7): BATERIA DE DATOS DEL CLIENTE -->
                <div class="col-7">
                    <table class="table table-sm table-borderless mb-0 res_partner_address_table" style="font-size: 13px; line-height: 1.2;">
                        <tbody>
                            <!-- SECCIÓN: DATOS DE FACTURACIÓN -->
                            <tr>
                                <td colspan="2" class="fw-bold" style="color: #14532d; border-bottom: 1px solid #14532d !important; padding-bottom: 4px; margin-bottom: 4px;">DATOS DE FACTURACIÓN (CLIENTE)</td>
                            </tr>
                            <tr>
                                <td class="p-0 fw-bold" style="width: 25%; color: #495057;">CLIENTE:</td>
                                <td class="p-0"><span t-field="o.partner_id.name" class="fw-bold"/></td>
                            </tr>
                            <tr t-if="o.partner_id.vat">
                                <td class="p-0 fw-bold" style="color: #495057;">NIT / RUT:</td>
                                <td class="p-0"><span t-field="o.partner_id.vat"/></td>
                            </tr>
                            <tr>
                                <td class="p-0 fw-bold" style="color: #495057;">DIRECCIÓN:</td>
                                <td class="p-0">
                                    <span t-if="o.partner_id.street" t-field="o.partner_id.street"/>
                                    <span t-if="o.partner_id.street2"> <span t-field="o.partner_id.street2"/></span>
                                    <span t-if="o.partner_id.city">, <span t-field="o.partner_id.city"/></span>
                                    <span t-if="o.partner_id.state_id">, <span t-field="o.partner_id.state_id.name"/></span>
                                </td>
                            </tr>
                            <tr t-if="o.partner_id.phone or o.partner_id.mobile">
                                <td class="p-0 fw-bold" style="color: #495057;">TELÉFONO:</td>
                                <td class="p-0">
                                    <span t-if="o.partner_id.phone" t-field="o.partner_id.phone"/>
                                    <span t-if="o.partner_id.phone and o.partner_id.mobile"> / </span>
                                    <span t-if="o.partner_id.mobile" t-field="o.partner_id.mobile"/>
                                </td>
                            </tr>

                            <!-- SECCIÓN: DATOS DE ENVÍO / COMERCIALES -->
                            <t t-if="o.partner_shipping_id and (o.partner_shipping_id != o.partner_id) or o.ref">
                                <tr>
                                    <td colspan="2" class="fw-bold pt-3" style="color: #14532d; border-bottom: 1px solid #14532d !important; padding-bottom: 4px; margin-bottom: 4px;">DATOS COMERCIALES</td>
                                </tr>
                                <tr t-if="o.partner_shipping_id and (o.partner_shipping_id != o.partner_id)">
                                    <td class="p-0 fw-bold" style="color: #495057;">DESTINO:</td>
                                    <td class="p-0"><span t-field="o.partner_shipping_id.name" class="fw-bold"/></td>
                                </tr>
                                <tr t-if="o.partner_shipping_id and (o.partner_shipping_id != o.partner_id)">
                                    <td class="p-0 fw-bold" style="color: #495057;">DIR. ENVÍO:</td>
                                    <td class="p-0">
                                        <span t-if="o.partner_shipping_id.street" t-field="o.partner_shipping_id.street"/>
                                        <span t-if="o.partner_shipping_id.city">, <span t-field="o.partner_shipping_id.city"/></span>
                                    </td>
                                </tr>
                                <tr t-if="o.ref">
                                    <td class="p-0 fw-bold" style="color: #495057;">ORDEN / REF:</td>
                                    <td class="p-0"><span t-field="o.ref"/></td>
                                </tr>
                                <tr t-if="o.invoice_payment_term_id">
                                    <td class="p-0 fw-bold" style="color: #495057;">TÉRMINOS:</td>
                                    <td class="p-0"><span t-field="o.invoice_payment_term_id.name"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <!-- DERECHA (col-5): BLOQUE MAESTRO DE FACTURA DE VENTA -->
                <div class="col-5">
                    <table class="table table-sm table-borderless mb-0 h-100 shadow-sm" style="font-size: 14px; text-align: center; border: 2px solid #14532d; background-color: white;">
                        <thead style="background-color: #14532d !important; color: white !important;">
                            <tr>
                                <th class="p-2 fw-bold text-center align-middle" colspan="2" style="color: white !important; font-size: 15px;">
                                    <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">FACTURA DE VENTA</span>
                                    <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">BORRADOR DE FACTURA</span>
                                    <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">FACTURA CANCELADA</span>
                                    <span t-if="o.move_type == 'out_refund'">NOTA DE CRÉDITO</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="p-2 fw-bold align-middle" style="background-color: #f8f9fa; width: 45%; border-right: 1px solid #e0e0e0; border-bottom: 1px solid #e0e0e0;">NÚMERO</td>
                                <td class="p-2 fw-bold align-middle" style="color: #14532d; font-size: 16px; border-bottom: 1px solid #e0e0e0;"><span t-if="o.name != '/'" t-field="o.name"/></td>
                            </tr>
                            <tr>
                                <td class="p-2 fw-bold align-middle" style="background-color: #f8f9fa; border-right: 1px solid #e0e0e0; border-bottom: 1px solid #e0e0e0;">GENERACIÓN</td>
                                <td class="p-2 align-middle" style="border-bottom: 1px solid #e0e0e0;"><span t-field="o.invoice_date"/></td>
                            </tr>
                            <tr>
                                <td class="p-2 fw-bold align-middle" style="background-color: #f8f9fa; border-right: 1px solid #e0e0e0;">VENCIMIENTO</td>
                                <td class="p-2 align-middle"><span t-field="o.invoice_date_due"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </div>
        </xpath>

    </template>
</odoo>
