<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_inherit_radian" inherit_id="account.report_invoice_document">
        
        <!-- A. CONTROL TOTAL DEL LAYOUT (ELIMINA EL BLOQUE SUPERIOR GIGANTE) -->
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t t-call="web.external_layout">
                <!-- Estas líneas 'apagan' los bloques nativos de Odoo que causan la redundancia -->
                <t t-set="address" t-value="None"/>
                <t t-set="information_block" t-value="None"/>

                <div class="page">
                    <!-- 1. ESTILOS DE ALTA GAMA (COMO IMAGEN 2) -->
                    <style type="text/css">
                        .page {
                            font-size: 8.5pt !important;
                            color: #000 !important;
                            font-family: Arial, sans-serif !important;
                            margin-top: -20px !important;
                        }
                        
                        /* Ocultar títulos nativos remanentes mediante CSS - No causa errores de XPath */
                        h2, h3, .total_words_box { display: none !important; }

                        /* Tabla de Productos - Estilo Imagen 2 */
                        .o_main_table {
                            border: 1.2pt solid #000 !important;
                            border-collapse: collapse !important;
                            margin-top: 15px !important;
                        }
                        .o_main_table thead th {
                            background-color: #333 !important;
                            color: #fff !important;
                            border: 1.2pt solid #000 !important;
                            padding: 5px !important;
                            text-transform: uppercase;
                            font-weight: bold;
                        }
                        .o_main_table tbody td {
                            border: 1pt solid #000 !important;
                            padding: 4px !important;
                            vertical-align: middle !important;
                        }

                        /* Logo y Cabecera */
                        .guapante-logo {
                            max-height: 90px;
                            max-width: 120px;
                            object-fit: contain;
                        }
                        .invoice-header-box {
                            border: 1.2pt solid #000;
                            padding: 6px;
                            text-align: center;
                            background-color: #f2f2f2;
                        }

                        /* Totales con Fila Verde Vibrante */
                        .totals-table-guapante {
                            border: 1.2pt solid #000 !important;
                            width: 100%;
                            border-collapse: collapse;
                        }
                        .totals-table-guapante td {
                            border: 1pt solid #000 !important;
                            padding: 6px !important;
                        }
                        .total-row-green {
                            background-color: #28a745 !important; 
                            color: #fff !important;
                            font-weight: bold;
                            font-size: 10pt;
                        }
                    </style>

                    <!-- 2. CABECERA GUAPANTE (MISMO NIVEL VISUAL) -->
                    <div class="row g-0 mb-3">
                        <div class="col-7 text-start">
                            <div class="row g-0">
                                <div class="col-5">
                                    <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" class="guapante-logo" alt="Logo"/>
                                </div>
                                <div class="col-7 ps-2" style="font-size: 8.5pt; line-height: 1.3;">
                                    <strong style="font-size: 11pt;" t-field="o.company_id.name"/><br/>
                                    <strong>NIT:</strong> <span t-esc="o.company_id.vat"/><t t-if="'l10n_co_verification_digit' in o.company_id.partner_id._fields and o.company_id.partner_id.l10n_co_verification_digit">-<span t-esc="o.company_id.partner_id.l10n_co_verification_digit"/></t><br/>
                                    <span t-field="o.company_id.street"/><br/>
                                    <span t-field="o.company_id.city"/>, <span t-field="o.company_id.state_id.name"/><br/>
                                    <strong>Tel:</strong> <span t-esc="o.company_id.phone or o.company_id.mobile"/><br/>
                                    <strong>Email:</strong> <span t-field="o.company_id.email"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-5">
                            <div class="invoice-header-box">
                                <span style="font-size: 8.5pt; font-weight: bold; display: block; text-transform: uppercase;">Factura Electrónica de Venta</span>
                                <span style="font-size: 14pt; font-weight: bold;" t-field="o.name"/>
                            </div>
                            <table class="w-100 mt-2" style="border: 1.2pt solid #000; font-size: 8.5pt; border-collapse: collapse;">
                                <tr style="border-bottom: 1.2pt solid #000;">
                                    <td class="p-1 ps-2"><strong>FECHA EMISIÓN:</strong></td>
                                    <td class="p-1 pe-2 text-end"><span t-field="o.invoice_date"/></td>
                                </tr>
                                <tr style="border-bottom: 1.2pt solid #000;">
                                    <td class="p-1 ps-2"><strong>FECHA VENCIMIENTO:</strong></td>
                                    <td class="p-1 pe-2 text-end"><span t-field="o.invoice_date_due"/></td>
                                </tr>
                                <tr>
                                    <td class="p-1 ps-2"><strong>FORMA DE PAGO:</strong></td>
                                    <td class="p-1 pe-2 text-end"><span t-field="o.invoice_payment_term_id.name"/></td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- 3. BLOQUES DE CLIENTE -->
                    <div style="border: 1.2pt solid #000; padding: 6px; margin-top: 10px; background-color: #fff;">
                        <div class="row g-0" style="font-size: 8.5pt;">
                            <div class="col-6 border-end pe-3">
                                <strong style="text-transform: uppercase; font-size: 7.5pt; display: block; border-bottom: 1pt solid #000; margin-bottom: 3px;">Información de Facturación</strong>
                                <strong>CLIENTE:</strong> <span t-field="o.partner_id.name"/><br/>
                                <strong>NIT/CC:</strong> <span t-field="o.partner_id.vat"/><br/>
                                <strong>DIRECCIÓN:</strong> <span t-field="o.partner_id.street"/><br/>
                                <strong>CIUDAD:</strong> <span t-field="o.partner_id.city"/> (<span t-field="o.partner_id.state_id.name"/>)
                            </div>
                            <div class="col-6 ps-3">
                                <strong style="text-transform: uppercase; font-size: 7.5pt; display: block; border-bottom: 1pt solid #000; margin-bottom: 3px;">Dirección de Despacho</strong>
                                <strong>RECEPTOR:</strong> <span t-field="o.partner_shipping_id.name"/><br/>
                                <strong>DIRECCIÓN:</strong> <span t-field="o.partner_shipping_id.street"/><br/>
                                <strong>CONTACTO:</strong> <span t-esc="o.partner_shipping_id.phone or o.partner_id.phone"/>
                            </div>
                        </div>
                    </div>

                    <!-- 4. TABLA DE PRODUCTOS -->
                    <table class="o_main_table table table-sm mt-3" name="invoice_line_table">
                        <thead>
                            <tr>
                                <th class="text-start">Descripción</th>
                                <th class="text-end">Cant.</th>
                                <th class="text-end">Precio Unit.</th>
                                <th class="text-end">Imp.</th>
                                <th class="text-end">Importe</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.id), reverse=True)" t-as="line">
                                <tr>
                                    <td name="account_invoice_line_name">
                                        <t t-if="line.product_id">
                                            <span t-esc="'[%s] %s' % (line.product_id.default_code, line.product_id.name) if line.product_id.default_code else line.product_id.name"/>
                                        </t>
                                        <t t-else="">
                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                        </t>
                                    </td>
                                    <td class="text-end"><span t-field="line.quantity"/></td>
                                    <td class="text-end"><span t-field="line.price_unit"/></td>
                                    <td class="text-end"><span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))"/></td>
                                    <td class="text-end"><span t-field="line.price_subtotal"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- 5. TOTALES INTEGRADOS (V10) -->
                    <div class="row g-0 mt-4" style="page-break-inside: avoid;">
                        <div class="col-7 pe-4">
                            <div class="row g-0">
                                <div class="col-3 text-center" t-if="'l10n_co_edi_cufe_cude_ref' in o._fields and o.l10n_co_edi_cufe_cude_ref">
                                     <img t-attf-src="/report/barcode/?barcode_type=QR&amp;value={{ o.l10n_co_edi_qr_code or '' }}&amp;width=80&amp;height=80" style="max-height: 80px; max-width: 80px;" alt="QR"/>
                                </div>
                                <div class="col-9 ps-2">
                                    <div style="font-size: 9pt; font-weight: bold; text-transform: uppercase;">SON: <span t-esc="o.amount_to_words or ''"/></div>
                                    <t t-if="'l10n_co_edi_cufe_cude_ref' in o._fields and o.l10n_co_edi_cufe_cude_ref">
                                        <div style="font-size: 7pt; color: #555; margin-top: 6px;">
                                            <strong>CUFE:</strong> <span style="word-break: break-all;" t-esc="o.l10n_co_edi_cufe_cude_ref or 'N/A'"/>
                                        </div>
                                    </t>
                                    <div style="font-size: 6.5pt; color: #444; font-style: italic; margin-top: 8px; line-height: 1.3;">
                                        <strong>Nota Legal:</strong> Esta factura de venta se asimila a una letra de cambio (Art. 774 C.Cio). Se cobrarán intereses de mora a la tasa máxima vigente.
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-5">
                            <table class="totals-table-guapante table-sm">
                                <tr>
                                    <td><strong>SUBTOTAL</strong></td>
                                    <td class="text-end"><span t-field="o.amount_untaxed"/></td>
                                </tr>
                                <t t-foreach="o.line_ids.filtered(lambda l: l.display_type == 'tax')" t-as="tax">
                                    <tr>
                                        <td><strong t-esc="tax.name"/></td>
                                        <td class="text-end"><span t-field="tax.price_subtotal"/></td>
                                    </tr>
                                </t>
                                <tr class="total-row-green">
                                    <td><strong>TOTAL A PAGAR</strong></td>
                                    <td class="text-end"><strong><span t-field="o.amount_total"/></strong></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    
                    <!-- 6. PIE DE PÁGINA COMUNICACIÓN -->
                    <div class="mt-4 text-center" style="font-size: 8.5pt; border-top: 1.2pt solid #000; padding-top: 10px;">
                        <strong>REFERENCIA DE PAGO:</strong> <span t-field="o.payment_reference"/> | 
                        <strong>BANCO:</strong> <span t-field="o.partner_bank_id.bank_id.name"/> | 
                        <strong>CUENTA:</strong> <span t-field="o.partner_bank_id.acc_number"/>
                    </div>
                </div>
            </t>
        </xpath>

    </template>
</odoo>
