<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_inherit_radian" inherit_id="account.report_invoice_document">

        <!-- A. ESTILOS GLOBALES - MINIMALISTAS Y COMPACTOS -->
        <xpath expr="//div[hasclass('page')]" position="before">
            <style type="text/css">
                .page {
                    font-size: 8pt !important;
                    color: #000 !important;
                    font-family: Arial, sans-serif !important;
                }
                
                /* Tabla de Productos Compacta y Elegante */
                .o_main_table {
                    border: 0.8pt solid #000 !important;
                    border-collapse: collapse !important;
                    margin-top: 5px !important;
                    width: 100% !important;
                }
                .o_main_table thead th {
                    background-color: #333 !important;
                    color: #fff !important;
                    border: 0.5pt solid #000 !important;
                    padding: 4px !important;
                    text-transform: uppercase;
                    font-size: 7pt !important;
                    font-weight: bold;
                }
                .o_main_table tbody td {
                    border: 0.5pt solid #ddd !important;
                    padding: 2px 4px !important;
                    vertical-align: middle !important;
                    font-size: 7.5pt !important;
                }

                /* Logo y Encabezado */
                .guapante-logo-box {
                    width: 110px !important;
                    height: 110px !important;
                    border: 0.5pt solid #ccc;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    overflow: hidden;
                    background-color: #fff;
                }
                .guapante-logo {
                    max-height: 105px !important;
                    max-width: 105px !important;
                    object-fit: contain;
                }
                .invoice-header-box {
                    border: 1pt solid #000;
                    padding: 4px;
                    text-align: center;
                    background-color: #eee;
                }
                .invoice-title {
                    font-size: 8.5pt;
                    font-weight: bold;
                    display: block;
                    text-transform: uppercase;
                    color: #000;
                }
                .invoice-number {
                    font-size: 13pt;
                    font-weight: bold;
                    color: #000; /* Sobrio */
                }

                /* Sección de Información del Cliente */
                .customer-info-box {
                    border: 0.8pt solid #000;
                    padding: 3px 6px;
                    margin-top: 5px;
                    margin-bottom: 5px;
                    background-color: #fff;
                }
                .section-label {
                    font-weight: bold;
                    text-transform: uppercase;
                    font-size: 6.5pt;
                    color: #000;
                    border-bottom: 0.8pt solid #000;
                    margin-bottom: 2px;
                    display: block;
                }
                .info-text {
                    font-size: 7.5pt;
                    line-height: 1.1;
                }
                .legal-block {
                    font-size: 6.5pt;
                    color: #333;
                    border: 0.5pt solid #ccc;
                    padding: 4px;
                    background-color: #f9f9f9;
                    line-height: 1.2;
                }
            </style>
        </xpath>

        <!-- B. LIMPIEZA DE BLOQUES NATIVOS Y REDUNDANCIAS -->
        <!-- Odoo 18 usa t-set="address" y information_block; los vaciamos -->
        <xpath expr="//t[@t-set='address']" position="replace"><div/></xpath>
        <xpath expr="//t[@t-set='information_block']" position="replace"><div/></xpath>
        
        <!-- XPath Resiliente para el Título (evita ParseError si h2 no existe como tag directo) -->
        <xpath expr="//div[hasclass('page')]//span[@t-field='o.name']/.." position="replace">
            <div id="dummy_title_anchor"/>
        </xpath>

        <!-- C. NUEVA CABECERA PROFESIONAL -->
        <xpath expr="//div[@id='informations']" position="before">
            <div class="row mb-2">
                <!-- Logo e Información de Empresa (Izquierda) -->
                <div class="col-7">
                    <div class="row g-0">
                        <div class="col-4">
                            <div class="guapante-logo-box">
                                <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" class="guapante-logo" alt="Logo"/>
                            </div>
                        </div>
                        <div class="col-8 ps-2 info-text">
                            <strong style="font-size: 9pt;" t-field="o.company_id.name"/><br/>
                            <strong>NIT:</strong> <span t-esc="o.company_id.vat"/><t t-if="o.company_id.partner_id and 'l10n_co_verification_digit' in o.company_id.partner_id._fields and o.company_id.partner_id.l10n_co_verification_digit">-<span t-esc="o.company_id.partner_id.l10n_co_verification_digit"/></t><br/>
                            <span t-field="o.company_id.street"/><br/>
                            <span t-field="o.company_id.city"/>, <span t-field="o.company_id.state_id.name"/><br/>
                            <strong>Tel:</strong> <span t-esc="o.company_id.phone or o.company_id.mobile"/><br/>
                            <strong>Email:</strong> <span t-field="o.company_id.email"/><br/>
                            <strong>LUGAR DE EXPEDICIÓN:</strong> <span t-field="o.company_id.city"/>
                        </div>
                    </div>
                </div>
                <!-- Box de Factura (Derecha) -->
                <div class="col-5">
                    <div class="invoice-header-box">
                        <span class="invoice-title">Factura Electrónica de Venta</span>
                        <span class="invoice-number" t-field="o.name"/>
                    </div>
                    <table class="w-100 mt-1 info-text" style="border: 0.5pt solid #ccc;">
                        <tr style="border-bottom: 0.5pt solid #eee;">
                            <td class="p-1"><strong>FECHA EMISIÓN:</strong></td>
                            <td class="text-end p-1"><span t-field="o.invoice_date"/></td>
                        </tr>
                        <tr style="border-bottom: 0.5pt solid #eee;">
                            <td class="p-1"><strong>FECHA VENCIMIENTO:</strong></td>
                            <td class="text-end p-1"><span t-field="o.invoice_date_due"/></td>
                        </tr>
                        <tr>
                            <td class="p-1"><strong>FORMA DE PAGO:</strong></td>
                            <td class="text-end p-1"><span t-field="o.invoice_payment_term_id.name"/></td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- Información del Cliente (Receptor) -->
            <div class="customer-info-box">
                <span class="section-label">Información del Adquiriente</span>
                <div class="row g-0 info-text">
                    <div class="col-7">
                        <strong>CLIENTE:</strong> <span t-field="o.partner_id.name"/><br/>
                        <strong>NIT/CC:</strong> <span t-field="o.partner_id.vat"/><br/>
                        <strong>DIRECCIÓN:</strong> <span t-field="o.partner_id.street"/><t t-if="o.partner_id.street2">, <span t-field="o.partner_id.street2"/></t>
                    </div>
                    <div class="col-5">
                        <strong>CIUDAD:</strong> <span t-field="o.partner_id.city"/> (<span t-field="o.partner_id.state_id.name"/>)<br/>
                        <strong>TELÉFONO:</strong> <span t-esc="o.partner_id.phone or o.partner_id.mobile"/><br/>
                        <strong>EMAIL:</strong> <span t-field="o.partner_id.email"/>
                    </div>
                </div>
            </div>
        </xpath>

        <!-- D. OPTIMIZACIÓN DE TABLA DE PRODUCTOS -->
        <xpath expr="//table[hasclass('o_main_table')]" position="attributes">
            <attribute name="class">table table-sm o_main_table</attribute>
            <attribute name="style">width: 100%; border: 0.8pt solid #000;</attribute>
        </xpath>

        <!-- E. FILTRO DE DESCRIPCIÓN (1 LÍNEA Y SIN CANTIDAD SOLICITADA) -->
        <xpath expr="//td[@name='account_invoice_line_name']" position="replace">
            <td name="account_invoice_line_name">
                <t t-set="clean_name" t-value="line.name.split('\n')[0]"/>
                <!-- Regex-like replace using multiple replace calls for common variations -->
                <t t-set="clean_name" t-value="clean_name.replace('Cantidad solicitada:', '').replace('cantidad solicitada:', '').replace('CANTIDAD SOLICITADA:', '')"/>
                <t t-set="clean_name" t-value="clean_name.replace('Cantidad solicitada', '').replace('cantidad solicitada', '').replace('CANTIDAD SOLICITADA', '')"/>
                <span t-esc="clean_name.strip()"/>
            </td>
        </xpath>

        <!-- E. TOTALES Y LETRAS (COMPACTADO V2) -->
        <xpath expr="//div[@id='total']" position="after">
            <div class="row g-0 mt-2">
                <div class="col-8">
                    <div class="legal-block">
                        <strong>Nota Legal (Título Valor):</strong> Esta factura de venta se asimila en todos sus efectos a una letra de cambio según el Art. 774 del Código de Comercio. El comprador acepta y declara haber recibido real y materialmente la mercancía descrita. Intereses de mora se cobrarán a la tasa máxima vigente permitida por la ley.
                    </div>
                    <div class="mt-1" style="font-size: 7.5pt; font-weight: bold;">
                        SON: <span t-esc="o.amount_to_words or ''"/>
                    </div>
                </div>
                <div class="col-4 text-end">
                    <div style="font-size: 8pt; font-weight: bold; border-top: 1.5pt solid #000; padding-top: 3px; background-color: #eee; padding-right: 5px;">
                        TOTAL A PAGAR
                    </div>
                </div>
            </div>
        </xpath>

        <!-- F. LIMPIEZA DE COMUNICACIÓN -->
        <xpath expr="//p[@name='payment_communication']" position="replace">
            <div class="mt-2" style="font-size: 7.5pt;">
                <strong>REFERENCIA DE PAGO:</strong> <span t-field="o.payment_reference"/> | 
                <strong>BANCO:</strong> <span t-field="o.partner_bank_id.bank_id.name"/> | 
                <strong>CUENTA:</strong> <span t-field="o.partner_bank_id.acc_number"/>
            </div>
        </xpath>

        <!-- G. SECCIÓN LEGAL DIAN (QR Y CUFE) - ALTA DENSIDAD V2 -->
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-if="o.insotech_dian_status == 'accepted' or o.l10n_co_edi_cufe_cude_ref">
                <div class="row mt-3 g-0" style="font-size: 6.5pt; border-top: 1pt solid #000; padding-top: 5px;">
                    <!-- QR Pequeno -->
                    <div class="col-2 text-center">
                        <t t-set="qr_string" t-value="o.l10n_co_edi_qr_code if 'l10n_co_edi_qr_code' in o and o.l10n_co_edi_qr_code else 'https://catalogo-vpfe.dian.gov.co/document/searchqr?documentkey=' + (o.l10n_co_edi_cufe_cude_ref or '')"/>
                        <img t-attf-src="/report/barcode/?barcode_type=QR&amp;value={{ qr_string }}&amp;width=80&amp;height=80" style="max-height: 60px; max-width: 60px;" alt="QR DIAN"/>
                    </div>
                    <!-- Info Legal -->
                    <div class="col-10 ps-2" style="border-left: 0.5pt solid #eee;">
                        <div style="margin-bottom: 2px; color: #000;">
                            <strong>INFORMACIÓN DIAN:</strong> Res. <span t-esc="o.journal_id.l10n_co_edi_dian_authorization_number"/> de <span t-esc="o.journal_id.l10n_co_edi_dian_authorization_date"/> | Vigente hasta: <span t-esc="o.journal_id.l10n_co_edi_dian_authorization_end_date"/> | Rango: <span t-esc="o.journal_id.l10n_co_edi_min_range_number"/> - <span t-esc="o.journal_id.l10n_co_edi_max_range_number"/>
                        </div>
                        <div style="word-break: break-all; margin-bottom: 2px; line-height: 1;">
                            <strong>CUFE:</strong> <span t-esc="o.l10n_co_edi_cufe_cude_ref or 'N/A'"/>
                        </div>
                        <div style="font-size: 6pt; color: #666;">
                            Representación gráfica de factura electrónica. Software propio desarrollado por <span t-esc="o.company_id.name"/>.
                        </div>
                    </div>
                </div>
            </t>
        </xpath>

    </template>
</odoo>
