<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_inherit_radian" inherit_id="account.report_invoice_document">
        
        <!-- 1. BLOQUE DE INTEGRIDAD (V15): VARIABLES TÉCNICAS PARA COMPATIBILIDAD -->
        <xpath expr="//t[@t-call='web.external_layout']" position="inside">
            <t t-set="address" t-value="None"/>
            <t t-set="information_block" t-value="None"/>
            <t t-set="layout_document_title" t-value="o.name"/>
        </xpath>

        <!-- 2. OCULTAR EL CONTENIDO ORIGINAL (MANTIENE NODOS PARA XPATHS EXTERNOS) -->
        <xpath expr="//div[@class='page']" position="attributes">
            <attribute name="style">display: none !important;</attribute>
        </xpath>

        <!-- 3. INYECTAR NUESTRO DISEÑO PREMIUM (VERSIÓN 15) -->
        <xpath expr="//div[@class='page']" position="after">
            <!-- LÓGICA DE DATOS V15 -->
            <t t-set="cufe_final" t-value="getattr(o, 'l10n_co_edi_cufe_cude_ref', False) or (o.l10n_co_dian_document_ids.sorted('id', reverse=True)[:1].identifier if 'l10n_co_dian_document_ids' in o._fields and o.l10n_co_dian_document_ids else False)"/>
            <t t-set="qr_final" t-value="getattr(o, 'l10n_co_edi_qr_code', False) or (('https://catalogo-vpfe.dian.gov.co/document/searchqr?documentkey=' + cufe_final) if cufe_final else False)"/>

            <div class="page guapante-v15" style="margin-top: -15px !important;">
                <style type="text/css">
                    .guapante-v15 {
                        font-size: 8.4pt !important;
                        color: #000 !important;
                        font-family: 'Helvetica', sans-serif !important;
                    }
                    .guapante-v15 .o_main_table {
                        border: 1.2pt solid #000 !important;
                        border-collapse: collapse !important;
                        margin-top: 10px !important;
                    }
                    .guapante-v15 .o_main_table thead th {
                        background-color: #333 !important;
                        color: #fff !important;
                        border: 1.2pt solid #000 !important;
                        padding: 6px !important;
                        text-transform: uppercase;
                    }
                    .guapante-v15 .o_main_table tbody td {
                        border: 1pt solid #000 !important;
                        padding: 5px !important;
                    }
                    .guapante-v15 .row-total-green {
                        background-color: #28a745 !important; 
                        color: #fff !important;
                        font-weight: bold;
                    }
                    .guapante-v15 .totals-table {
                        border: 1.2pt solid #000 !important;
                        width: 100%;
                        border-collapse: collapse;
                    }
                    .guapante-v15 .totals-table td {
                        border: 1pt solid #000 !important;
                        padding: 5px !important;
                    }
                </style>

                <!-- CABECERA -->
                <div class="row g-0 mb-3">
                    <div class="col-8">
                        <div class="row g-0">
                            <div class="col-4">
                                <img t-att-src="'/web/image/res.company/%s/logo' % o.company_id.id" style="max-height: 90px; max-width: 125px; object-fit: contain;" alt="Logo"/>
                            </div>
                            <div class="col-8 ps-3" style="line-height: 1.3;">
                                <strong style="font-size: 11pt;" t-field="o.company_id.name"/><br/>
                                <strong>NIT:</strong> <span t-esc="o.company_id.vat"/><t t-if="'l10n_co_verification_digit' in o.company_id.partner_id._fields and o.company_id.partner_id.l10n_co_verification_digit">-<span t-esc="o.company_id.partner_id.l10n_co_verification_digit"/></t><br/>
                                <span t-field="o.company_id.street"/><br/>
                                <span t-field="o.company_id.city"/> - <span t-field="o.company_id.state_id.name"/><br/>
                                <strong>Tel:</strong> <span t-esc="o.company_id.phone or o.company_id.mobile"/><br/>
                                <strong>Email:</strong> <span t-field="o.company_id.email"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div style="border: 1.2pt solid #000; padding: 6px; text-align: center; background-color: #f8f9fa;">
                            <span style="font-size: 8pt; font-weight: bold; display: block;">FACTURA ELECTRÓNICA DE VENTA</span>
                            <span style="font-size: 14pt; font-weight: bold;" t-field="o.name"/>
                        </div>
                        <table class="w-100 mt-2" style="border: 1.2pt solid #000; font-size: 8.4pt; border-collapse: collapse;">
                            <tr style="border-bottom: 1pt solid #000;">
                                <td class="p-1 ps-2"><strong>EMISIÓN:</strong></td>
                                <td class="p-1 pe-2 text-end"><span t-field="o.invoice_date"/></td>
                            </tr>
                            <tr style="border-bottom: 1pt solid #000;">
                                <td class="p-1 ps-2"><strong>VENCE:</strong></td>
                                <td class="p-1 pe-2 text-end"><span t-field="o.invoice_date_due"/></td>
                            </tr>
                            <tr>
                                <td class="p-1 ps-2"><strong>PAGO:</strong></td>
                                <td class="p-1 pe-2 text-end"><span t-field="o.invoice_payment_term_id.name"/></td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- BLOQUES DE CLIENTE -->
                <div style="border: 1.2pt solid #000; padding: 6px; margin-top: 10px;">
                    <div class="row g-0">
                        <div class="col-6 border-end pe-3">
                            <strong style="text-transform: uppercase; font-size: 7.5pt; display: block; border-bottom: 1pt solid #000; margin-bottom: 4px;">Información de Facturación</strong>
                            <strong>CLIENTE:</strong> <span t-field="o.partner_id.name"/><br/>
                            <strong>NIT/CC:</strong> <span t-field="o.partner_id.vat"/><br/>
                            <strong>DIRECCIÓN:</strong> <span t-field="o.partner_id.street"/><br/>
                            <strong>CIUDAD:</strong> <span t-field="o.partner_id.city"/> (<span t-field="o.partner_id.state_id.name"/>)
                        </div>
                        <div class="col-6 ps-3">
                            <strong style="text-transform: uppercase; font-size: 7.5pt; display: block; border-bottom: 1pt solid #000; margin-bottom: 4px;">Dirección de Despacho</strong>
                            <strong>RECEPTOR:</strong> <span t-field="o.partner_shipping_id.name"/><br/>
                            <strong>DIRECCIÓN:</strong> <span t-field="o.partner_shipping_id.street"/><br/>
                            <strong>CONTACTO:</strong> <span t-esc="o.partner_shipping_id.phone or o.partner_id.phone"/>
                        </div>
                    </div>
                </div>

                <!-- TABLA DE PRODUCTOS -->
                <table class="o_main_table table table-sm mt-3">
                    <thead>
                        <tr>
                            <th class="text-start">Descripción</th>
                            <th class="text-end" style="width: 10%;">Cant.</th>
                            <th class="text-end" style="width: 15%;">Precio Unit.</th>
                            <th class="text-end" style="width: 10%;">Imp.</th>
                            <th class="text-end" style="width: 15%;">Importe</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.id), reverse=True)" t-as="line">
                            <tr>
                                <td>
                                    <t t-if="line.product_id">
                                        <span t-esc="'[%s] %s' % (line.product_id.default_code, line.product_id.name) if line.product_id.default_code else line.product_id.name"/>
                                    </t>
                                    <t t-else="">
                                        <span t-field="line.name"/>
                                    </t>
                                </td>
                                <td class="text-end"><span t-field="line.quantity"/></td>
                                <td class="text-end"><span t-field="line.price_unit"/></td>
                                <td class="text-end"><span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))"/></td>
                                <td class="text-end"><span t-field="line.price_subtotal"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- TOTALES Y LEGAL -->
                <div class="row g-0 mt-3" style="page-break-inside: avoid;">
                    <div class="col-7 pe-4">
                        <div class="row g-0">
                            <div class="col-4 text-center" t-if="qr_final">
                                <img t-attf-src="/report/barcode/?barcode_type=QR&amp;value={{ qr_final }}&amp;width=95&amp;height=95" style="max-height: 90px; max-width: 90px; border: 0.5pt solid #eee;" alt="QR"/>
                            </div>
                            <div t-attf-class="{{ qr_final and 'col-8 ps-2' or 'col-12' }}">
                                <t t-if="cufe_final">
                                    <div style="font-size: 7pt; color: #333; line-height: 1.2;">
                                        <strong>CUFE:</strong> <span style="word-break: break-all;" t-esc="cufe_final"/>
                                    </div>
                                </t>
                                <div style="font-size: 6.5pt; color: #444; font-style: italic; margin-top: 8px; line-height: 1.3;">
                                    Factura generada por Software Propio de COMERCIALIZADORA Y PRODUCTORA GUAPANTE S.A.S. Se asimila a una letra de cambio (Art. 774 del C.Cio).
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-5">
                        <table class="totals-table">
                            <tr>
                                <td><strong>SUBTOTAL</strong></td>
                                <td class="text-end"><span t-field="o.amount_untaxed"/></td>
                            </tr>
                            <t t-foreach="o.line_ids.filtered(lambda l: l.display_type == 'tax')" t-as="tax">
                                <tr>
                                    <td><strong t-esc="tax.name"/></td>
                                    <td class="text-end"><span t-field="tax.price_subtotal"/></td>
                                </tr>
                            </t>
                            <tr class="row-total-green">
                                <td class="p-2"><strong>TOTAL A PAGAR</strong></td>
                                <td class="text-end p-2"><strong><span t-field="o.amount_total"/></strong></td>
                            </tr>
                        </table>
                        <div style="font-size: 8pt; font-weight: bold; margin-top: 5px; text-align: right;">
                            VALOR EN LETRAS: <span t-esc="o.amount_to_words or ''" style="text-transform: uppercase;"/>
                        </div>
                    </div>
                </div>

                <!-- FOOTER -->
                <div class="mt-4 text-center" style="font-size: 8pt; border-top: 1.2pt solid #000; padding-top: 10px;">
                    <strong>PAGO:</strong> <span t-field="o.payment_reference"/> | 
                    <strong>BANCO:</strong> <span t-field="o.partner_bank_id.bank_id.name"/> | 
                    <strong>CUENTA:</strong> <span t-field="o.partner_bank_id.acc_number"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
