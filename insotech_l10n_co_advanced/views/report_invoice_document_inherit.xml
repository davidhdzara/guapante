<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_inherit_insotech_advanced_table" inherit_id="account.report_invoice_document" priority="99999999">
        
        <!-- 1. CSS Aislado Premium B2B (Anulando el borde negro grueso nativo) -->
        <xpath expr="//table[@name='invoice_line_table']" position="before">
            <style type="text/css">
                /* Suavizamos los bordes y mejoramos la legibilidad */
                table[name="invoice_line_table"] {
                    border-collapse: collapse !important;
                    border: 1px solid #e0e0e0 !important;
                    font-size: 13px !important;
                }
                
                table[name="invoice_line_table"] thead th {
                    background-color: #14532d !important; 
                    color: #ffffff !important;
                    border: 1px solid #14532d !important; /* Mismo color de fondo para que no se vea una línea negra fea */
                    font-weight: 500 !important;
                    letter-spacing: 0.5px;
                    padding: 8px 10px !important;
                    vertical-align: middle !important;
                }

                table[name="invoice_line_table"] tbody td {
                    border: 1px solid #e0e0e0 !important; /* Borde interior gris claro, NO negro */
                    padding: 8px 10px !important;
                    vertical-align: middle !important;
                    color: #212529 !important; /* Color texto oscuro de tu paleta */
                }
                
                table[name="invoice_line_table"] tbody tr:nth-child(even) {
                    background-color: #f8f9fa; /* Zebra Striping muy sutil para facilitar la lectura */
                }
            </style>
        </xpath>

        <!-- Quitamos las clases bruscas nativas que ensucian -->
        <xpath expr="//table[@name='invoice_line_table']" position="attributes">
            <attribute name="class">table table-sm o_main_table mb-0</attribute>
        </xpath>

        <!-- 2. Redibujamos cabeceras (Limpias) -->
        <xpath expr="//table[@name='invoice_line_table']/thead/tr" position="replace">
            <tr>
                <th name="th_description" class="text-start"><span>DESCRIPCIÓN</span></th>
                <th name="th_quantity" class="text-end"><span>CANT</span></th>
                <th name="th_uom" class="text-center"><span>UD</span></th>
                <th name="th_priceunit" class="text-end"><span>V. UNITARIO</span></th>
                <th name="th_discount" t-if="display_discount" class="text-end"><span>DESC.%</span></th>
                <th name="th_taxes" class="text-end"><span>IMP.</span></th>
                <th name="th_subtotal" class="text-end"><span>IMPORTE</span></th>
            </tr>
        </xpath>

        <!-- 3. Redibujamos las filas de producto: Cero referencias, cero variantes, orden correcto -->
        <xpath expr="//t[@name='account_invoice_line_accountable']" position="replace">
            <t t-if="line.display_type == 'product'" name="account_invoice_line_accountable">
                <td name="account_invoice_line_name" class="text-start">
                    <span t-if="line.product_id" t-field="line.product_id.name" t-options="{'widget': 'text'}"/>
                    <span t-else="" t-field="line.name" t-options="{'widget': 'text'}"/>
                </td>
                <td name="td_quantity" class="text-end">
                    <span t-field="line.quantity"/>
                </td>
                <td name="td_uom" class="text-center">
                    <span t-field="line.product_uom_id.name" groups="uom.group_uom"/>
                </td>
                <td name="td_price_unit" class="text-end">
                    <span class="text-nowrap" t-field="line.price_unit"/>
                </td>
                <td name="td_discount" t-if="display_discount" class="text-end">
                    <span class="text-nowrap" t-field="line.discount"/>
                </td>
                <td name="td_taxes" class="text-end">
                    <t t-set="taxes" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_ids])"/>
                    <span t-out="taxes" id="line_tax_ids"/>
                </td>
                <td name="td_subtotal" class="text-end o_price_total">
                    <span class="text-nowrap" t-field="line.price_subtotal"/>
                </td>
            </t>
        </xpath>
        
        <!-- 5. Rediseño Estructurado del Bloque del Receptor (Cliente) -->
        <xpath expr="//div[hasclass('row')][1]" position="replace">
            <!-- Contenedor general enmarcado con líneas superiores e inferiores -->
            <div class="row mt-3 mb-4" style="border-top: 1px solid #14532d; border-bottom: 1px solid #14532d; padding: 12px 0;">
                
                <!-- Columna principal (Receptor) -->
                <div class="col-7">
                    <table class="table table-sm table-borderless mb-0" style="font-size: 13px; line-height: 1.2;">
                        <tbody>
                            <tr>
                                <td class="p-0 fw-bold" style="width: 25%; color: #495057;">RECEPTOR:</td>
                                <td class="p-0"><span t-field="o.partner_id.name" class="fw-bold"/></td>
                            </tr>
                            <tr t-if="o.partner_id.vat">
                                <td class="p-0 fw-bold" style="color: #495057;">NIT CLIENTE:</td>
                                <td class="p-0"><span t-field="o.partner_id.vat"/></td>
                            </tr>
                            <tr>
                                <td class="p-0 fw-bold" style="color: #495057;">DIRECCIÓN:</td>
                                <td class="p-0">
                                    <span t-if="o.partner_id.street" t-field="o.partner_id.street"/>
                                    <span t-if="o.partner_id.street2"> <span t-field="o.partner_id.street2"/></span>
                                    <span t-if="o.partner_id.city">, <span t-field="o.partner_id.city"/></span>
                                    <span t-if="o.partner_id.state_id">, <span t-field="o.partner_id.state_id.name"/></span>
                                </td>
                            </tr>
                            <tr t-if="o.partner_id.phone or o.partner_id.mobile">
                                <td class="p-0 fw-bold" style="color: #495057;">TELÉFONO:</td>
                                <td class="p-0">
                                    <span t-if="o.partner_id.phone" t-field="o.partner_id.phone"/>
                                    <span t-if="o.partner_id.phone and o.partner_id.mobile"> / </span>
                                    <span t-if="o.partner_id.mobile" t-field="o.partner_id.mobile"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Columna secundaria (Dirección de Envío, a la derecha) -->
                <div class="col-5" t-if="o.partner_shipping_id and (o.partner_shipping_id != o.partner_id)">
                    <table class="table table-sm table-borderless mb-0" style="font-size: 13px; line-height: 1.2;">
                        <tbody>
                            <tr>
                                <td class="p-0 fw-bold text-end" style="color: #495057;">DIRECCIÓN DE ENVÍO:</td>
                            </tr>
                            <tr>
                                <td class="p-0 text-end"><span t-field="o.partner_shipping_id.name" class="fw-bold"/></td>
                            </tr>
                            <tr>
                                <td class="p-0 text-end">
                                    <span t-if="o.partner_shipping_id.street" t-field="o.partner_shipping_id.street"/>
                                    <span t-if="o.partner_shipping_id.city">, <span t-field="o.partner_shipping_id.city"/></span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                
            </div>
        </xpath>

    </template>
</odoo>
