<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_inherit_radian" inherit_id="account.report_invoice_document">

        <!-- A. ESTILOS GLOBALES - MINIMALISTAS Y COMPACTOS -->
        <xpath expr="//div[hasclass('page')]" position="before">
            <style type="text/css">
                .page {
                    font-size: 8pt !important;
                    color: #000 !important;
                    font-family: Arial, sans-serif !important;
                }
                
                /* Tabla de Productos Compacta */
                .o_main_table {
                    border: 0.5pt solid #000 !important;
                    border-collapse: collapse !important;
                    margin-top: 10px !important;
                    width: 100% !important;
                }
                .o_main_table thead th {
                    background-color: #f2f2f2 !important;
                    border: 0.5pt solid #000 !important;
                    padding: 4px !important;
                    text-transform: uppercase;
                    font-size: 7pt !important;
                }
                .o_main_table tbody td {
                    border: 0.5pt solid #ccc !important;
                    padding: 2px 4px !important;
                    vertical-align: middle !important;
                }

                /* Logo y Encabezado */
                .guapante-logo {
                    max-height: 110px !important;
                    max-width: 110px !important;
                }
                .invoice-header-box {
                    border: 1.5pt solid #000;
                    padding: 10px;
                    text-align: center;
                    background-color: #ffffff;
                }
                .invoice-title {
                    font-size: 11pt;
                    font-weight: bold;
                    display: block;
                }
                .invoice-number {
                    font-size: 14pt;
                    font-weight: bold;
                    color: #000;
                }

                /* Sección de Información del Cliente */
                .customer-info-box {
                    border: 0.5pt solid #000;
                    padding: 5px;
                    margin-bottom: 10px;
                }
                .section-label {
                    font-weight: bold;
                    text-transform: uppercase;
                    font-size: 7pt;
                    border-bottom: 0.5pt solid #000;
                    margin-bottom: 3px;
                    display: block;
                }
            </style>
        </xpath>

        <!-- B. LIMPIEZA DE BLOQUES NATIVOS Y REDUNDANCIAS -->
        <!-- Odoo 18 usa t-set="address" y information_block; los vaciamos -->
        <xpath expr="//t[@t-set='address']" position="replace"><div/></xpath>
        <xpath expr="//t[@t-set='information_block']" position="replace"><div/></xpath>
        
        <!-- XPath Resiliente para el Título (evita ParseError si h2 no existe como tag directo) -->
        <xpath expr="//div[hasclass('page')]//span[@t-field='o.name']/.." position="replace">
            <div id="dummy_title_anchor"/>
        </xpath>

        <!-- C. NUEVA CABECERA PROFESIONAL -->
        <xpath expr="//div[@id='informations']" position="before">
            <div class="row mb-3">
                <!-- Logo e Información de Empresa (Izquierda) -->
                <div class="col-7 text-start">
                    <div class="row">
                        <div class="col-4">
                            <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" class="guapante-logo" alt="Logo"/>
                        </div>
                        <div class="col-8" style="font-size: 7pt; line-height: 1.1;">
                            <strong t-field="o.company_id.name"/><br/>
                            NIT: <span t-esc="o.company_id.vat"/><t t-if="o.company_id.partner_id and 'l10n_co_verification_digit' in o.company_id.partner_id._fields and o.company_id.partner_id.l10n_co_verification_digit">-<span t-esc="o.company_id.partner_id.l10n_co_verification_digit"/></t><br/>
                            <span t-field="o.company_id.street"/>, <span t-field="o.company_id.city"/><br/>
                            Tel: <span t-field="o.company_id.phone or o.company_id.mobile"/><br/>
                            <span t-field="o.company_id.email"/>
                        </div>
                    </div>
                </div>
                <!-- Box de Factura (Derecha) -->
                <div class="col-5">
                    <div class="invoice-header-box">
                        <span class="invoice-title">FACTURA ELECTRÓNICA DE VENTA</span>
                        <span class="invoice-number" t-field="o.name"/>
                    </div>
                    <table class="w-100 mt-2" style="font-size: 7pt;">
                        <tr>
                            <td><strong>FECHA FACTURA:</strong></td>
                            <td class="text-end"><span t-field="o.invoice_date"/></td>
                        </tr>
                        <tr>
                            <td><strong>FECHA VENCIMIENTO:</strong></td>
                            <td class="text-end"><span t-field="o.invoice_date_due"/></td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- Información del Cliente -->
            <div class="customer-info-box">
                <span class="section-label">Información del cliente</span>
                <div class="row">
                    <div class="col-7">
                        <strong><span t-field="o.partner_id.name"/></strong><br/>
                        NIT/CC: <span t-field="o.partner_id.vat"/><br/>
                        Dir: <span t-field="o.partner_id.street"/><t t-if="o.partner_id.street2">, <span t-field="o.partner_id.street2"/></t>
                    </div>
                    <div class="col-5 text-end">
                        Ciudad: <span t-field="o.partner_id.city"/><br/>
                        Tel: <span t-field="o.partner_id.phone or o.partner_id.mobile"/><br/>
                        Email: <span t-field="o.partner_id.email"/>
                    </div>
                </div>
            </div>
        </xpath>

        <!-- D. OPTIMIZACIÓN DE TABLA DE PRODUCTOS -->
        <xpath expr="//table[hasclass('o_main_table')]" position="attributes">
            <attribute name="class">table table-sm o_main_table</attribute>
            <attribute name="style">width: 100%; border: 0.5pt solid #000;</attribute>
        </xpath>

        <!-- E. TOTALES Y LETRAS -->
        <xpath expr="//div[@id='total']" position="after">
            <div class="row mt-2">
                <div class="col-8">
                    <p style="font-size: 6.5pt; color: #333; border: 0.5pt solid #aaa; padding: 5px;">
                        <strong>Nota Legal:</strong> Esta factura de venta se asimila en todos sus efectos a una letra de cambio según el Art. 774 del Código de Comercio. El comprador acepta y declara haber recibido real y materialmente la mercancía descrita.
                    </p>
                </div>
                <div class="col-4 text-end">
                    <div style="font-size: 8pt; font-weight: bold; border-top: 1pt solid #000; padding-top: 5px;">
                        IMPORTE TOTAL CON LETRA:
                    </div>
                    <div style="font-size: 7pt; text-transform: uppercase;">
                        <span t-esc="o.amount_to_words or ''"/>
                    </div>
                </div>
            </div>
        </xpath>

        <!-- F. LIMPIEZA DE COMUNICACIÓN -->
        <xpath expr="//p[@name='payment_communication']" position="replace">
            <div class="mt-2" style="font-size: 7pt;">
                <strong>REFERENCIA DE PAGO:</strong> <span t-field="o.payment_reference"/> | 
                <strong>BANCO:</strong> <span t-field="o.partner_bank_id.bank_id.name"/> | 
                <strong>CUENTA:</strong> <span t-field="o.partner_bank_id.acc_number"/>
            </div>
        </xpath>

    </template>
</odoo>
