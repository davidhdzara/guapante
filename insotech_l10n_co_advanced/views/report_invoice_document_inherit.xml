<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_inherit_radian" inherit_id="account.report_invoice_document">

        <!-- A. ESTILOS NUCLEARES - UNIFICACIÓN PORTAL Y PDF V4 -->
        <xpath expr="." position="inside">
            <style type="text/css">
                .page {
                    font-size: 8pt !important;
                    color: #000 !important;
                    font-family: Arial, sans-serif !important;
                    margin-top: -20px !important;
                }
                
                /* Layout Reset */
                .header, .footer { font-family: Arial, sans-serif !important; }

                /* Tabla de Productos Compacta */
                .o_main_table {
                    border: 0.8pt solid #000 !important;
                    border-collapse: collapse !important;
                    margin-top: 5px !important;
                    width: 100% !important;
                }
                .o_main_table thead th {
                    background-color: #333 !important;
                    color: #fff !important;
                    border: 0.5pt solid #000 !important;
                    padding: 4px !important;
                    text-transform: uppercase;
                    font-size: 7pt !important;
                }
                .o_main_table tbody td {
                    border: 0.5pt solid #ddd !important;
                    padding: 2px 4px !important;
                    vertical-align: middle !important;
                }

                /* Cabecera Guapante V4 */
                .guapante-logo-box {
                    width: 110px;
                    height: 110px;
                    display: flex;
                    align-items: center;
                    justify-content: flex-start;
                    overflow: hidden;
                    padding: 2px;
                }
                .guapante-logo {
                    max-height: 105px;
                    max-width: 105px;
                    object-fit: contain;
                }
                .invoice-header-box {
                    border: 1pt solid #000;
                    padding: 4px;
                    text-align: center;
                    background-color: #eee;
                }
                .invoice-title {
                    font-size: 8.5pt;
                    font-weight: bold;
                    display: block;
                    text-transform: uppercase;
                }
                .invoice-number {
                    font-size: 13pt;
                    font-weight: bold;
                }

                /* Bloques de Información */
                .info-box {
                    border: 0.8pt solid #000;
                    padding: 4px 6px;
                    margin-top: 5px;
                    margin-bottom: 5px;
                }
                .section-header {
                    font-weight: bold;
                    text-transform: uppercase;
                    font-size: 6.5pt;
                    border-bottom: 0.8pt solid #000;
                    display: block;
                    margin-bottom: 2px;
                }
                .info-text {
                    font-size: 7.5pt;
                    line-height: 1.1;
                }

                /* Totales e Integración Legal */
                .totals-row {
                    margin-top: 10px;
                }
                .legal-column {
                    font-size: 6.5pt;
                    color: #333;
                }
                .financial-column {
                    border: 0.8pt solid #000;
                }
            </style>
        </xpath>

        <!-- B. REEMPLAZO TOTAL DE LA ESTRUCTURA PARA CONTROL NUCELAR -->
        <!-- Cambiamos a basic_layout para evitar el encabezado duplicado de Odoo en el PDF -->
        <xpath expr="//t[@t-call='web.external_layout']" position="attributes">
            <attribute name="t-call">web.basic_layout</attribute>
        </xpath>

        <!-- C. RECONSTRUCCIÓN COMPLETA DEL CONTENIDO (DENTRO DE PÁGINA) -->
        <xpath expr="//div[hasclass('page')]" position="replace">
            <div class="page">
                <!-- 1. CABECERA PERSONALIZADA -->
                <div class="row g-0 mb-3">
                    <div class="col-7">
                        <div class="row g-0">
                            <div class="col-4">
                                <div class="guapante-logo-box">
                                    <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" class="guapante-logo" alt="Logo"/>
                                </div>
                            </div>
                            <div class="col-8 ps-2 info-text">
                                <strong style="font-size: 10pt;" t-field="o.company_id.name"/><br/>
                                <strong>NIT:</strong> <span t-esc="o.company_id.vat"/><t t-if="o.company_id.partner_id and 'l10n_co_verification_digit' in o.company_id.partner_id._fields and o.company_id.partner_id.l10n_co_verification_digit">-<span t-esc="o.company_id.partner_id.l10n_co_verification_digit"/></t><br/>
                                <span t-field="o.company_id.street"/><br/>
                                <span t-field="o.company_id.city"/>, <span t-field="o.company_id.state_id.name"/><br/>
                                <strong>Tel:</strong> <span t-esc="o.company_id.phone or o.company_id.mobile"/><br/>
                                <strong>Email:</strong> <span t-field="o.company_id.email"/><br/>
                                <strong>LUGAR DE EXPEDICIÓN:</strong> <span t-field="o.company_id.city"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-5">
                        <div class="invoice-header-box">
                            <span class="invoice-title">Factura Electrónica de Venta</span>
                            <span class="invoice-number" t-field="o.name"/>
                        </div>
                        <table class="w-100 mt-1 info-text" style="border: 0.5pt solid #ccc;">
                            <tr>
                                <td class="p-1"><strong>FECHA EMISIÓN:</strong></td>
                                <td class="text-end p-1"><span t-field="o.invoice_date"/></td>
                            </tr>
                            <tr>
                                <td class="p-1"><strong>FECHA VENCIMIENTO:</strong></td>
                                <td class="text-end p-1"><span t-field="o.invoice_date_due"/></td>
                            </tr>
                            <tr>
                                <td class="p-1"><strong>FORMA DE PAGO:</strong></td>
                                <td class="text-end p-1"><span t-field="o.invoice_payment_term_id.name"/></td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- 2. BLOQUE ADQUIRIENTE Y ENVÍO -->
                <div class="info-box">
                    <div class="row g-0 info-text">
                        <div class="col-6 border-end pe-2">
                            <span class="section-header">Información Adquiriente (Facturación)</span>
                            <strong>CLIENTE:</strong> <span t-field="o.partner_id.name"/><br/>
                            <strong>NIT/CC:</strong> <span t-field="o.partner_id.vat"/><br/>
                            <strong>DIRECCIÓN:</strong> <span t-field="o.partner_id.street"/><t t-if="o.partner_id.street2">, <span t-field="o.partner_id.street2"/></t><br/>
                            <strong>CIUDAD:</strong> <span t-field="o.partner_id.city"/> (<span t-field="o.partner_id.state_id.name"/>)<br/>
                            <strong>TELÉFONO:</strong> <span t-esc="o.partner_id.phone or o.partner_id.mobile"/>
                        </div>
                        <div class="col-6 ps-2">
                            <span class="section-header">Dirección de Envío (Despacho)</span>
                            <strong>RECEPTOR:</strong> <span t-field="o.partner_shipping_id.name"/><br/>
                            <strong>DIRECCIÓN:</strong> <span t-field="o.partner_shipping_id.street"/><t t-if="o.partner_shipping_id.street2">, <span t-field="o.partner_shipping_id.street2"/></t><br/>
                            <strong>CIUDAD:</strong> <span t-field="o.partner_shipping_id.city"/> (<span t-field="o.partner_shipping_id.state_id.name"/>)<br/>
                            <strong>CONTACTO:</strong> <span t-esc="o.partner_shipping_id.phone or o.partner_shipping_id.mobile or o.partner_id.phone"/><br/>
                            <strong>EMAIL:</strong> <span t-esc="o.partner_shipping_id.email or o.partner_id.email"/>
                        </div>
                    </div>
                </div>

                <!-- 3. TABLA DE PRODUCTOS (RECONSTRUIDA) -->
                <table class="o_main_table table table-sm mt-2" name="invoice_line_table">
                    <thead>
                        <tr>
                            <th name="th_description" class="text-start">Descripción</th>
                            <th name="th_quantity" class="text-end">Cant.</th>
                            <th name="th_priceunit" class="text-end">Precio Unit.</th>
                            <th name="th_taxes" class="text-end">Imp.</th>
                            <th name="th_subtotal" class="text-end">Importe</th>
                        </tr>
                    </thead>
                    <tbody class="invoice_tbody">
                        <t t-set="current_subtotal" t-value="0"/>
                        <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.id), reverse=True)"/>

                        <t t-foreach="lines" t-as="line">
                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>

                            <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                <t t-if="line.display_type == 'product'" name="account_invoice_line_accountable">
                                    <td name="account_invoice_line_name">
                                        <t t-if="line.product_id">
                                            <t t-set="formatted_name" t-value="'[%s] %s' % (line.product_id.default_code, line.product_id.name) if line.product_id.default_code else line.product_id.name"/>
                                            <span t-esc="formatted_name"/>
                                        </t>
                                        <t t-else="">
                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                        </t>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.quantity"/>
                                        <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.price_unit"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))" id="line_tax_ids"/>
                                    </td>
                                    <td class="text-end o_price_total">
                                        <span t-field="line.price_subtotal"/>
                                    </td>
                                </t>
                                <t t-elif="line.display_type == 'line_section'">
                                    <td colspan="99">
                                        <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                    </td>
                                    <t t-set="current_section" t-value="line"/>
                                    <t t-set="current_subtotal" t-value="0"/>
                                </t>
                                <t t-elif="line.display_type == 'line_note'">
                                    <td colspan="99">
                                        <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                    </td>
                                </t>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- 4. TOTALES E INTEGRACIÓN LEGAL -->
                <div class="row g-0 mt-3" style="page-break-inside: avoid;">
                    <div class="col-8 pe-3">
                        <div class="row g-0">
                            <!-- QR DIAN -->
                            <div class="col-2 text-center" t-if="o.insotech_dian_status == 'accepted' or o.l10n_co_edi_cufe_cude_ref">
                                 <t t-set="qr_string" t-value="o.l10n_co_edi_qr_code if 'l10n_co_edi_qr_code' in o and o.l10n_co_edi_qr_code else 'https://catalogo-vpfe.dian.gov.co/document/searchqr?documentkey=' + (o.l10n_co_edi_cufe_cude_ref or '')"/>
                                 <img t-attf-src="/report/barcode/?barcode_type=QR&amp;value={{ qr_string }}&amp;width=80&amp;height=80" style="max-height: 55px; max-width: 55px;" alt="QR DIAN"/>
                            </div>
                            <!-- Detalles Técnicos -->
                            <div t-attf-class="{{ (o.insotech_dian_status == 'accepted' or o.l10n_co_edi_cufe_cude_ref) and 'col-10 ps-2' or 'col-12' }}">
                                <t t-if="o.insotech_dian_status == 'accepted' or o.l10n_co_edi_cufe_cude_ref">
                                    <div style="font-size: 6.5pt; line-height: 1.1;">
                                        <strong>INFORMACIÓN DIAN:</strong> Res. <span t-esc="o.journal_id.l10n_co_edi_dian_authorization_number"/> de <span t-esc="o.journal_id.l10n_co_edi_dian_authorization_date"/> | Vigente hasta: <span t-esc="o.journal_id.l10n_co_edi_dian_authorization_end_date"/><br/>
                                        <strong>CUFE:</strong> <span style="word-break: break-all;" t-esc="o.l10n_co_edi_cufe_cude_ref or 'N/A'"/>
                                    </div>
                                </t>
                                <div class="mt-1" style="font-size: 7.5pt; font-weight: bold;">
                                    SON: <span t-esc="o.amount_to_words or ''"/>
                                </div>
                                <div class="mt-1" style="font-size: 6pt; color: #444; font-style: italic; line-height: 1.1;">
                                    <strong>Nota Legal (Título Valor):</strong> Esta factura de venta se asimila en todos sus efectos a una letra de cambio según el Art. 774 del Código de Comercio. El comprador acepta y declara haber recibido real y materialmente la mercancía descrita. Intereses de mora se cobrarán a la tasa máxima vigente.
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-4">
                        <table class="table table-sm" style="border: 0.5pt solid #000;">
                            <tr class="border-black">
                                <td><strong>Subtotal</strong></td>
                                <td class="text-end"><span t-field="o.amount_untaxed"/></td>
                            </tr>
                            <t t-foreach="o.line_ids.filtered(lambda line: line.display_type == 'tax')" t-as="tax_line">
                                <tr class="border-black">
                                    <td><strong t-esc="tax_line.name"/></td>
                                    <td class="text-end"><span t-field="tax_line.price_subtotal"/></td>
                                </tr>
                            </t>
                            <tr class="border-black o_total" style="background-color: #eee;">
                                <td><strong>TOTAL A PAGAR</strong></td>
                                <td class="text-end"><span t-field="o.amount_total"/></td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- 5. PIE DE PÁGINA / COMUNICACIÓN -->
                <div class="mt-3 info-text text-center" style="border-top: 0.5pt solid #eee; padding-top: 5px;">
                    <strong>REFERENCIA DE PAGO:</strong> <span t-field="o.payment_reference"/> | 
                    <strong>BANCO:</strong> <span t-field="o.partner_bank_id.bank_id.name"/> | 
                    <strong>CUENTA:</strong> <span t-field="o.partner_bank_id.acc_number"/><br/>
                    <span t-if="o.company_id.website">Visítanos en: <span t-field="o.company_id.website"/></span>
                </div>
            </div>
            
            <!-- FOOTER MANUAL PARA PDF -->
            <div class="footer o_standard_footer" style="font-size: 7pt; border-top: 0.5pt solid #eee;">
                <div class="text-center">
                    Página <span class="page"/> de <span class="topage"/>
                </div>
            </div>
        </xpath>

    </template>
</odoo>
