<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view -->
    <record id="guapante_wa_session_view_tree" model="ir.ui.view">
        <field name="name">guapante.wa.session.view.tree</field>
        <field name="model">guapante.wa.session</field>
        <field name="arch" type="xml">
            <tree string="Sesiones WhatsApp"
                  decoration-success="state == 'authenticated'"
                  decoration-warning="state in ('pending_confirm', 'pending_branch')"
                  decoration-danger="state == 'blocked'"
                  decoration-info="state == 'needs_human'"
                  decoration-muted="state in ('expired',)">
                <field name="whatsapp_number"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="last_activity"/>
                <field name="message_count"/>
                <field name="channel_id"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="guapante_wa_session_view_form" model="ir.ui.view">
        <field name="name">guapante.wa.session.view.form</field>
        <field name="model">guapante.wa.session</field>
        <field name="arch" type="xml">
            <form string="Sesión WhatsApp" create="false">
                <header>
                    <button name="action_release_to_bot"
                            string="Liberar al Bot"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'needs_human'"
                            confirm="¿Confirmas que el asesor ha atendido al cliente y el bot puede retomar la sesión?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending_nit,pending_branch,pending_confirm,authenticated,needs_human"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'needs_human'">
                        <strong>Requiere Asesor.</strong>
                        El asistente ha escalado esta sesión.
                        Motivo: <field name="escalation_reason" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <group string="Identificación">
                            <field name="whatsapp_number"/>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Actividad">
                            <field name="last_activity"/>
                            <field name="message_count"/>
                            <field name="nit_tries"/>
                            <field name="channel_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Historial de Conversación">
                            <field name="conversation_history"
                                   widget="ace"
                                   options="{'mode': 'json'}"
                                   readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="guapante_wa_session_action" model="ir.actions.act_window">
        <field name="name">Sesiones WhatsApp</field>
        <field name="res_model">guapante.wa.session</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_authenticated': 1}</field>
    </record>
</odoo>
