<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Placeholder parameters — configure via Settings or ir.config_parameter -->
    <record id="wa_assistant_claude_model" model="ir.config_parameter">
        <field name="key">guapante_wa_assistant.claude_model</field>
        <field name="value">claude-opus-4-7</field>
    </record>

    <record id="wa_assistant_session_ttl" model="ir.config_parameter">
        <field name="key">guapante_wa_assistant.session_ttl_minutes</field>
        <field name="value">30</field>
    </record>

    <!-- guapante_wa_assistant.anthropic_api_key must be set manually via:
         Settings > WA Assistant > API de Anthropic
         Never commit API keys to source control. -->

    <!-- LOW-3: Cron to expire stale sessions and clear conversation history -->
    <record id="ir_cron_wa_expire_sessions" model="ir.cron">
        <field name="name">WA Assistant: Expirar Sesiones Inactivas</field>
        <field name="model_id" ref="model_guapante_wa_session"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_sessions()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>
