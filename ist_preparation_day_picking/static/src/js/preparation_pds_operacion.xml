<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Pantalla A (PDS Operación) — ver preparation_pds_operacion.js.

         REDISEÑO (David/Tech Lead, 2026-11-10): tema oscuro del mockup
         kds-preparacion-del-dia.html, con CSS propio SOLO para esta pantalla
         (static/src/scss/preparation_pds_operacion.scss, todo bajo la clase
         raíz .o_guapante_pds). La TARJETA del producto conserva su
         estructura y contenido (David: «las tarjetas están perfectas»).
         Solo lectura: sin buscador, filtros ni acciones. -->
    <t t-name="ist_preparation_day_picking.PdsOperacionDisplay">
        <div class="o_action o_mrp_display o_guapante_pds">

            <div t-if="!state.loaded" class="gp-center">
                <span class="fa fa-spin fa-circle-o-notch fs-1"/>
            </div>

            <div t-elif="state.sessionExpired" class="gp-center">
                <div>
                    <p class="display-4">Sesión expirada</p>
                    <p class="fs-4">Vuelve a iniciar sesión en este computador para reanudar la pantalla.</p>
                </div>
            </div>

            <div t-elif="!state.hasSession" class="gp-center">
                <div>
                    <p class="display-4">Sin jornada abierta</p>
                    <p class="fs-4" t-esc="state.sessionDate"/>
                </div>
            </div>

            <t t-else="">
                <header class="gp-header">
                    <div class="gp-brand">
                        <div class="gp-mark">G</div>
                        <div>
                            <h1>Preparación del Día</h1>
                            <div class="gp-sub">Comercializadora y Productora Guapante · Bodega</div>
                        </div>
                    </div>
                    <div class="gp-cluster">
                        <span class="gp-state" t-esc="'● ' + sessionStateLabel"/>
                        <span class="gp-pill" t-esc="'Jornada ' + state.sessionDate"/>
                        <span t-attf-class="gp-pill #{state.columns.stopped.length ? 'alert' : ''}">
                            <t t-esc="state.columns.stopped.length"/> detenidos ahora
                        </span>
                        <span class="gp-pill live"><span class="gp-dot pulse"/><t t-esc="state.lastUpdatedLabel"/></span>
                    </div>
                </header>

                <div class="gp-tabs">
                    <button type="button" t-attf-class="gp-tab #{state.tab === 'tablero' ? 'active' : ''}" t-on-click="() => this.showTab('tablero')">📋 Tablero</button>
                    <button type="button" t-attf-class="gp-tab #{state.tab === 'desempeno' ? 'active' : ''}" t-on-click="() => this.showTab('desempeno')">👥 Desempeño por operario</button>
                    <button type="button" t-attf-class="gp-play #{state.rotating ? 'playing' : ''}" t-on-click="toggleRotation">
                        <span t-esc="state.rotating ? '⏸' : '▶'"/>
                        <span t-esc="state.rotating ? 'Rotación automática activa' : 'En pausa — datos se siguen actualizando'"/>
                    </button>
                </div>

                <div t-attf-class="gp-tab-panel #{state.tab === 'tablero' ? 'active' : ''}">
                <section class="gp-kpis">
                    <div class="gp-kpi hero">
                        <div class="gp-ring" t-attf-style="--pct: #{Math.round(state.globalProgressPct)}">
                            <span t-esc="Math.round(state.globalProgressPct) + '%'"/>
                        </div>
                        <div>
                            <div class="gp-label">Progreso general</div>
                            <div class="gp-hero-big"><t t-esc="state.doneLines"/> de <t t-esc="state.totalLines"/> líneas de picking completadas</div>
                        </div>
                    </div>
                    <div class="gp-kpi flag">
                        <div class="gp-label">Líneas de picking pendientes</div>
                        <div class="gp-value warn" t-esc="state.pendingLines"/>
                        <div class="gp-delta">1 línea = 1 producto de 1 pedido por recolectar</div>
                    </div>
                    <div class="gp-kpi flag">
                        <div class="gp-label">Líneas de picking completadas</div>
                        <div class="gp-value ok" t-esc="state.doneLines"/>
                        <div class="gp-delta">de <t t-esc="state.totalLines"/> en total</div>
                    </div>
                    <div class="gp-kpi flag">
                        <div class="gp-label">Cajas vs. Pickings (pedidos)</div>
                        <div t-attf-class="gp-value #{state.kpis.boxes_match ? 'ok' : 'warn'}">
                            <t t-esc="state.kpis.boxes_match ? '✓ ' : '⚠ '"/><t t-esc="state.kpis.boxes"/> <t t-esc="state.kpis.boxes_match ? '=' : '≠'"/> <t t-esc="state.kpis.pickings"/>
                        </div>
                        <div class="gp-delta"><t t-esc="state.kpis.draft_count"/> cotizaciones sin confirmar</div>
                    </div>
                    <div class="gp-kpi flag">
                        <div class="gp-label">Productos distintos</div>
                        <div class="gp-value" t-esc="state.kpis.distinct_products"/>
                        <div class="gp-delta"><t t-esc="state.kpis.not_started"/> sin iniciar</div>
                    </div>
                </section>

                <section class="gp-board">
                    <t t-foreach="statusOrder" t-as="status" t-key="status">
                        <div class="gp-col">
                            <div class="gp-col-head">
                                <div class="gp-col-title">
                                    <span t-attf-class="gp-sw #{status}"/>
                                    <h2 t-esc="statusLabels[status]"/>
                                </div>
                                <span class="gp-count" t-esc="state.columns[status].length"/>
                            </div>
                            <div class="gp-cards">
                                <t t-foreach="state.columns[status]" t-as="card" t-key="card.claim_id">
                                    <div class="o_mrp_display_record card border rounded m-0 mb-2">
                                        <div class="card-header">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="h6 mb-0 text-truncate" t-esc="card.product_name"/>
                                                <small t-attf-class="rounded-pill px-2 text-nowrap #{status === 'done' ? 'text-bg-success' : status === 'stopped' ? 'text-bg-danger' : status === 'in_progress' ? 'text-bg-warning' : 'text-bg-light border border-secondary'}"
                                                       t-esc="statusLabels[status]"/>
                                            </div>
                                        </div>
                                        <ul class="list-group list-group-flush">
                                            <li class="list-group-item">
                                                <t t-esc="card.done_line_count"/> de <t t-esc="card.total_line_count"/> órdenes
                                                <span t-if="card.zero_line_count" class="badge rounded-pill text-bg-warning ms-1">
                                                    (<t t-esc="card.zero_line_count"/> sin stock)
                                                </span>
                                            </li>
                                            <li t-if="elapsedLabel(card)" t-attf-class="list-group-item d-flex justify-content-between align-items-center #{isStoppedAlert(card, status) ? 'text-danger fw-bold' : ''}">
                                                <span>
                                                    <span t-if="isStoppedAlert(card, status)" class="fa fa-exclamation-triangle me-1"/>
                                                    <span class="fa fa-clock-o me-1"/><t t-esc="elapsedLabel(card)"/>
                                                </span>
                                                <span t-if="card.no_weigh_yet" class="badge rounded-pill text-bg-warning">Sin pesar aún</span>
                                            </li>
                                            <li t-if="card.expected_kg" class="list-group-item">
                                                <t t-esc="card.weighed_kg"/> / <t t-esc="card.expected_kg"/> kg
                                            </li>
                                            <li t-if="card.waiting_customers" class="list-group-item">
                                                <t t-esc="card.waiting_customers"/> cliente(s) esperando
                                            </li>
                                            <li t-if="card.operator_name" class="list-group-item">
                                                <span class="fa fa-user me-1"/><t t-esc="card.operator_name"/>
                                            </li>
                                            <li t-if="status === 'stopped'" class="list-group-item text-danger">
                                                <t t-esc="card.stop_reason_label"/>
                                            </li>
                                        </ul>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                </section>

                <section class="gp-extra">
                    <div class="gp-box">
                        <div class="gp-emoji">⚡</div>
                        <div>
                            <h3>Ritmo del día</h3>
                            <p t-if="state.rhythm.avg_kg_per_min !== null">
                                Promedio <strong t-esc="formatRate(state.rhythm.avg_kg_per_min) + ' kg equiv./min'"/> por operario activo ·
                                <t t-esc="state.rhythm.active_operators"/> operarios identificados por PIN ahora mismo
                            </p>
                            <p t-else="">
                                <t t-esc="state.rhythm.active_operators"/> operarios identificados por PIN ahora mismo · aún sin datos de ritmo
                            </p>
                        </div>
                    </div>
                    <div class="gp-box">
                        <div class="gp-emoji">🏆</div>
                        <div>
                            <h3>Mejor ritmo de hoy</h3>
                            <p t-if="state.rhythm.best">
                                <strong t-esc="state.rhythm.best.name"/> — <t t-esc="state.rhythm.best.lines"/> líneas completadas,
                                tiempo promedio <t t-esc="formatAvg(state.rhythm.best.avg_line_s)"/> por línea
                            </p>
                            <p t-else="">Aún no hay líneas completadas hoy</p>
                        </div>
                    </div>
                </section>
                </div>

                <div t-attf-class="gp-tab-panel #{state.tab === 'desempeno' ? 'active' : ''}">
                    <div t-if="!state.ranking.length" class="gp-center">Aún no hay líneas completadas hoy</div>
                    <section t-else="" class="gp-perf-grid">
                        <t t-foreach="state.ranking" t-as="op" t-key="op.employee_id">
                            <div t-attf-class="gp-perf-card #{op.rank === 1 ? 'top' : ''}">
                                <div class="gp-perf-row">
                                    <div class="gp-perf-name" t-esc="op.name"/>
                                    <div class="gp-perf-rank" t-esc="op.rank === 1 ? '🏆 1º del día' : op.rank + 'º'"/>
                                </div>
                                <div class="gp-perf-stats">
                                    <div>
                                        <div class="n" t-esc="op.lines"/>
                                        <div class="l">Líneas<t t-if="op.zero_lines"> (<t t-esc="op.zero_lines"/> sin stock)</t></div>
                                    </div>
                                    <div>
                                        <div class="n" t-esc="formatAvg(op.avg_line_s)"/>
                                        <div class="l">Prom./línea</div>
                                    </div>
                                    <div>
                                        <div class="n" t-esc="formatRate(op.kg_per_min)"/>
                                        <div class="l">Kg equiv./min</div>
                                    </div>
                                </div>
                                <div t-if="op.products.length" class="gp-perf-note">
                                    Productos de hoy: <t t-esc="op.products.join(', ')"/>
                                </div>
                            </div>
                        </t>
                    </section>
                    <p class="gp-footnote">
                        Orden por <strong>líneas atendidas</strong>, no por kg: un pedido grande de un solo producto no
                        debe «ganarle» a quien resolvió muchos pedidos chicos. El tiempo y los kg son contexto, no
                        deciden el puesto. Agrupado por el operario identificado por PIN.
                    </p>
                </div>
            </t>
        </div>
    </t>
</templates>
