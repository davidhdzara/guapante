<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Nivel 2 como client action propio — ver
         preparation_picking_level2_display.js. Misma barra hecha a
         mano que Nivel 1 (preparation_picking_level1_display.xml),
         con "← Productos" agregado a la izquierda (único botón de
         navegación propia de Nivel 2 — sin breadcrumb nativo no hay
         vuelta atrás sola).

         Tarjeta: misma estructura o_mrp_display_record que Nivel 1,
         agrupada por picking_status (Pendiente/Terminado) en vez de
         las 4 columnas de Nivel 1. -->
    <t t-name="ist_preparation_day_picking.PickingLinesDisplay">
        <div class="o_action o_mrp_display h-100 d-flex flex-column">
            <div class="o_control_panel d-flex flex-column gap-2 px-3 pt-2 pb-2 border-bottom">
                <div class="d-flex justify-content-between align-items-center gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-light text-nowrap" t-on-click="onClickBackToLevel1">
                            <i class="fa fa-arrow-left me-1"/>Productos
                        </button>
                        <strong t-esc="state.productName"/>
                    </div>
                    <!-- E6 (David/Tech Lead, 2026-11-02): mismas clases
                         nativas del buscador de Nivel 1, sin CSS propio. -->
                    <div class="o_cp_searchview d-flex input-group flex-grow-1" role="search" style="max-width: 260px;">
                        <div class="o_searchview form-control d-flex align-items-center py-1">
                            <i class="o_searchview_icon oi oi-search me-2"/>
                            <div class="o_searchview_input_container d-flex flex-grow-1">
                                <input type="text"
                                       class="o_searchview_input o_input flex-grow-1 border-0"
                                       placeholder="Buscar caja (#8) o cliente…"
                                       t-model="state.searchText"/>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <!-- Cronómetro L2 (lote 2B, Tech Lead 2026-11-04):
                             "arriba, junto a Actualizar/Cerrar" — ver
                             preparation_picking_visit_timer.js.
                             t-if (hallazgo de Tech Lead en la revisión
                             de 2/4): state.claimId no está en el
                             objeto inicial de useState() (se asigna en
                             _resolveClaim(), dentro de onWillStart) —
                             nunca montar el componente mientras valga
                             undefined. -->
                        <PickingVisitTimer t-if="state.claimId" claimId="state.claimId"/>
                        <button type="button" class="btn btn-light fa fa-refresh" title="Actualizar" t-on-click="onClickRefresh"/>
                        <button t-if="!pwaService.isScopedApp" type="button" class="btn btn-light text-nowrap" t-on-click="onClickClose">
                            <i class="fa fa-lg fa-sign-out me-md-1"/><span class="d-none d-md-inline">Cerrar</span>
                        </button>
                        <PickingOperatorHeader/>
                        <PickingInstallMenu/>
                    </div>
                </div>
            </div>

            <div t-if="state.loaded &amp;&amp; !state.lines.length" class="flex-grow-1 d-flex align-items-center justify-content-center">
                <div class="o_view_nocontent text-center">
                    <div class="o_nocontent_help">
                        <p class="o_view_nocontent_smiling_face">No hay cajas para este producto en este momento.</p>
                        <p>Actualiza la pantalla o vuelve a Productos.</p>
                    </div>
                </div>
            </div>

            <div t-else="" class="o_mrp_display_records flex-grow-1 m-2 d-flex gap-3 overflow-auto">
                <div class="d-flex flex-column w-25">
                    <div class="d-flex align-items-center mb-2 text-muted" style="height: 24px;">
                        <strong t-esc="'Pendiente (' + pendingLines.length + ')'"/>
                    </div>
                    <t t-foreach="pendingLines" t-as="line" t-key="line.id">
                        <div class="o_mrp_display_record card border rounded m-0 mb-2">
                            <div class="card-header">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="h6 mb-0">Caja #<t t-esc="line.daily_sequence"/></span>
                                    <small class="rounded-pill px-2 text-nowrap text-bg-light border border-secondary">Pendiente</small>
                                </div>
                            </div>
                            <ul class="list-group list-group-flush">
                                <li t-if="line.attribute_chips.length" class="list-group-item d-flex gap-1 flex-wrap">
                                    <t t-foreach="line.attribute_chips" t-as="chip" t-key="chip.id">
                                        <span t-attf-class="o_tag position-relative d-inline-flex align-items-center user-select-none mw-100 o_badge badge rounded-pill lh-1 o_tag_color_#{chip.color}">
                                            <div class="o_tag_badge_text text-truncate" t-esc="chip.name"/>
                                        </span>
                                    </t>
                                </li>
                                <li class="list-group-item">
                                    <t t-esc="line.main_customer_name"/> · <t t-esc="line.zone_name"/>
                                </li>
                                <li class="list-group-item">
                                    Pidió: <t t-esc="line.customer_qty_display"/> <t t-esc="line.customer_uom_label"/>
                                </li>
                            </ul>
                            <div class="card-footer d-flex align-items-center justify-content-between">
                                <span t-if="!line.qty_uom_label" class="text-danger small">
                                    Unidad no soportada — avisa a un administrador.
                                </span>
                                <PickingWeightInput t-else=""
                                                     value="line.is_done ? line.actual_kg : null"
                                                     onConfirm="(value) => this.onConfirmWeight(line, value)"
                                                     integer="line.qty_uom_label === 'und'"
                                                     placeholder="line.qty_uom_label === 'und' ? 'Unidades' : 'Peso (kg)'"/>
                                <button type="button" class="btn btn-light fa fa-sticky-note-o"
                                        title="Agregar nota" t-on-click="() => this.onAddNote(line)"/>
                            </div>
                        </div>
                    </t>
                </div>

                <div class="d-flex flex-column w-25">
                    <div class="d-flex align-items-center mb-2 text-muted" style="height: 24px;">
                        <button type="button"
                                class="btn btn-link p-0 text-muted text-decoration-none d-flex align-items-center gap-1"
                                t-on-click="toggleDoneGroup">
                            <i t-attf-class="fa #{isDoneFolded() ? 'fa-chevron-right' : 'fa-chevron-down'}"/>
                            <strong t-esc="'Terminado (' + doneLines.length + ')'"/>
                        </button>
                    </div>
                    <t t-if="!isDoneFolded()">
                        <t t-foreach="doneLines" t-as="line" t-key="line.id">
                            <div class="o_mrp_display_record card border rounded m-0 mb-2">
                                <div class="card-header">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="h6 mb-0">Caja #<t t-esc="line.daily_sequence"/></span>
                                        <small class="rounded-pill px-2 text-nowrap text-bg-success">Terminado</small>
                                    </div>
                                </div>
                                <ul class="list-group list-group-flush">
                                    <li t-if="line.attribute_chips.length" class="list-group-item d-flex gap-1 flex-wrap">
                                        <t t-foreach="line.attribute_chips" t-as="chip" t-key="chip.id">
                                            <span t-attf-class="o_tag position-relative d-inline-flex align-items-center user-select-none mw-100 o_badge badge rounded-pill lh-1 o_tag_color_#{chip.color}">
                                                <div class="o_tag_badge_text text-truncate" t-esc="chip.name"/>
                                            </span>
                                        </t>
                                    </li>
                                    <li class="list-group-item">
                                        <t t-esc="line.main_customer_name"/> · <t t-esc="line.zone_name"/>
                                    </li>
                                    <!-- E7 (David/Tech Lead, 2026-11-02): "despacho en 0" —
                                         el cliente pidió un producto que no hay, terminada
                                         en 0 en vez de pendiente. Solo en la tarjeta de
                                         Terminado: una Pendiente con peso en 0 todavía no
                                         es un despacho, solo no se ha pesado. -->
                                    <li t-if="line.actual_kg === 0" class="list-group-item text-danger">
                                        Sin stock — producto no disponible para despacho
                                    </li>
                                </ul>
                                <div class="card-footer d-flex align-items-center justify-content-between">
                                    <span t-if="!line.qty_uom_label" class="text-danger small">
                                        Unidad no soportada — avisa a un administrador.
                                    </span>
                                    <!-- E8 (David/Tech Lead, 2026-11-03): value con ternario
                                         sobre is_done (acá y en la tarjeta Pendiente arriba) —
                                         actual_kg es Float y vale 0.0 tanto en una línea sin
                                         pesar como en un despacho real en 0; lo que distingue
                                         "sin pesar" (input vacío) de "pesado en 0" (input
                                         muestra 0) es is_done, nunca actual_kg por sí solo. -->
                                    <PickingWeightInput t-else=""
                                                         value="line.is_done ? line.actual_kg : null"
                                                         onConfirm="(value) => this.onConfirmWeight(line, value)"
                                                         integer="line.qty_uom_label === 'und'"
                                                         placeholder="line.qty_uom_label === 'und' ? 'Unidades' : 'Peso (kg)'"/>
                                    <button type="button" class="btn btn-light fa fa-sticky-note-o"
                                            title="Agregar nota" t-on-click="() => this.onAddNote(line)"/>
                                </div>
                            </div>
                        </t>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
