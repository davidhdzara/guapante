<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Nivel 2 de Picking (Fase C): kanban a pantalla completa de las cajas
         (líneas) de UNA plantilla ya asignada — llega acá desde
         action_open_lines_kanban del claim (Asignarme/Continuar/Retomar).
         Mismo xmlid que el kanban temporal de la Fase B (reutilizado, no
         reemplazado): action_open_lines_kanban sigue apuntando a este
         mismo ir.ui.view. t-name="card" (sintaxis moderna, no kanban-box,
         mismo criterio que el kanban de claims). Cero CSS propio.

         js_class="guapante_picking_lines_kanban": solo para plegar por
         default el grupo "Terminado" al montar (group.toggle() — Tech
         Lead, Fase C) y para suscribirse al canal de bus de esta sesión y
         reaccionar a picking_operation_finished (ver
         preparation_picking_lines_kanban.js) — NO para refrescar la
         lista por bus: cada tablet edita su propio registro local vía el
         model de la vista, que ya mueve la tarjeta de Pendiente a
         Terminado solo con guardar, sin necesitar que nadie más la
         empuje. -->
    <record id="view_preparation_day_line_picking_kanban" model="ir.ui.view">
        <field name="name">guapante.preparation.day.line.picking.kanban</field>
        <field name="model">guapante.preparation.day.line</field>
        <field name="arch" type="xml">
            <kanban js_class="guapante_picking_lines_kanban"
                    class="o_kanban_small_column"
                    create="0" delete="0" group_create="0" group_delete="0"
                    group_edit="0" quick_create="0"
                    default_group_by="picking_status">
                <field name="is_done"/>
                <field name="picking_status"/>
                <field name="needs_weighing"/>
                <field name="estimated_kg"/>
                <field name="expected_kg_per_unit"/>
                <field name="daily_sequence"/>
                <field name="product_description"/>
                <field name="main_customer_name"/>
                <field name="customer_qty_display"/>
                <field name="customer_uom_label"/>
                <field name="actual_kg"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <strong>Caja #<field name="daily_sequence"/></strong>
                            <span t-if="record.picking_status.raw_value === 'done'"
                                  class="badge text-bg-success">Terminado</span>
                        </div>
                        <div><field name="product_description"/></div>
                        <div class="text-muted small"><field name="main_customer_name"/></div>
                        <div class="small">
                            Pidió: <field name="customer_qty_display"/> <field name="customer_uom_label"/>
                        </div>
                        <div t-if="!record.is_done.raw_value" class="mt-2">
                            <t t-if="record.needs_weighing.raw_value">
                                <field name="actual_kg" widget="scale_weight" string="Peso"/>
                            </t>
                            <t t-else="">
                                <button type="object" name="action_mark_line_ready"
                                        class="btn btn-sm btn-primary">Listo</button>
                            </t>
                        </div>
                        <div t-else="" class="mt-2 text-success small">
                            Registrado: <field name="actual_kg"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
