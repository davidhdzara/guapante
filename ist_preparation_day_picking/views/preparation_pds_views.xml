<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pantalla A (PDS Operación) — Tech Lead, plan aprobado 2026-11-06.
         ir.actions.client target=fullscreen, mismo patrón ya usado por
         preparation_day_product_claim.py/preparation_day.py/
         preparation_picking_level2_display.js en este repo. Sin `path`
         (a diferencia de action_picking_app): esta pantalla no es una
         PWA instalable aparte, se abre desde el menú de Odoo en el
         propio computador de Diana/Mauricio (David, corrección sobre
         el diseño original de "TV sin usuario" — ver análisis de
         seguridad). "Pantallas" es menú nuevo, solo
         group_preparation_reports_pds (Tema A, 2026-11-08) — ni el operario de Picking ni nadie
         más ve esta entrada. -->
    <record id="action_pds_operacion" model="ir.actions.client">
        <field name="name">PDS Operación</field>
        <field name="tag">guapante_pds_operacion</field>
        <field name="target">fullscreen</field>
    </record>

    <menuitem
        id="menu_pds_root"
        name="Pantallas"
        parent="ist_preparation_day.menu_preparation_day_root"
        groups="group_preparation_reports_pds,-group_preparation_admin"
        sequence="40"
    />
    <menuitem
        id="menu_pds_operacion"
        name="PDS Operación"
        parent="menu_pds_root"
        action="action_pds_operacion"
        groups="group_preparation_reports_pds,-group_preparation_admin"
    />

    <!-- PDS administrativo (Pantalla B), ENTREGA 1 (David/Tech Lead,
         2026-11-10): los reportes 1 «Pickings por operario» y 2 «Tiempo
         por operario» a pantalla completa, con sus vistas, filtros y
         permisos de siempre (mismos modelos y ACL de solo lectura de
         «Reportes y PDS»). Acción de servidor que devuelve la acción
         del reporte (con `views`, vía _for_xml_id) en target=fullscreen:
         una sola fuente de verdad, nada duplicado. El refresco automático
         llega en la ENTREGA 2. -->
    <record id="action_pds_admin_operator" model="ir.actions.server">
        <field name="name">PDS Pickings por operario</field>
        <field name="model_id" ref="model_guapante_preparation_operator_report"/>
        <field name="state">code</field>
        <field name="code">
action = env['ir.actions.actions']._for_xml_id('ist_preparation_day_picking.action_preparation_operator_report')
action['target'] = 'fullscreen'
action['name'] = 'PDS Pickings por operario'
        </field>
    </record>
    <record id="action_pds_admin_interval" model="ir.actions.server">
        <field name="name">PDS Tiempo por operario</field>
        <field name="model_id" ref="model_guapante_preparation_interval_report"/>
        <field name="state">code</field>
        <field name="code">
action = env['ir.actions.actions']._for_xml_id('ist_preparation_day_picking.action_preparation_interval_report_2')
action['target'] = 'fullscreen'
action['name'] = 'PDS Tiempo por operario'
        </field>
    </record>

    <menuitem
        id="menu_pds_admin_operator"
        name="PDS Pickings por operario"
        parent="menu_pds_root"
        action="action_pds_admin_operator"
        groups="group_preparation_reports_pds,-group_preparation_admin"
        sequence="20"
    />
    <menuitem
        id="menu_pds_admin_interval"
        name="PDS Tiempo por operario"
        parent="menu_pds_root"
        action="action_pds_admin_interval"
        groups="group_preparation_reports_pds,-group_preparation_admin"
        sequence="30"
    />
</odoo>
