<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pantalla A (PDS Operación) — Tech Lead, plan aprobado 2026-11-06.
         ir.actions.client target=fullscreen, mismo patrón ya usado por
         preparation_day_product_claim.py/preparation_day.py/
         preparation_picking_level2_display.js en este repo. Sin `path`
         (a diferencia de action_picking_app): esta pantalla no es una
         PWA instalable aparte, se abre desde el menú de Odoo en el
         propio computador de Diana/Mauricio (David, corrección sobre
         el diseño original de "TV sin usuario" — ver análisis de
         seguridad). "Pantallas" es menú nuevo, solo
         group_preparation_reports_pds (Tema A, 2026-11-08) — ni el operario de Picking ni nadie
         más ve esta entrada. -->
    <record id="action_pds_operacion" model="ir.actions.client">
        <field name="name">PDS Operación</field>
        <field name="tag">guapante_pds_operacion</field>
        <field name="target">fullscreen</field>
    </record>

    <menuitem
        id="menu_pds_root"
        name="Pantallas"
        parent="ist_preparation_day.menu_preparation_day_root"
        groups="group_preparation_reports_pds"
        sequence="40"
    />
    <menuitem
        id="menu_pds_operacion"
        name="PDS Operación"
        parent="menu_pds_root"
        action="action_pds_operacion"
        groups="group_preparation_reports_pds"
    />
</odoo>
