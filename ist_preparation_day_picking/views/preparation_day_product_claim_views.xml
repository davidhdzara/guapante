<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Nivel 1 de Picking: kanban agrupado por status, tarjeta = producto
         base (plantilla). Referencia visual verificada contra
         addons/mrp/views/mrp_production_views.xml (mrp_production_kanban_view):
         t-name="card" (sintaxis moderna, no kanban-box), badge de estado con
         clases nativas text-bg-* de Bootstrap. Cero CSS propio.

         js_class="guapante_picking_claims_kanban": un kanban nativo no se
         suscribe solo al bus.bus — el js_class le agrega esa suscripción al
         controller (ver preparation_picking_claims_kanban.js), igual que
         LiveRefreshAnchor hace para el form de la sesión. Con ~60 tarjetas
         como máximo (dato real de producción), un recargue completo del
         modelo al recibir la notificación es suficiente — no vale la pena
         actualizar tarjeta por tarjeta (decisión de Tech Lead). -->
    <record id="view_preparation_day_product_claim_kanban" model="ir.ui.view">
        <field name="name">guapante.preparation.day.product.claim.kanban</field>
        <field name="model">guapante.preparation.day.product.claim</field>
        <field name="arch" type="xml">
            <kanban js_class="guapante_picking_claims_kanban"
                    class="o_kanban_small_column"
                    create="0" delete="0" group_create="0" group_delete="0"
                    group_edit="0" quick_create="0"
                    default_group_by="status">
                <field name="status"/>
                <field name="product_tmpl_id"/>
                <field name="assigned_employee_id"/>
                <field name="stop_reason"/>
                <field name="stopped_by_employee_id"/>
                <field name="is_mine"/>
                <field name="pending_line_count"/>
                <field name="total_line_count"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <strong><field name="product_tmpl_id"/></strong>
                            <span t-attf-class="badge #{record.status.raw_value === 'done' ? 'text-bg-success' : record.status.raw_value === 'stopped' ? 'text-bg-danger' : record.status.raw_value === 'in_progress' ? 'text-bg-warning' : 'text-bg-secondary'}">
                                <field name="status"/>
                            </span>
                        </div>
                        <div class="text-muted small">
                            <field name="pending_line_count"/> de <field name="total_line_count"/> órdenes pendientes
                        </div>
                        <div t-if="record.status.raw_value === 'in_progress'" class="small">
                            <t t-if="record.is_mine.raw_value">Asignado a mí</t>
                            <t t-else="">Asignado a: <field name="assigned_employee_id"/></t>
                        </div>
                        <div t-if="record.status.raw_value === 'stopped'" class="text-danger small">
                            Motivo: <field name="stop_reason"/> — detenido por <field name="stopped_by_employee_id"/>
                        </div>
                        <footer class="d-flex justify-content-between align-items-center mt-2">
                            <button t-if="record.status.raw_value === 'pending'"
                                    type="object" name="action_assign"
                                    class="btn btn-sm btn-primary">Asignarme</button>
                            <button t-if="record.status.raw_value === 'in_progress' and record.is_mine.raw_value"
                                    type="object" name="action_open_lines_kanban"
                                    class="btn btn-sm btn-secondary">Continuar</button>
                            <button t-if="record.status.raw_value === 'stopped'"
                                    type="object" name="action_resume"
                                    class="btn btn-sm btn-primary">Retomar</button>
                            <div t-if="record.status.raw_value === 'in_progress' and record.is_mine.raw_value"
                                 class="dropdown">
                                <a href="#" class="dropdown-toggle o-no-caret btn btn-sm" data-bs-toggle="dropdown">
                                    <i class="fa fa-ellipsis-v"/>
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <a type="object" name="action_open_stop_wizard" class="dropdown-item" role="menuitem">Detener</a>
                                    <a type="object" name="action_release" class="dropdown-item" role="menuitem">Liberar</a>
                                </div>
                            </div>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Diálogo nativo (target=new) para pedir el motivo de detención —
         lista corta fija, sin texto libre. -->
    <record id="view_preparation_day_product_claim_stop_wizard_form" model="ir.ui.view">
        <field name="name">guapante.preparation.day.product.claim.stop.wizard.form</field>
        <field name="model">guapante.preparation.day.product.claim.stop.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="claim_id" invisible="1"/>
                <group>
                    <field name="reason" widget="radio"/>
                </group>
                <footer>
                    <button string="Detener" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
