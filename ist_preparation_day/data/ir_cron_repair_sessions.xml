<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- ============================================================
         CRON: Carga automática — respaldo (plan e4, 2026-10-30)
         Red de seguridad, no el mecanismo principal: agrega órdenes
         confirmadas que deberían tener línea de Preparación en una
         sesión draft/loaded de hoy o futura y no la tienen (un
         disparador que falló a mitad de camino), y renumera. Nunca
         toca sesiones 'done' ni crea sesiones nuevas.
         noupdate="1": si David ajusta el intervalo o lo desactiva
         desde Ajustes, una actualización del módulo no lo pisa.
         ============================================================ -->
    <record id="ir_cron_guapante_repair_sessions" model="ir.cron">
        <field name="name">Guapante: respaldo de carga automática (Preparación del Día)</field>
        <field name="model_id" ref="model_guapante_preparation_day"/>
        <field name="code">model._cron_repair_missing_orders()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
