<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Revisión diaria de la numeración de cajas (lote 4): hoy y mañana.
         Detecta duplicados, pedidos de la sesión sin número y cambios
         fuera del historial. Solo informa; nunca corrige. -->
    <record id="ir_cron_guapante_box_numbering" model="ir.cron">
        <field name="name">Guapante: revisión de numeración de cajas</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="code">model._cron_check_box_numbering()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
