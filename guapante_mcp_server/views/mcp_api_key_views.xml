<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view -->
    <record id="guapante_mcp_api_key_view_form" model="ir.ui.view">
        <field name="name">guapante.mcp.api.key.view.form</field>
        <field name="model">guapante.mcp.api.key</field>
        <field name="arch" type="xml">
            <form string="API Key MCP">
                <header>
                    <button
                        name="action_generate_token"
                        string="Generar Nuevo Token"
                        type="object"
                        class="btn-primary"
                        confirm="¿Generar un nuevo token? El anterior quedará inválido."
                    />
                    <button
                        name="action_revoke_token"
                        string="Revocar Token"
                        type="object"
                        class="btn-danger"
                        confirm="¿Revocar el token actual? La integración dejará de funcionar."
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre del cliente o integración"/></h1>
                    </div>
                    <group>
                        <group string="Configuración">
                            <field name="scope"/>
                            <field name="partner_id" />
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="expiry_date"/>
                            <field name="active"/>
                        </group>
                        <group string="Estado del Token">
                            <field name="token_prefix" readonly="True"/>
                            <field name="last_used" readonly="True"/>
                            <field name="request_count" readonly="True"/>
                        </group>
                    </group>
                    <group string="Notas">
                        <field name="notes" nolabel="True" placeholder="Descripción del uso o integración..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree view -->
    <record id="guapante_mcp_api_key_view_tree" model="ir.ui.view">
        <field name="name">guapante.mcp.api.key.view.tree</field>
        <field name="model">guapante.mcp.api.key</field>
        <field name="arch" type="xml">
            <list string="API Keys MCP" decoration-muted="not active">
                <field name="name"/>
                <field name="scope"/>
                <field name="partner_id"/>
                <field name="token_prefix"/>
                <field name="expiry_date"/>
                <field name="last_used"/>
                <field name="request_count"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="guapante_mcp_api_key_action" model="ir.actions.act_window">
        <field name="name">API Keys MCP</field>
        <field name="res_model">guapante.mcp.api.key</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay API Keys configuradas.
            </p>
            <p>Crea una API Key para permitir que asistentes de IA (Claude Desktop, apps empresariales)
               se conecten al servidor MCP de Guapante.</p>
        </field>
    </record>
</odoo>
