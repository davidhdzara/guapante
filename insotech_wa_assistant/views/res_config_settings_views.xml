<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_wa_assistant" model="ir.ui.view">
        <field name="name">res.config.settings.view.wa.assistant</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="WA Assistant" string="WA Assistant" name="insotech_wa_assistant" groups="insotech_mcp_server.group_mcp_admin">
                    <block title="Asistente WhatsApp" id="wa_assistant_settings">
                        <setting string="Identidad del Bot" help="Cómo se presenta el asistente a los clientes.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="wa_bot_name" class="col-lg-4 o_light_label"/>
                                    <field name="wa_bot_name" class="col-lg-8" placeholder="Ej: Sofía, Asistente..."/>
                                </div>
                                <div class="row mt8">
                                    <label for="wa_company_description" class="col-lg-4 o_light_label"/>
                                    <field name="wa_company_description" class="col-lg-8" placeholder="Ej: empresa colombiana de frutas y verduras"/>
                                </div>
                            </div>
                        </setting>

                        <setting string="Escalación a Asesor" help="Canal de Discuss donde se notifica cuando un cliente solicita un asesor humano.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="wa_escalation_channel_id" class="col-lg-4 o_light_label"/>
                                    <field name="wa_escalation_channel_id" class="col-lg-8"/>
                                </div>
                            </div>
                        </setting>

                        <setting string="API de Anthropic" help="Credenciales y modelo para el asistente de IA.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="wa_anthropic_api_key" class="col-lg-4 o_light_label"/>
                                    <field name="wa_anthropic_api_key" class="col-lg-8" password="True"/>
                                </div>
                                <div class="row mt8">
                                    <label for="wa_claude_model" class="col-lg-4 o_light_label"/>
                                    <field name="wa_claude_model" class="col-lg-8"/>
                                </div>
                            </div>
                        </setting>

                        <setting string="Sesiones" help="Tiempo de inactividad antes de que una sesión expire.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="wa_session_ttl_minutes" class="col-lg-4 o_light_label"/>
                                    <field name="wa_session_ttl_minutes" class="col-lg-8"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
