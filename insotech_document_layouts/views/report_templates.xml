<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         InSoTech Premium Layout — External Layout Template
         wkhtmltopdf-safe: NO flexbox, NO CSS3 gradients.
         Uses border-bottom for accent, float/table for layout.
         ============================================================ -->
    <template id="external_layout_insotech">
        <!-- HEADER -->
        <div t-attf-class="o_company_#{company.id}_layout header o_report_layout_insotech_header">
            <div class="row">
                <!-- Left: Logo + Tagline -->
                <div class="col-5">
                    <img t-if="company.logo"
                         class="o_company_logo"
                         t-att-src="image_data_uri(company.logo)"
                         alt="Logo"
                         style="max-height: 50px; max-width: 180px;"/>
                    <div t-if="company.report_header"
                         t-field="company.report_header"
                         class="o_company_tagline"/>
                </div>
                <!-- Right: Vacío — info empresa va en el body de cada reporte -->
                <div class="col-7" name="company_address"/>
            </div>
        </div>

        <!-- ARTICLE / BODY -->
        <t t-set="layout_background_url"
           t-value="'data:image/png;base64,%s' % company.layout_background_image.decode('utf-8') if company.layout_background_image and company.layout_background == 'Custom' else
                '/base/static/img/demo_logo_report.png' if company.layout_background == 'Demo logo' else ''" />
        <div t-attf-class="o_company_#{company.id}_layout article o_report_layout_insotech o_table_striped o_snail_mail {{'o_report_layout_background' if company.layout_background != 'Blank' else ''}}"
             t-attf-style="{{ 'background-image: url(%s);' % layout_background_url if layout_background_url else '' }}"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">
            <h2 t-out="layout_document_title"/>
            <t t-call="web.address_layout"/>
            <t t-out="0"/>
        </div>

        <!-- FOOTER -->
        <div t-attf-class="footer o_company_#{company.id}_layout o_report_layout_insotech_footer {{report_type != 'pdf' and 'mt-auto'}}">
            <div class="o_footer_content text-center" style="padding-top: 4px;">
                <div t-field="company.report_footer" style="font-size: 9px; line-height: 1.4; color: #6B7280;"/>
                <div t-if="report_type == 'pdf' and display_name_in_footer" style="font-size: 8px; color: #9CA3AF; margin-top: 2px;">
                    <span t-out="o.name"/>
                </div>
                <div t-if="report_type == 'pdf'" style="font-size: 8px; color: #9CA3AF;">
                    <span class="page"/> / <span class="topage"/>
                </div>
            </div>
        </div>
    </template>

    <!-- ============================================================
         Invoice-Specific External Layout
         Técnica guapante: Layout limpio sin h2, sin address_layout,
         sin company_address en el header.
         El invoice template inyecta todo en el body.
         ============================================================ -->
    <template id="external_layout_invoice">
        <t t-set="company" t-value="o.company_id if o and 'company_id' in o else res_company"/>
        <t t-set="display_name_in_footer" t-value="True"/>

        <!-- HEADER: Solo logo + tagline -->
        <div t-attf-class="o_company_#{company.id}_layout header o_report_layout_insotech_header">
            <div class="row">
                <div class="col-12">
                    <img t-if="company.logo"
                         class="o_company_logo"
                         t-att-src="image_data_uri(company.logo)"
                         alt="Logo"
                         style="max-height: 50px; max-width: 180px;"/>
                    <div t-if="company.report_header"
                         t-field="company.report_header"
                         class="o_company_tagline"/>
                </div>
            </div>
        </div>

        <!-- ARTICLE: Limpio — sin h2, sin address_layout -->
        <t t-set="layout_background_url"
           t-value="'data:image/png;base64,%s' % company.layout_background_image.decode('utf-8') if company.layout_background_image and company.layout_background == 'Custom' else
                '/base/static/img/demo_logo_report.png' if company.layout_background == 'Demo logo' else ''" />
        <div t-attf-class="o_company_#{company.id}_layout article o_report_layout_insotech o_table_striped {{'o_report_layout_background' if company.layout_background != 'Blank' else ''}}"
             t-attf-style="{{ 'background-image: url(%s);' % layout_background_url if layout_background_url else '' }}"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">
            <!-- Sin h2, sin address_layout → el invoice template controla todo -->
            <t t-out="0"/>
        </div>

        <!-- FOOTER: Idéntico al layout principal -->
        <div t-attf-class="footer o_company_#{company.id}_layout o_report_layout_insotech_footer"
             t-att-class="report_type != 'pdf' and 'mt-auto'">
            <div class="o_footer_content text-center" style="padding-top: 4px;">
                <div t-field="company.report_footer" style="font-size: 9px; line-height: 1.4; color: #6B7280;"/>
                <div t-if="report_type == 'pdf' and display_name_in_footer" style="font-size: 8px; color: #9CA3AF; margin-top: 2px;">
                    <span t-out="o.name"/>
                </div>
                <div t-if="report_type == 'pdf'" style="font-size: 8px; color: #9CA3AF;">
                    <span class="page"/> / <span class="topage"/>
                </div>
            </div>
        </div>
    </template>

    <!-- ============================================================
         Dynamic Company Styles — Inherit styles_company_report
         Uses company primary/secondary colors for accents.
         wkhtmltopdf-safe: border colors, background tints via mix().
         ============================================================ -->
    <template id="styles_company_report_insotech" inherit_id="web.styles_company_report">
        <xpath expr="//t[@t-foreach='company_ids']" position="inside">
            <t t-if="layout == 'insotech_document_layouts.external_layout_insotech'">
                /* InSoTech Layout — Dynamic company colors */
                &amp;.o_report_layout_insotech_header {
                    border-bottom-color: <t t-esc="primary"/> !important;
                }

                &amp;.o_report_layout_insotech {

                    h2 {
                        color: <t t-esc="primary"/>;
                    }

                    /* Informations labels + accent bar */
                    #informations {
                        border-left-color: <t t-esc="primary"/> !important;

                        strong {
                            color: <t t-esc="primary"/>;
                        }
                    }

                    /* Table header bottom border */
                    .o_main_table thead th {
                        border-bottom-color: <t t-esc="secondary"/>;
                    }

                    /* Section rows — accent bar + tinted background */
                    .o_line_section td {
                        border-left-color: <t t-esc="primary"/> !important;
                        background-color: mix(white, <t t-esc="primary"/>, 94%) !important;
                        color: <t t-esc="primary"/> !important;
                    }

                    /* Total row emphasis */
                    .o_total td {
                        border-top-color: <t t-esc="primary"/> !important;

                        strong {
                            color: <t t-esc="primary"/>;
                        }
                    }
                }

                /* Footer line */
                &amp;.o_report_layout_insotech_footer {
                    border-top-color: mix(white, <t t-esc="secondary"/>, 50%) !important;
                }
            </t>
        </xpath>
    </template>
</odoo>
