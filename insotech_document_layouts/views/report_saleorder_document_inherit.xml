<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- BYPASS: Force sale order to use Guapante layout -->
        <template id="report_saleorder_document_inherit_bypass" inherit_id="sale.report_saleorder_document" priority="99999">
            <xpath expr="//t[@t-call='web.external_layout']" position="attributes">
                <attribute name="t-call">insotech_document_layouts.external_layout_guapante</attribute>
            </xpath>
        </template>
    </data>
</odoo>
