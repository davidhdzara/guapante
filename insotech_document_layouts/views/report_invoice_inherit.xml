<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- EXTERNAL LAYOUT GUAPANTE (Header + Article + Footer) -->
        <template id="external_layout_guapante">
            <t t-set="company" t-value="company or o.company_id"/>
            
            <!-- 1. HEADER -->
            <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">
                <div class="row align-items-center" style="margin-top: 15px;">
                    <div class="col-5">
                        <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 130px; max-width: 100%; object-fit: contain;" alt="Logo"/>
                    </div>
                    <div class="col-7 text-end" style="color: #495057; font-size: 13px; line-height: 1.3;">
                        <div name="company_address">
                            <strong t-if="o.company_id.name" t-field="o.company_id.name" style="font-size: 16px; font-weight: 900; letter-spacing: 0.5px; color: #14532d; display: block; margin-bottom: 4px;"/>
                            <div style="font-size: 12px; margin-top: 5px;">
                                <div t-if="o.company_id.vat"><strong style="color: #14532d;">NIT:</strong> <span t-field="o.company_id.vat"/></div>
                                <div t-if="o.company_id.street">
                                    <span t-field="o.company_id.street"/> 
                                    <span t-if="o.company_id.street2"> <span t-field="o.company_id.street2"/></span>
                                </div>
                                <div t-if="o.company_id.city">
                                    <span t-field="o.company_id.city"/>
                                    <span t-if="o.company_id.state_id">, <span t-field="o.company_id.state_id.name"/></span>
                                </div>
                                <div t-if="o.company_id.phone or o.company_id.email" class="mt-1">
                                    <span t-if="o.company_id.phone"><strong style="color: #14532d;">Tel:</strong> <span t-field="o.company_id.phone"/></span>
                                    <span t-if="o.company_id.phone and o.company_id.email" style="margin: 0 4px;">|</span>
                                    <span t-if="o.company_id.email"><strong style="color: #14532d;">Email:</strong> <span t-field="o.company_id.email"/></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div style="border-bottom: 2px solid #14532d; margin-top: 20px; width: 100%;"></div>
            </div>

            <!-- 2. ARTICLE -->
            <div t-attf-class="article o_report_layout_standard o_company_#{company.id}_layout" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
                <t t-out="0"/>
            </div>

            <!-- 3. FOOTER -->
            <div t-attf-class="footer o_standard_footer o_company_#{company.id}_layout">
                <div class="text-center" style="border-top: 1px solid #14532d; padding-top: 10px;">
                    <div t-if="report_type == 'pdf'" class="text-muted fw-bold" style="font-size: 11px;">
                        Página: <span class="page"/> / <span class="topage"/>
                    </div>
                </div>
            </div>
        </template>

        <!-- BYPASS: Force invoice to use Guapante layout -->
        <template id="report_invoice_document_inherit_bypass" inherit_id="account.report_invoice_document" priority="99999">
            <xpath expr="//t[@t-call='web.external_layout']" position="attributes">
                <attribute name="t-call">insotech_document_layouts.external_layout_guapante</attribute>
            </xpath>
        </template>

        <!-- INVOICE TABLE AND LAYOUT CUSTOMIZATIONS -->
        <template id="report_invoice_document_inherit_table" inherit_id="account.report_invoice_document" priority="99999999">
        
        <!-- 1. CSS -->
        <xpath expr="//table[@name='invoice_line_table']" position="before">
            <style type="text/css">
                table[name="invoice_line_table"] { border-collapse: collapse !important; border: 1px solid #e0e0e0 !important; font-size: 13px !important; }
                table[name="invoice_line_table"] thead th { background-color: #14532d !important; color: #ffffff !important; border: 1px solid #14532d !important; font-weight: 500 !important; letter-spacing: 0.5px; padding: 8px 10px !important; vertical-align: middle !important; }
                table[name="invoice_line_table"] tbody td { border: 1px solid #e0e0e0 !important; padding: 8px 10px !important; vertical-align: middle !important; color: #212529 !important; }
                .res_partner_address_table td { border: none !important; }
                #total table { border-collapse: collapse !important; border: 1px solid #14532d !important; border-radius: 4px; margin-top: 15px; }
                #total table tr { border-bottom: 1px solid #e0e0e0 !important; }
                #total table td.text-start, #total table td:first-child { background-color: #f8f9fa !important; font-weight: bold !important; color: #495057 !important; padding-left: 10px !important; }
                #total table tr.o_total td, #total table tr.o_total strong { background-color: #14532d !important; color: white !important; font-size: 16px !important; font-weight: 800 !important; }
                
                /* Hide native elements replaced by our B2B block */
                .row.address, address { display: none !important; }
                .address strong { display: none !important; }
                .page h2, .page h3 { display: none !important; }
                p[name="payment_term"], div[name="payment_term"], #payment_term { display: none !important; }
                
                /* DIAN complement block styling */
                #complement { 
                    clear: both !important;
                    display: block !important;
                    width: 100% !important;
                    font-size: 11px !important; 
                    margin-top: 15px !important; 
                    border: 1px solid #14532d !important; 
                    padding: 10px 15px !important; 
                    border-radius: 4px;
                    background-color: #fcfcfd;
                }
                
                /* Compact QR */
                #complement .row:first-child { align-items: center !important; }
                #complement .col-4 { 
                    width: 130px !important; 
                    flex: 0 0 130px !important; 
                    max-width: 130px !important; 
                    padding-right: 0 !important; 
                }
                #complement img { 
                    width: 110px !important; 
                    max-width: 110px !important; 
                    height: auto !important; 
                    margin: 0 auto; 
                }
                
                /* Expand text area */
                #complement .col-8 { 
                    width: calc(100% - 130px) !important; 
                    flex: 0 0 calc(100% - 130px) !important; 
                    max-width: calc(100% - 130px) !important; 
                    padding-left: 0 !important;
                }
                
                /* Horizontal list */
                #complement ul { 
                    margin: 0 !important; 
                    padding: 0 !important; 
                }
                #complement ul li { 
                    display: inline-block !important; 
                    padding-right: 15px !important; 
                    line-height: 1.35 !important; 
                    margin-bottom: 5px !important; 
                }

                #complement ul li span { font-weight: bold !important; color: #14532d !important; word-break: break-all; }
                #complement .row:last-child { margin-top: 6px !important; border-top: 1px dashed #d1d5db; padding-top: 8px; }
            </style>
        </xpath>

        <!-- 2. Table classes -->
        <xpath expr="//table[@name='invoice_line_table']" position="attributes">
            <attribute name="class">table table-sm o_main_table mb-0</attribute>
        </xpath>

        <!-- 3. Alphabetical sorting -->
        <xpath expr="//table[@name='invoice_line_table']/tbody//t[@t-set='lines']" position="after">
            <t t-set="lines" t-value="lines.sorted(key=lambda l: (l.product_id.name or '') if l.display_type == 'product' else '')"/>
        </xpath>

        <!-- 4. Clean headers -->
        <xpath expr="//table[@name='invoice_line_table']/thead/tr" position="replace">
            <tr>
                <th name="th_description" class="text-start"><span>DESCRIPCIÓN</span></th>
                <th name="th_quantity" class="text-end"><span>CANT</span></th>
                <th name="th_uom" class="text-center"><span>UD</span></th>
                <th name="th_priceunit" class="text-end"><span>V. UNITARIO</span></th>
                <th name="th_discount" t-if="display_discount" class="text-end"><span>DESC.%</span></th>
                <th name="th_taxes" class="text-end"><span>IMP.</span></th>
                <th name="th_subtotal" class="text-end"><span>IMPORTE</span></th>
            </tr>
        </xpath>

        <!-- 5. Clean body (product name only, no refs/variants) -->
        <xpath expr="//t[@name='account_invoice_line_accountable']" position="replace">
            <t t-if="line.display_type == 'product'" name="account_invoice_line_accountable">
                <td name="account_invoice_line_name" class="text-start">
                    <span t-if="line.product_id" t-field="line.product_id.name" t-options="{'widget': 'text'}"/>
                    <span t-else="" t-field="line.name" t-options="{'widget': 'text'}"/>
                </td>
                <td name="td_quantity" class="text-end">
                    <span t-field="line.quantity"/>
                </td>
                <td name="td_uom" class="text-center">
                    <span t-field="line.product_uom_id.name" groups="uom.group_uom"/>
                </td>
                <td name="td_price_unit" class="text-end">
                    <span class="text-nowrap" t-field="line.price_unit"/>
                </td>
                <td name="td_discount" t-if="display_discount" class="text-end">
                    <span class="text-nowrap" t-field="line.discount"/>
                </td>
                <td name="td_taxes" class="text-end">
                    <t t-set="taxes" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_ids])"/>
                    <span t-out="taxes" id="line_tax_ids"/>
                </td>
                <td name="td_subtotal" class="text-end o_price_total">
                    <span class="text-nowrap" t-field="line.price_subtotal"/>
                </td>
            </t>
        </xpath>
        
        <!-- 6. Hide native info block -->
        <xpath expr="//div[@id='informations']" position="attributes">
             <attribute name="class" add="d-none" separator=" "/>
        </xpath>
        
        <!-- Hide native address row -->
        <xpath expr="//div[hasclass('row')][1]" position="attributes">
             <attribute name="class" add="d-none" separator=" "/>
        </xpath>
        
        <!-- 7. B2B ECOSYSTEM: Receiver data (left) + Invoice block (right) -->
        <xpath expr="//div[hasclass('row')][1]" position="after">
            
            <div class="row pt-4 pb-3 mb-4" style="border-bottom: 2px solid #14532d; background-color: #fbfbfc;">
                
                <!-- LEFT (col-7): BILLING + DELIVERY DATA -->
                <div class="col-7">
                    <div class="row h-100">
                        
                        <!-- COLUMN A: BILLING DATA -->
                        <div class="col-6" style="border-right: 1px dashed #d1d5db; padding-right: 15px;">
                            <table class="table table-sm table-borderless mb-0 res_partner_address_table" style="font-size: 12px; line-height: 1.2;">
                                <tbody>
                                    <tr>
                                        <td colspan="2" class="fw-bold" style="color: #14532d; border-bottom: 1px solid #14532d !important; padding-bottom: 4px; margin-bottom: 6px; font-size: 13px;">DATOS DE FACTURACIÓN</td>
                                    </tr>
                                    <tr>
                                        <td class="p-0 fw-bold" style="width: 30%; color: #495057;">CLIENTE:</td>
                                        <td class="p-0"><span t-field="o.partner_id.name" class="fw-bold"/></td>
                                    </tr>
                                    <tr t-if="o.partner_id.vat">
                                        <td class="p-0 fw-bold" style="color: #495057;">NIT / RUT:</td>
                                        <td class="p-0"><span t-field="o.partner_id.vat"/></td>
                                    </tr>
                                    <tr>
                                        <td class="p-0 fw-bold" style="color: #495057;">DIRECCIÓN:</td>
                                        <td class="p-0">
                                            <span t-if="o.partner_id.street" t-field="o.partner_id.street"/>
                                            <span t-if="o.partner_id.street2"> <span t-field="o.partner_id.street2"/></span>
                                            <span t-if="o.partner_id.city">, <span t-field="o.partner_id.city"/></span>
                                            <span t-if="o.partner_id.state_id">, <span t-field="o.partner_id.state_id.name"/></span>
                                        </td>
                                    </tr>
                                    <tr t-if="o.partner_id.phone or o.partner_id.mobile">
                                        <td class="p-0 fw-bold" style="color: #495057;">TELÉFONO:</td>
                                        <td class="p-0">
                                            <span t-if="o.partner_id.phone" t-field="o.partner_id.phone"/>
                                            <span t-if="o.partner_id.phone and o.partner_id.mobile"> / </span>
                                            <span t-if="o.partner_id.mobile" t-field="o.partner_id.mobile"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- COLUMN B: DELIVERY / COMMERCIAL DATA -->
                        <div class="col-6" style="padding-left: 15px;">
                            <table class="table table-sm table-borderless mb-0 res_partner_address_table" style="font-size: 12px; line-height: 1.2;">
                                <tbody>
                                    <tr>
                                        <td colspan="2" class="fw-bold" style="color: #14532d; border-bottom: 1px solid #14532d !important; padding-bottom: 4px; margin-bottom: 6px; font-size: 13px;">DATOS DE ENTREGA / COMERCIALES</td>
                                    </tr>
                                    <tr t-if="o.partner_shipping_id and (o.partner_shipping_id != o.partner_id)">
                                        <td class="p-0 fw-bold" style="width: 38%; color: #495057;">DESTINO:</td>
                                        <td class="p-0"><span t-field="o.partner_shipping_id.name" class="fw-bold"/></td>
                                    </tr>
                                    <tr t-if="o.partner_shipping_id and (o.partner_shipping_id != o.partner_id)">
                                        <td class="p-0 fw-bold" style="color: #495057;">DIR. ENVÍO:</td>
                                        <td class="p-0">
                                            <span t-if="o.partner_shipping_id.street" t-field="o.partner_shipping_id.street"/>
                                            <span t-if="o.partner_shipping_id.city">, <span t-field="o.partner_shipping_id.city"/></span>
                                        </td>
                                    </tr>
                                    <!-- Rescued fields -->
                                    <tr t-if="'delivery_date' in o and o.delivery_date">
                                        <td class="p-0 fw-bold" style="color: #495057;">F. ENTREGA:</td>
                                        <td class="p-0"><span t-field="o.delivery_date"/></td>
                                    </tr>
                                    <tr t-if="o.invoice_payment_term_id">
                                        <td class="p-0 fw-bold" style="color: #495057;">TÉRMINOS:</td>
                                        <td class="p-0"><span t-field="o.invoice_payment_term_id.name"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- RIGHT (col-5): INVOICE MASTER BLOCK -->
                <div class="col-5">
                    <table class="table table-sm table-borderless mb-0 h-100 shadow-sm" style="font-size: 13px; text-align: center; border: 2px solid #14532d; background-color: white;">
                        <thead style="background-color: #14532d !important; color: white !important;">
                            <tr>
                                <th class="p-2 fw-bold text-center align-middle" colspan="2" style="color: white !important; font-size: 14px;">
                                    <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">FACTURA DE VENTA</span>
                                    <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">BORRADOR DE FACTURA</span>
                                    <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">FACTURA CANCELADA</span>
                                    <span t-if="o.move_type == 'out_refund'">NOTA DE CRÉDITO</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="p-1 fw-bold align-middle" style="background-color: #f8f9fa; width: 45%; border-right: 1px solid #e0e0e0; border-bottom: 1px solid #e0e0e0;">NÚMERO</td>
                                <td class="p-1 fw-bold align-middle" style="color: #14532d; font-size: 15px; border-bottom: 1px solid #e0e0e0;"><span t-if="o.name != '/'" t-field="o.name"/></td>
                            </tr>
                            <tr>
                                        <td class="p-1 fw-bold align-middle" style="background-color: #f8f9fa; border-right: 1px solid #e0e0e0; border-bottom: 1px solid #e0e0e0;">GENERACIÓN</td>
                                        <td class="p-1 align-middle" style="border-bottom: 1px solid #e0e0e0;"><span t-field="o.invoice_date"/></td>
                                    </tr>
                                    <tr>
                                        <td class="p-1 fw-bold align-middle" style="background-color: #f8f9fa; border-right: 1px solid #e0e0e0; border-bottom: 1px solid #e0e0e0;">VENCIMIENTO</td>
                                        <td class="p-1 align-middle" style="border-bottom: 1px solid #e0e0e0;"><span t-field="o.invoice_date_due"/></td>
                                    </tr>
                                    <tr t-if="'invoice_origin' in o and o.invoice_origin">
                                        <td class="p-1 fw-bold align-middle" style="background-color: #f8f9fa; border-right: 1px solid #e0e0e0; border-bottom: 1px solid #e0e0e0;">ORDEN / REF</td>
                                        <td class="p-1 align-middle" style="border-bottom: 1px solid #e0e0e0;"><span t-field="o.invoice_origin"/></td>
                                    </tr>
                                    <tr t-elif="o.ref">
                                        <td class="p-1 fw-bold align-middle" style="background-color: #f8f9fa; border-right: 1px solid #e0e0e0; border-bottom: 1px solid #e0e0e0;">ORDEN / REF</td>
                                        <td class="p-1 align-middle" style="border-bottom: 1px solid #e0e0e0;"><span t-field="o.ref"/></td>
                                    </tr>
                                    <!-- DIAN Payment Methods (safe check) -->
                                    <t t-if="'l10n_co_edi_payment_option_id' in o and o.l10n_co_edi_payment_option_id">
                                        <tr>
                                            <td class="p-1 fw-bold align-middle" style="background-color: #f8f9fa; border-right: 1px solid #e0e0e0; border-bottom: 1px solid #e0e0e0;">MÉTODO PAGO</td>
                                            <td class="p-1 align-middle" style="border-bottom: 1px solid #e0e0e0; line-height: 1.1;"><span t-field="o.l10n_co_edi_payment_option_id.name"/></td>
                                        </tr>
                                        <tr t-if="o.l10n_co_edi_payment_option_id.code in ('1', '2')">
                                            <td class="p-1 fw-bold align-middle" style="background-color: #f8f9fa; border-right: 1px solid #e0e0e0;">TIPO PAGO</td>
                                            <td class="p-1 align-middle">
                                                <span t-if="o.l10n_co_edi_is_direct_payment">Contado</span>
                                                <span t-else="">Crédito</span>
                                            </td>
                                        </tr>
                                    </t>
                        </tbody>
                    </table>
                </div>

            </div>
        </xpath>

    </template>
    </data>
</odoo>
