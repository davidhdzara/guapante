<?xml version="1.0" encoding="utf-8"?>
<!--
    Bancos colombianos con codigos ACH Colombia.
    Fuente: ACH Colombia / Superfinanciera de Colombia.
    El campo l10n_co_ach_code es propio de este modulo.
    Se usa noupdate="1" para no sobrescribir datos que el usuario haya
    modificado manualmente en producccion.
-->
