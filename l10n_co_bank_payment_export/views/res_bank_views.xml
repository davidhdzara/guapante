<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Campo ACH en ficha del banco -->
    <record id="view_res_bank_form_inherit_ach" model="ir.ui.view">
        <field name="name">res.bank.form.l10n_co_ach</field>
        <field name="model">res.bank</field>
        <field name="inherit_id" ref="base.view_res_bank_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bic']" position="after">
                <field name="l10n_co_ach_code" placeholder="Ej: 051"/>
            </xpath>
        </field>
    </record>

    <!-- Campo tipo de cuenta en ficha de cuenta bancaria del partner -->
    <record id="view_res_partner_bank_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.bank.form.l10n_co_account_type</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='acc_number']" position="after">
                <field name="l10n_co_account_type" string="Tipo de Cuenta (Colombia)"/>
            </xpath>
        </field>
    </record>

    <!-- Cuenta dispersora en la configuracion de la empresa -->
    <record id="view_res_company_form_inherit_l10n_co" model="ir.ui.view">
        <field name="name">res.company.form.l10n_co_dispersal</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="l10n_co_payments" string="Pagos Colombia">
                    <group string="Cuenta Dispersora (Pagos Masivos)">
                        <field name="l10n_co_dispersal_account"
                               placeholder="Ej: 03000123456"/>
                        <field name="l10n_co_dispersal_account_type"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
