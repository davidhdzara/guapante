<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- Formulario de auditoria                                             -->
    <!-- ================================================================== -->
    <record id="view_bank_payment_export_form" model="ir.ui.view">
        <field name="name">bank.payment.export.form</field>
        <field name="model">bank.payment.export</field>
        <field name="arch" type="xml">
            <form string="Exportacion Bancaria" create="false">
                <header>
                    <button name="action_generate_file"
                            string="Regenerar Archivo"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="Se generara un nuevo archivo. Continuar?"/>
                    <button name="action_reset_to_draft"
                            string="Restablecer a Borrador"
                            type="object"
                            invisible="state != 'generated'"
                            confirm="El archivo actual se eliminara. Esta accion permite regenerarlo. Continuar?"/>
                    <button name="action_cancel"
                            string="Cancelar"
                            type="object"
                            invisible="state != 'draft'"
                            confirm="Cancelar esta exportacion. Continuar?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,generated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Informacion General">
                            <field name="bank" readonly="1"/>
                            <field name="payment_source" readonly="1"/>
                            <field name="date" readonly="1"/>
                            <field name="company_id" readonly="1"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group string="Resultado">
                            <field name="line_count" readonly="1"/>
                            <field name="warning_count" readonly="1"
                                   invisible="warning_count == 0"/>
                            <field name="excel_file"
                                   widget="binary"
                                   filename="excel_filename"
                                   string="Descargar Archivo"
                                   readonly="1"
                                   invisible="not excel_file"/>
                            <field name="excel_filename" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pagos a Proveedores"
                              invisible="payment_source not in ('vendor', 'both')">
                            <field name="payment_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="partner_id"/>
                                    <field name="partner_bank_id" string="Cuenta Bancaria"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Nomina"
                              invisible="payment_source not in ('payroll', 'both')">
                            <field name="payslip_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="employee_id"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="net_wage" sum="Total Neto"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Lista de auditoria                                                  -->
    <!-- ================================================================== -->
    <record id="view_bank_payment_export_list" model="ir.ui.view">
        <field name="name">bank.payment.export.list</field>
        <field name="model">bank.payment.export</field>
        <field name="arch" type="xml">
            <list string="Exportaciones Bancarias" create="false"
                  decoration-success="state == 'generated'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="bank"/>
                <field name="payment_source"/>
                <field name="line_count" string="Registros"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'generated'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="excel_file" widget="binary"
                       filename="excel_filename"
                       string="Descargar"
                       optional="show"/>
            </list>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Busqueda                                                            -->
    <!-- ================================================================== -->
    <record id="view_bank_payment_export_search" model="ir.ui.view">
        <field name="name">bank.payment.export.search</field>
        <field name="model">bank.payment.export</field>
        <field name="arch" type="xml">
            <search string="Buscar Exportaciones">
                <field name="name"/>
                <filter string="Generados" name="generated"
                        domain="[('state','=','generated')]"/>
                <filter string="Este mes" name="this_month"
                        domain="[('date','&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group expand="0" string="Agrupar por">
                    <filter string="Banco"  name="group_bank"   context="{'group_by': 'bank'}"/>
                    <filter string="Origen" name="group_source" context="{'group_by': 'payment_source'}"/>
                    <filter string="Mes"    name="group_month"  context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Accion                                                              -->
    <!-- ================================================================== -->
    <record id="action_bank_payment_export" model="ir.actions.act_window">
        <field name="name">Exportaciones Bancarias</field>
        <field name="res_model">bank.payment.export</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bank_payment_export_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sin exportaciones registradas
            </p>
            <p>
                Para generar un archivo plano, vaya a
                <b>Contabilidad &gt; Proveedores &gt; Pagos</b>,
                seleccione los pagos publicados y use
                <b>Accion &gt; Exportar Archivo Plano Bancario</b>.
            </p>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Menu                                                                -->
    <!-- ================================================================== -->
    <menuitem id="menu_bank_payment_export_root"
              name="Archivos Planos Bancarios"
              parent="account.menu_finance"
              sequence="100"/>

    <menuitem id="menu_bank_payment_export_history"
              name="Historial de Exportaciones"
              parent="menu_bank_payment_export_root"
              action="action_bank_payment_export"
              sequence="10"/>

</odoo>
