<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bank_payment_export_wizard_form" model="ir.ui.view">
        <field name="name">bank.payment.export.wizard.form</field>
        <field name="model">bank.payment.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Exportar Archivo Plano Bancario">

                <!-- ── Configuracion ── -->
                <group invisible="export_id">
                    <group string="Configuracion">
                        <field name="bank"/>
                        <field name="payment_source"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group string="Resumen">
                        <field name="payment_count" readonly="1"
                               string="Pagos seleccionados"
                               invisible="payment_source not in ('vendor', 'both')"/>
                        <field name="payslip_count" readonly="1"
                               string="Nominas seleccionadas"
                               invisible="payment_source not in ('payroll', 'both')"/>
                        <field name="total_amount" readonly="1" string="Total a Transferir"/>
                        <field name="ready_count" readonly="1"
                               widget="badge"
                               decoration-success="ready_count > 0"
                               string="Listos para exportar"/>
                        <field name="error_count" readonly="1"
                               widget="badge"
                               decoration-danger="error_count > 0"
                               decoration-muted="error_count == 0"
                               string="Con errores"/>
                    </group>
                </group>

                <!-- ── Reporte de validacion ── -->
                <group string="Reporte de Validacion" invisible="export_id">
                    <field name="validation_html" nolabel="1" readonly="1"/>
                </group>

                <!-- ── Detalle pagos proveedores ── -->
                <group string="Pagos a Proveedores"
                       invisible="payment_source not in ('vendor', 'both') or export_id">
                    <field name="payment_ids" nolabel="1"
                           domain="[('payment_type','=','outbound'),('state','=','posted')]">
                        <list>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="partner_id"/>
                            <field name="partner_bank_id" string="Cuenta Bancaria"/>
                            <field name="amount" sum="Total"/>
                            <field name="currency_id" optional="hide"/>
                        </list>
                    </field>
                </group>

                <!-- ── Detalle nomina ── -->
                <group string="Recibos de Nomina"
                       invisible="payment_source not in ('payroll', 'both') or export_id">
                    <field name="payslip_ids" nolabel="1"
                           domain="[('state','in',['done','paid'])]">
                        <list>
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="net_wage" sum="Total Neto"/>
                        </list>
                    </field>
                </group>

                <!-- ── Archivo generado ── -->
                <group string="Archivo Generado" invisible="not export_id">
                    <field name="excel_file"
                           widget="binary"
                           filename="excel_filename"
                           string="Descargar Archivo"
                           readonly="1"/>
                    <field name="excel_filename" invisible="1"/>
                    <field name="export_id" readonly="1"/>
                </group>

                <footer>
                    <button name="action_generate"
                            string="Generar Archivo"
                            type="object"
                            class="btn-primary"
                            invisible="export_id or ready_count == 0"
                            data-hotkey="g"/>
                    <button name="action_view_export"
                            string="Ver Registro de Auditoria"
                            type="object"
                            class="btn-secondary"
                            invisible="not export_id"/>
                    <button string="Cerrar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Accion desde lista de pagos -->
    <record id="action_export_wizard_from_payments" model="ir.actions.act_window">
        <field name="name">Exportar Archivo Plano Bancario</field>
        <field name="res_model">bank.payment.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_view_types">list</field>
    </record>

    <!-- Accion desde lista de nomina -->
    <record id="action_export_wizard_from_payslips" model="ir.actions.act_window">
        <field name="name">Exportar Archivo Plano Bancario</field>
        <field name="res_model">bank.payment.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
