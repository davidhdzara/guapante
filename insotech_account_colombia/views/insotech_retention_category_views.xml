<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_insotech_retention_category_form" model="ir.ui.view">
            <field name="name">insotech.retention.category.form</field>
            <field name="model">insotech.retention.category</field>
            <field name="arch" type="xml">
                <form string="Categoría de Retención">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only" string="Nombre de la Categoría"/>
                            <h1>
                                <field name="name" placeholder="Ej. Municipales"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="parent_id" placeholder="Categoría Padre..."/>
                                <field name="complete_name" invisible="1"/>
                            </group>
                            <group>
                                <field name="concept_count"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_insotech_retention_category_tree" model="ir.ui.view">
            <field name="name">insotech.retention.category.tree</field>
            <field name="model">insotech.retention.category</field>
            <field name="arch" type="xml">
                <list string="Categorías de Retención">
                    <field name="complete_name" string="Categoría"/>
                    <field name="concept_count" string="Nº Conceptos"/>
                </list>
            </field>
        </record>

        <!-- Action -->
        <record id="action_insotech_retention_category" model="ir.actions.act_window">
            <field name="name">Categorías de Retención</field>
            <field name="res_model">insotech.retention.category</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Crea tu primera categoría de retención
              </p><p>
                Usa las categorías para agrupar los conceptos de retención y facilitar su búsqueda (Ej. Nacionales, Municipales, Parafiscales).
              </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_insotech_retention_category" 
                  name="Categorías de Retención" 
                  parent="menu_insotech_retention_config_root" 
                  action="action_insotech_retention_category" 
                  sequence="15"/>
    </data>
</odoo>
