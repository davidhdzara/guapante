<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Botón "Calcular Retenciones DIAN" en facturas de proveedor -->
    <record id="view_move_form_inherit_insotech_retention" model="ir.ui.view">
        <field name="name">account.move.form.insotech.retention</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Botón en el header, solo facturas proveedor en borrador -->
            <xpath expr="//header" position="inside">
                <button name="action_calculate_retentions"
                        type="object"
                        string="Calcular Retenciones DIAN"
                        class="btn-secondary"
                        icon="fa-calculator"
                        invisible="move_type not in ('in_invoice', 'in_refund') or state != 'draft'"/>
            </xpath>
            <!-- Badge visual cuando ya se calcularon -->
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <div class="alert alert-success text-center"
                     role="alert"
                     invisible="not insotech_retention_calculated or move_type not in ('in_invoice', 'in_refund')">
                    <strong>
                        <i class="fa fa-check-circle"/> Retenciones DIAN calculadas
                    </strong>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
