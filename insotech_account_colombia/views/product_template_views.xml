<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Campo "Parafiscal" en la ficha del producto -->
    <record id="view_product_template_form_inherit_insotech" model="ir.ui.view">
        <field name="name">product.template.form.insotech.retention</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='purchase']" position="inside">
                <group string="Retenciones InSoTech" name="insotech_product_retention">
                    <field name="insotech_parafiscal_concept_id"
                           options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
