<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_register_form_inherit_insotech" model="ir.ui.view">
        <field name="name">account.payment.register.form.inherit.insotech</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="after">
                <field name="insotech_total_retentions" invisible="1"/>
                <group string="Ajustes y Retenciones (InSoTech)" invisible="not can_edit_wizard">
                    <field name="insotech_retention_line_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="retention_concept_id" options="{'no_create': True}"/>
                            <field name="amount" sum="Total"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                    <div colspan="2" class="text-muted fst-italic mb-2">
                        <i class="fa fa-info-circle"/> Ingrese los ajustes o retenciones reales aplicadas por el cliente. El sistema creará el asiento automático de ajuste cruzando con la factura.
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
