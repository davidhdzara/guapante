<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_insotech_retention_concept_tree" model="ir.ui.view">
        <field name="name">insotech.retention.concept.tree</field>
        <field name="model">insotech.retention.concept</field>
        <field name="arch" type="xml">
            <list string="Conceptos de Retención">
                <field name="category_id"/>
                <field name="name"/>
                <field name="type"/>
                <field name="direction"/>
                <field name="base_uvt"/>
                <field name="percentage"/>
                <field name="account_id"/>
                <field name="purchase_tax_id" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_insotech_retention_concept_form" model="ir.ui.view">
        <field name="name">insotech.retention.concept.form</field>
        <field name="model">insotech.retention.concept</field>
        <field name="arch" type="xml">
            <form string="Concepto de Retención">
                <sheet>
                    <widget name="web_ribbon"
                            title="Archivado"
                            bg_color="bg-danger"
                            invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name"
                                   placeholder="Ej. Retención Compras Agrícolas"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Clasificación">
                            <field name="category_id"/>
                            <field name="type"/>
                            <field name="direction"/>
                            <field name="city_name"
                                   invisible="type != 'reteica'"/>
                        </group>
                        <group string="Integración Exógena DIAN">
                            <field name="dian_format"/>
                            <field name="dian_concept_code"/>
                        </group>
                        <group string="Cálculo Legal">
                            <field name="base_uvt"/>
                            <field name="percentage" widget="percentage"/>
                        </group>
                    </group>
                    <group string="Contabilidad">
                        <group>
                            <field name="account_id"/>
                            <field name="tax_id"/>
                        </group>
                        <group>
                            <field name="purchase_tax_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_insotech_retention_concept_search" model="ir.ui.view">
        <field name="name">insotech.retention.concept.search</field>
        <field name="model">insotech.retention.concept</field>
        <field name="arch" type="xml">
            <search string="Buscar Conceptos de Retención">
                <field name="name" string="Nombre del Concepto"/>
                <field name="account_id" string="Cuenta PUC"/>
                <field name="purchase_tax_id" string="Impuesto de Compra"/>
                <separator/>
                <filter string="Ventas" name="sales" domain="[('direction', 'in', ('sale', 'both'))]"/>
                <filter string="Compras" name="purchases" domain="[('direction', 'in', ('purchase', 'both'))]"/>
                <separator/>
                <filter string="ReteFuente" name="type_retefuente" domain="[('type', '=', 'retefuente')]"/>
                <filter string="ReteICA" name="type_reteica" domain="[('type', '=', 'reteica')]"/>
                <filter string="ReteIVA" name="type_reteiva" domain="[('type', '=', 'reteiva')]"/>
                <filter string="Parafiscales" name="type_parafiscal" domain="[('type', '=', 'parafiscal')]"/>
                <separator/>
                <filter string="Archivado" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Categoría" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Tipo de Retención" name="groupby_type" context="{'group_by': 'type'}"/>
                    <filter string="Ámbito" name="groupby_direction" context="{'group_by': 'direction'}"/>
                    <filter string="Cuenta PUC" name="groupby_account" context="{'group_by': 'account_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_insotech_retention_concept" model="ir.actions.act_window">
        <field name="name">Conceptos de Retención</field>
        <field name="res_model">insotech.retention.concept</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_insotech_retention_concept_search"/>
        <field name="context">{'search_default_group_category': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer Concepto de Retención
            </p>
            <p>
                Define las bases en UVT y la cuenta PUC exacta.
                El sistema usará esto para automatizar los descuentos.
            </p>
        </field>
    </record>
</odoo>
